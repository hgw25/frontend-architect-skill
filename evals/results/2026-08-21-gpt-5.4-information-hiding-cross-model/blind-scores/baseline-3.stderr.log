-import type { Plugin } from 'vite'
+import { watch, type FSWatcher } from 'node:fs'
+import { readFile } from 'node:fs/promises'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import type { Plugin, ResolvedConfig, ViteDevServer } from 'vite'
+
+export type FeatureFlagPrimitive = boolean | number | string
+export type FeatureFlagRecord = Record<string, FeatureFlagPrimitive>
+
+export interface FeatureFlagsOptions {
+  source: string | URL
+  expose: readonly string[]
+}
+
+export type InferFeatureFlags<
+  Source extends Record<string, unknown>,
+  Exposed extends readonly (keyof Source)[],
+> = Readonly<{
+  [Key in Exposed[number]]: Source[Key] extends FeatureFlagPrimitive ? Source[Key] : never
+}>
+
+interface CachedVirtualModule {
+  code: string
+  map: {
+    version: 3
+    file: string
+    sources: string[]
+    sourcesContent: string[]
+    names: string[]
+    mappings: string
+  }
+  raw: string
+}
+
+const VIRTUAL_MODULE_ID = 'virtual:feature-flags'
+const RESOLVED_VIRTUAL_MODULE_ID = '\0virtual:feature-flags'
+const SUSPICIOUS_SECRET_KEY = /(secret|token|password|private|credential|api[-_]?key)/i
+
+export function defineFeatureFlags<const Exposed extends readonly string[]>(
+  options: FeatureFlagsOptions & { expose: Exposed },
+): FeatureFlagsOptions & { expose: Exposed } {
+  return options
+}
+
+export function featureFlags(options: FeatureFlagsOptions): Plugin {
+  const normalizedExpose = normalizeExpose(options.expose)
+  let config: ResolvedConfig | undefined
+  let server: ViteDevServer | undefined
+  let sourcePath = ''
+  let cachedModule: CachedVirtualModule | undefined
+  let fallbackWatcher: FSWatcher | undefined
+
+  const resolveSourcePath = (): string => {
+    if (!config) {
+      throw new Error('[feature-flags] Vite config is not resolved yet.')
+    }
+
+    const source = options.source
+    if (source instanceof URL) {
+      return path.resolve(fileURLToPath(source))
+    }
+
+    return path.resolve(config.root, source)
+  }
+
+  const invalidateVirtualModule = (timestamp = Date.now()): void => {
+    cachedModule = undefined
+    if (!server) {
+      return
+    }
+
+    const virtualModule = server.moduleGraph.getModuleById(RESOLVED_VIRTUAL_MODULE_ID)
+    if (!virtualModule) {
+      return
+    }
+
+    const graph = server.moduleGraph as {
+      invalidateModule: (
+        module: unknown,
+        seen?: Set<unknown>,
+        timestamp?: number,
+        isHmr?: boolean,
+      ) => void
+    }
+    graph.invalidateModule(virtualModule, new Set(), timestamp, true)
+  }
+
+  const loadVirtualModule = async (): Promise<CachedVirtualModule> => {
+    const currentSourcePath = sourcePath || resolveSourcePath()
+    const raw = await readFile(currentSourcePath, 'utf8')
+
+    if (cachedModule?.raw === raw) {
+      return cachedModule
+    }
+
+    const flags = parseFeatureFlags({
+      raw,
+      sourcePath: currentSourcePath,
+      expose: normalizedExpose,
+    })
+
+    const code = [
+      `export const flags = Object.freeze(${JSON.stringify(flags, null, 2)})`,
+      'export default flags',
+    ].join('\n')
+
+    cachedModule = {
+      code,
+      raw,
+      map: {
+        version: 3,
+        file: VIRTUAL_MODULE_ID,
+        sources: [currentSourcePath],
+        sourcesContent: [raw],
+        names: [],
+        mappings: '',
+      },
+    }
+
+    return cachedModule
+  }
 
-export function featureFlags(flags: Record<string, unknown>): Plugin {
   return {
     name: 'feature-flags',
-    transform(code: string) {
-      return code.replaceAll('__FLAGS__', JSON.stringify(flags))
+
+    configResolved(resolvedConfig) {
+      config = resolvedConfig
+      sourcePath = resolveSourcePath()
+    },
+
+    buildStart() {
+      if (sourcePath) {
+        this.addWatchFile(sourcePath)
+      }
+    },
+
+    configureServer(configuredServer) {
+      server = configuredServer
+      if (sourcePath) {
+        server.watcher.add(sourcePath)
+        fallbackWatcher = watch(sourcePath, { persistent: false }, () => {
+          invalidateVirtualModule()
+          server?.watcher.emit('change', sourcePath)
+        })
+      }
+    },
+
+    resolveId(id) {
+      if (id === VIRTUAL_MODULE_ID) {
+        return RESOLVED_VIRTUAL_MODULE_ID
+      }
+
+      return null
+    },
+
+    async load(id) {
+      if (id !== RESOLVED_VIRTUAL_MODULE_ID) {
+        return null
+      }
+
+      const virtualModule = await loadVirtualModule()
+      return {
+        code: virtualModule.code,
+        map: virtualModule.map,
+      }
+    },
+
+    handleHotUpdate(context) {
+      if (path.resolve(context.file) !== sourcePath) {
+        return
+      }
+
+      invalidateVirtualModule(context.timestamp)
+      const virtualModule = context.server.moduleGraph.getModuleById(RESOLVED_VIRTUAL_MODULE_ID)
+      return virtualModule ? [virtualModule] : []
+    },
+
+    closeBundle() {
+      fallbackWatcher?.close()
+      fallbackWatcher = undefined
     },
   }
 }
+
+function normalizeExpose(expose: readonly string[]): string[] {
+  if (expose.length === 0) {
+    throw new Error(
+      '[feature-flags] `expose` must contain at least one public flag. Add the keys that are safe to ship to the browser.',
+    )
+  }
+
+  const deduped = new Set<string>()
+
+  for (const name of expose) {
+    if (!name.trim()) {
+      throw new Error('[feature-flags] `expose` cannot contain empty flag names.')
+    }
+
+    if (deduped.has(name)) {
+      throw new Error(
+        `[feature-flags] Duplicate public flag "${name}" in \`expose\`. Remove the duplicate entry so dev/build stay deterministic.`,
+      )
+    }
+
+    deduped.add(name)
+  }
+
+  return [...deduped]
+}
+
+function parseFeatureFlags({
+  raw,
+  sourcePath,
+  expose,
+}: {
+  raw: string
+  sourcePath: string
+  expose: readonly string[]
+}): FeatureFlagRecord {
+  let parsed: unknown
+
+  try {
+    parsed = JSON.parse(raw)
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error)
+    throw new Error(
+      `[feature-flags] Failed to parse ${sourcePath} as JSON.\nFix the file syntax and restart the failed request.\nOriginal error: ${message}`,
+    )
+  }
+
+  if (!isPlainRecord(parsed)) {
+    throw new Error(
+      `[feature-flags] ${sourcePath} must export a JSON object at the top level.\nReceived ${describeValue(parsed)} instead.`,
+    )
+  }
+
+  const resolved: FeatureFlagRecord = {}
+
+  for (const name of expose) {
+    if (!(name in parsed)) {
+      throw new Error(
+        `[feature-flags] Public flag "${name}" is missing from ${sourcePath}.\nAdd "${name}" to the JSON file or remove it from \`expose\`.`,
+      )
+    }
+
+    if (SUSPICIOUS_SECRET_KEY.test(name)) {
+      throw new Error(
+        `[feature-flags] Refusing to expose "${name}" from ${sourcePath} because the key looks like a secret.\nRename it or keep it server-only instead of shipping it through virtual:feature-flags.`,
+      )
+    }
+
+    const value = parsed[name]
+    if (!isFeatureFlagPrimitive(value)) {
+      throw new Error(
+        `[feature-flags] Public flag "${name}" in ${sourcePath} must be a string, number, or boolean.\nReceived ${describeValue(value)}.`,
+      )
+    }
+
+    resolved[name] = value
+  }
+
+  return resolved
+}
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function isFeatureFlagPrimitive(value: unknown): value is FeatureFlagPrimitive {
+  return typeof value === 'boolean' || typeof value === 'number' || typeof value === 'string'
+}
+
+function describeValue(value: unknown): string {
+  if (Array.isArray(value)) {
+    return 'an array'
+  }
+
+  if (value === null) {
+    return 'null'
+  }
+
+  return typeof value
+}
