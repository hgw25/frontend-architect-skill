--- a/packages/plugin/src/index.ts
+++ b/packages/plugin/src/index.ts
@@ -1,10 +1,326 @@
-import type { Plugin } from 'vite'
+import { unwatchFile, watchFile } from 'node:fs'
+import { readFile, stat } from 'node:fs/promises'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import type { ModuleNode, Plugin, ResolvedConfig, ViteDevServer } from 'vite'
+
+export type FeatureFlagValue = boolean | number | string
+export type FeatureFlagRecord = Record<string, FeatureFlagValue>
+
+export interface FeatureFlagsShape {}
+
+export type FeatureFlagsOf<
+  TAllFlags extends FeatureFlagRecord,
+  TExpose extends readonly (keyof TAllFlags)[],
+> = Readonly<Pick<TAllFlags, TExpose[number]>>
+
+export interface FeatureFlagsOptions<TExpose extends string = string> {
+  source: string | URL
+  expose: readonly TExpose[]
+  moduleId?: string
+}
+
+interface PluginState {
+  config: ResolvedConfig | null
+  server: ViteDevServer | null
+  sourcePath: string | null
+  publicModuleId: string
+  resolvedModuleId: string
+  cachedSnapshot: FlagsSnapshot | null
+  stopWatchingSource: (() => void) | null
+}
+
+interface FlagsSnapshot {
+  mtimeMs: number
+  sourceText: string
+  publicFlags: FeatureFlagRecord
+}
+
+const DEFAULT_MODULE_ID = 'virtual:feature-flags'
+const RESOLVED_ID_PREFIX = '\0feature-flags:'
+
+export function featureFlags<TExpose extends string>(
+  options: FeatureFlagsOptions<TExpose>,
+): Plugin {
+  const state: PluginState = {
+    config: null,
+    server: null,
+    sourcePath: null,
+    publicModuleId: options.moduleId ?? DEFAULT_MODULE_ID,
+    resolvedModuleId: `${RESOLVED_ID_PREFIX}${options.moduleId ?? DEFAULT_MODULE_ID}`,
+    cachedSnapshot: null,
+    stopWatchingSource: null,
+  }
 
-export function featureFlags(flags: Record<string, unknown>): Plugin {
   return {
     name: 'feature-flags',
-    transform(code: string) {
-      return code.replaceAll('__FLAGS__', JSON.stringify(flags))
+    enforce: 'pre',
+    configResolved(config) {
+      state.config = config
+      state.sourcePath = resolveSourcePath(options.source, config.root)
+    },
+    configureServer(server) {
+      state.server = server
+      if (state.sourcePath) {
+        server.watcher.add(state.sourcePath)
+        attachSourceWatcher(state)
+      }
+    },
+    async buildStart() {
+      const sourcePath = getSourcePath(state)
+      this.addWatchFile(sourcePath)
+      await readSnapshot(state, options)
+    },
+    resolveId(id) {
+      if (id === state.publicModuleId) {
+        return state.resolvedModuleId
+      }
+      return null
+    },
+    async load(id) {
+      if (id !== state.resolvedModuleId) {
+        return null
+      }
+
+      const snapshot = await readSnapshot(state, options)
+      return {
+        code: createModuleCode(snapshot.publicFlags),
+        map: createModuleMap(state.publicModuleId, getSourcePath(state), snapshot.sourceText),
+      }
+    },
+    watchChange(id) {
+      if (state.sourcePath && sameFilePath(id, state.sourcePath)) {
+        state.cachedSnapshot = null
+      }
+    },
+    handleHotUpdate(ctx) {
+      if (!state.sourcePath || !sameFilePath(ctx.file, state.sourcePath)) {
+        return
+      }
+
+      state.cachedSnapshot = null
+      return invalidateVirtualModules(state)
+    },
+    buildEnd() {
+      state.stopWatchingSource?.()
+      state.stopWatchingSource = null
     },
   }
 }
+
+function getSourcePath(state: PluginState): string {
+  if (!state.sourcePath) {
+    throw createDiagnostic(
+      'The plugin was used before Vite resolved the source path.',
+      'Pass the plugin through Vite config instead of calling its hooks directly.',
+    )
+  }
+  return state.sourcePath
+}
+
+function resolveSourcePath(source: string | URL, root: string): string {
+  if (source instanceof URL) {
+    if (source.protocol !== 'file:') {
+      throw createDiagnostic(
+        `Unsupported source URL protocol "${source.protocol}".`,
+        'Use a file URL such as new URL("./flags.json", import.meta.url).',
+      )
+    }
+    return path.resolve(fileURLToPath(source))
+  }
+
+  if (path.isAbsolute(source)) {
+    return path.resolve(source)
+  }
+
+  return path.resolve(root, source)
+}
+
+async function readSnapshot<TExpose extends string>(
+  state: PluginState,
+  options: FeatureFlagsOptions<TExpose>,
+): Promise<FlagsSnapshot> {
+  const sourcePath = getSourcePath(state)
+  validateExposeList(options.expose, sourcePath)
+
+  const metadata = await stat(sourcePath).catch((error: unknown) => {
+    throw createDiagnostic(
+      `Cannot read feature flag source at ${sourcePath}.`,
+      'Ensure the file exists and the Vite process has read access.',
+      error,
+    )
+  })
+
+  if (state.cachedSnapshot && state.cachedSnapshot.mtimeMs === metadata.mtimeMs) {
+    return state.cachedSnapshot
+  }
+
+  const sourceText = await readFile(sourcePath, 'utf8').catch((error: unknown) => {
+    throw createDiagnostic(
+      `Cannot load feature flag source at ${sourcePath}.`,
+      'Ensure the file exists and contains UTF-8 encoded JSON.',
+      error,
+    )
+  })
+
+  const parsed = parseFlagsFile(sourceText, sourcePath)
+  const publicFlags = pickExposedFlags(parsed, options.expose, sourcePath)
+  const snapshot: FlagsSnapshot = {
+    mtimeMs: metadata.mtimeMs,
+    sourceText,
+    publicFlags,
+  }
+
+  state.cachedSnapshot = snapshot
+  return snapshot
+}
+
+function parseFlagsFile(sourceText: string, sourcePath: string): FeatureFlagRecord {
+  const parsed = JSON.parse(sourceText) as unknown
+
+  if (!isPlainRecord(parsed)) {
+    throw createDiagnostic(
+      `Expected ${sourcePath} to contain a top-level JSON object.`,
+      'Store feature flags as a flat object whose values are boolean, number, or string.',
+    )
+  }
+
+  return parsed
+}
+
+function pickExposedFlags<TExpose extends string>(
+  allFlags: FeatureFlagRecord,
+  expose: readonly TExpose[],
+  sourcePath: string,
+): FeatureFlagRecord {
+  const publicFlags: FeatureFlagRecord = {}
+
+  for (const key of expose) {
+    if (!Object.prototype.hasOwnProperty.call(allFlags, key)) {
+      throw createDiagnostic(
+        `Cannot expose "${key}" because it is missing from ${sourcePath}.`,
+        'Update the "expose" list or add the flag to the source JSON file.',
+      )
+    }
+
+    const value = allFlags[key]
+    if (!isFeatureFlagValue(value)) {
+      throw createDiagnostic(
+        `Flag "${key}" in ${sourcePath} is not serializable as a public feature flag.`,
+        'Only boolean, number, and string values can cross into the client bundle.',
+      )
+    }
+
+    publicFlags[key] = value
+  }
+
+  return publicFlags
+}
+
+function validateExposeList(expose: readonly string[], sourcePath: string): void {
+  const seen = new Set<string>()
+  for (const key of expose) {
+    if (seen.has(key)) {
+      throw createDiagnostic(
+        `The "expose" list contains "${key}" more than once for ${sourcePath}.`,
+        'Remove duplicate keys so cache invalidation and diagnostics stay deterministic.',
+      )
+    }
+    seen.add(key)
+  }
+}
+
+function createModuleCode(flags: FeatureFlagRecord): string {
+  const serialized = JSON.stringify(flags, null, 2)
+  return [
+    `const flags = Object.freeze(${serialized})`,
+    'export { flags }',
+    'export default flags',
+  ].join('\n')
+}
+
+function createModuleMap(moduleId: string, sourcePath: string, sourceText: string) {
+  return {
+    version: 3 as const,
+    file: moduleId,
+    sources: [normalizeForSourceMap(sourcePath)],
+    sourcesContent: [sourceText],
+    names: [],
+    mappings: '',
+  }
+}
+
+function normalizeForSourceMap(filePath: string): string {
+  return filePath.split(path.sep).join('/')
+}
+
+function invalidateVirtualModules(state: PluginState): ModuleNode[] {
+  const server = state.server
+  if (!server) {
+    return []
+  }
+
+  const modules = [
+    server.moduleGraph.getModuleById(state.publicModuleId),
+    server.moduleGraph.getModuleById(state.resolvedModuleId),
+  ].filter((module): module is ModuleNode => module != null)
+
+  for (const module of modules) {
+    server.moduleGraph.invalidateModule(module)
+  }
+
+  return modules
+}
+
+function attachSourceWatcher(state: PluginState): void {
+  const sourcePath = getSourcePath(state)
+  state.stopWatchingSource?.()
+
+  const onSourceChange = () => {
+    state.cachedSnapshot = null
+    invalidateVirtualModules(state)
+    state.server?.watcher.emit('change', sourcePath)
+  }
+
+  watchFile(sourcePath, { interval: 100 }, (current, previous) => {
+    if (current.mtimeMs === previous.mtimeMs) {
+      return
+    }
+    onSourceChange()
+  })
+
+  const closeServer = state.server?.close.bind(state.server)
+  if (closeServer) {
+    state.server!.close = async () => {
+      state.stopWatchingSource?.()
+      state.stopWatchingSource = null
+      await closeServer()
+    }
+  }
+
+  state.stopWatchingSource = () => {
+    unwatchFile(sourcePath)
+  }
+}
+
+function sameFilePath(left: string, right: string): boolean {
+  return path.resolve(left) === path.resolve(right)
+}
+
+function isPlainRecord(value: unknown): value is FeatureFlagRecord {
+  return typeof value === 'object' && value != null && !Array.isArray(value)
+}
+
+function isFeatureFlagValue(value: unknown): value is FeatureFlagValue {
+  return (
+    typeof value === 'boolean' ||
+    typeof value === 'number' ||
+    typeof value === 'string'
+  )
+}
+
+function createDiagnostic(message: string, remediation: string, cause?: unknown): Error {
+  const details = cause instanceof Error && cause.message ? ` Cause: ${cause.message}` : ''
+  return new Error(`[feature-flags] ${message} ${remediation}${details}`)
+}
