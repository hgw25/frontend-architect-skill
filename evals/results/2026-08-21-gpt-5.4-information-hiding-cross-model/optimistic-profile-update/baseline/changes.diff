+import { cleanup, render, screen } from '@testing-library/react'
 import userEvent from '@testing-library/user-event'
 import { afterEach, expect, test, vi } from 'vitest'
 
 import { ProfileForm } from './ProfileForm'
 
 afterEach(() => {
+  cleanup()
   vi.unstubAllGlobals()
 })
 
@@ -66,3 +67,66 @@ test('restores the authoritative name when a successful response has an invalid
   )
   expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Ada')
 })
+
+test('ignores stale save responses when a newer submission finishes first', async () => {
+  let resolveFirstRequest: ((response: Response) => void) | undefined
+  let resolveSecondRequest: ((response: Response) => void) | undefined
+  const fetchMock = vi
+    .fn<() => Promise<Response>>()
+    .mockImplementationOnce(
+      () =>
+        new Promise<Response>((resolve) => {
+          resolveFirstRequest = resolve
+        }),
+    )
+    .mockImplementationOnce(
+      () =>
+        new Promise<Response>((resolve) => {
+          resolveSecondRequest = resolve
+        }),
+    )
+  vi.stubGlobal('fetch', fetchMock)
+
+  const user = userEvent.setup()
+  render(
+    <ProfileForm profile={{ id: 'p1', displayName: 'Ada', version: 1 }} />,
+  )
+
+  await user.clear(screen.getByLabelText('Display name'))
+  await user.type(screen.getByLabelText('Display name'), 'Grace')
+  await user.click(screen.getByRole('button', { name: 'Save' }))
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent(
+    'Grace',
+  )
+
+  await user.clear(screen.getByLabelText('Display name'))
+  await user.type(screen.getByLabelText('Display name'), 'Marie')
+  await user.click(screen.getByRole('button', { name: 'Save' }))
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent(
+    'Marie',
+  )
+
+  resolveSecondRequest?.(
+    new Response(
+      JSON.stringify({ id: 'p1', displayName: 'Marie', version: 2 }),
+      { status: 200, headers: { 'content-type': 'application/json' } },
+    ),
+  )
+
+  expect(await screen.findByLabelText('Current profile name')).toHaveTextContent(
+    'Marie',
+  )
+
+  resolveFirstRequest?.(
+    new Response(
+      JSON.stringify({ id: 'p1', displayName: 'Grace', version: 3 }),
+      { status: 200, headers: { 'content-type': 'application/json' } },
+    ),
+  )
+
+  await vi.waitFor(() => {
+    expect(screen.getByLabelText('Current profile name')).toHaveTextContent(
+      'Marie',
+    )
+  })
+})
