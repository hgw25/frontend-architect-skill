 and transport rejections propagate', async () => {\n  const failure = Error('offline');\n  await assert.rejects(processForm([{ name: 'x', validate: async () => { throw failure; } }], { x: 1 }, () => assert.fail('sent')), error => error === failure);\n  await assert.rejects(processForm([{ name: 'x' }], { x: 1 }, async () => { throw failure; }), error => error === failure);\n});\ntest('prototype-like names remain own error and payload keys', async () => {\n  const fields = [{ name: '__proto__', required: true }];\n  const result = await processForm(fields, {}, () => assert.fail('sent'));\n  assert.equal(Object.hasOwn(result.errors, '__proto__'), true); assert.equal(result.errors.__proto__, 'Required');\n  const payload = await processForm(fields, { ['__proto__']: 'value' }, payload => payload);\n  assert.equal(Object.hasOwn(payload, '__proto__'), true); assert.equal(payload.__proto__, 'value');\n});\n"}, {"command": "/bin/zsh -lc 'npm run check'", "exit_code": 0, "kind": "executed check", "output_tail": "\n> check\n> node --test\n\nTAP version 13\n# Subtest: disabled validation never runs or blocks, and payload excludes disabled/unknown fields\nok 1 - disabled validation never runs or blocks, and payload excludes disabled/unknown fields\n  ---\n  duration_ms: 0.460166\n  type: 'test'\n  ...\n# Subtest: zero false whitespace and empty arrays satisfy required\nok 2 - zero false whitespace and empty arrays satisfy required\n  ---\n  duration_ms: 0.085666\n  type: 'test'\n  ...\n# Subtest: all specified empty representations fail and skip custom validation\nok 3 - all specified empty representations fail and skip custom validation\n  ---\n  duration_ms: 0.052625\n  type: 'test'\n  ...\n# Subtest: async validator preserves specific error and blocks send\nok 4 - async validator preserves specific error and blocks send\n  ---\n  duration_ms: 0.102417\n  type: 'test'\n  ...\n# Subtest: send waits for custom validation and returns the send result without mutation\nok 5 - send