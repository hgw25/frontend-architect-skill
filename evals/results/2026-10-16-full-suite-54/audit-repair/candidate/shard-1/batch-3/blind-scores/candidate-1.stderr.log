```tsx
type SortModel = NonNullable<
  React.ComponentProps<typeof ExistingTable>["sortModel"]
>;

const [sortModel, setSortModel] = useState<SortModel>([]);

return (
  <ExistingTable
    {...existingProps}
    sortModel={sortModel}
    onSortModelChange={(nextSortModel) => {
      setSortModel(nextSortModel);
    }}
  />
);
