-import { type FormEvent, useState } from 'react'
+import { type FormEvent, useReducer, useRef } from 'react'
 
 import { type Profile, updateProfile } from './api'
 
+type ProfileFormState = {
+  authoritativeProfile: Profile
+  displayName: string
+  error: { submittedName: string } | null
+  latestRequestId: number
+  latestRequestStatus: 'idle' | 'pending' | 'confirmed' | 'failed'
+  visibleName: string
+}
+
+type ProfileFormAction =
+  | { type: 'edit'; displayName: string }
+  | { type: 'submit'; requestId: number; displayName: string }
+  | { type: 'confirm'; requestId: number; profile: Profile }
+  | { type: 'fail'; requestId: number; submittedName: string }
+
+function reduceProfileForm(
+  state: ProfileFormState,
+  action: ProfileFormAction,
+): ProfileFormState {
+  switch (action.type) {
+    case 'edit':
+      return { ...state, displayName: action.displayName }
+    case 'submit':
+      return {
+        ...state,
+        error: null,
+        latestRequestId: action.requestId,
+        latestRequestStatus: 'pending',
+        visibleName: action.displayName,
+      }
+    case 'confirm': {
+      const isLatestRequest = action.requestId === state.latestRequestId
+      const isNewerVersion =
+        action.profile.version > state.authoritativeProfile.version
+      const acceptsCurrentVersion =
+        isLatestRequest &&
+        action.profile.version === state.authoritativeProfile.version
+      const authoritativeProfile =
+        isNewerVersion || acceptsCurrentVersion
+          ? action.profile
+          : state.authoritativeProfile
+      const shouldShowAuthoritativeProfile =
+        isLatestRequest ||
+        (isNewerVersion && state.latestRequestStatus === 'failed')
+
+      return {
+        ...state,
+        authoritativeProfile,
+        latestRequestStatus: isLatestRequest
+          ? 'confirmed'
+          : state.latestRequestStatus,
+        visibleName: shouldShowAuthoritativeProfile
+          ? authoritativeProfile.displayName
+          : state.visibleName,
+      }
+    }
+    case 'fail':
+      if (action.requestId !== state.latestRequestId) {
+        return state
+      }
+
+      return {
+        ...state,
+        error: { submittedName: action.submittedName },
+        latestRequestStatus: 'failed',
+        visibleName: state.authoritativeProfile.displayName,
+      }
+  }
+}
+
 export function ProfileForm({ profile }: { profile: Profile }) {
-  const [displayName, setDisplayName] = useState(profile.displayName)
-  const [visibleName, setVisibleName] = useState(profile.displayName)
+  const [state, dispatch] = useReducer(reduceProfileForm, {
+    authoritativeProfile: profile,
+    displayName: profile.displayName,
+    error: null,
+    latestRequestId: 0,
+    latestRequestStatus: 'idle',
+    visibleName: profile.displayName,
+  })
+  const nextRequestId = useRef(0)
+
+  function save(submittedName: string) {
+    const requestId = ++nextRequestId.current
+    dispatch({ type: 'submit', requestId, displayName: submittedName })
 
-  async function handleSubmit(event: FormEvent) {
+    void updateProfile(submittedName).then(
+      (updatedProfile) => {
+        dispatch({ type: 'confirm', requestId, profile: updatedProfile })
+      },
+      () => {
+        dispatch({ type: 'fail', requestId, submittedName })
+      },
+    )
+  }
+
+  function handleSubmit(event: FormEvent) {
     event.preventDefault()
-    setVisibleName(displayName)
-    await updateProfile(displayName)
+    save(state.displayName)
   }
 
+  const retryName = state.error?.submittedName
+
   return (
     <form onSubmit={handleSubmit}>
-      <p aria-label="Current profile name">{visibleName}</p>
+      <p aria-label="Current profile name">{state.visibleName}</p>
       <label>
         Display name
         <input
-          value={displayName}
-          onChange={(event) => setDisplayName(event.target.value)}
+          value={state.displayName}
+          onChange={(event) =>
+            dispatch({ type: 'edit', displayName: event.target.value })
+          }
         />
       </label>
       <button>Save</button>
+      {retryName !== undefined ? (
+        <div role="alert">
+          <span>Save failed. Please retry.</span>{' '}
+          <button type="button" onClick={() => save(retryName)}>
+            Retry
+          </button>
+        </div>
+      ) : null}
     </form>
