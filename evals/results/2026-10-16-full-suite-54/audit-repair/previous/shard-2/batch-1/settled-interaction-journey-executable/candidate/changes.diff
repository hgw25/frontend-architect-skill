diff --git a/src/app.mjs b/src/app.mjs
index b26b32f..56f6341 100644
--- a/src/app.mjs
+++ b/src/app.mjs
@@ -2,24 +2,79 @@ const input = document.querySelector('#name');
 const feedback = document.querySelector('#feedback');
 const save = document.querySelector('#save');
 const grid = document.querySelector('#grid');
-document.querySelector('#clear').onclick = () => { input.value = ''; };
+
+let draftRevision = 0;
+
+input.addEventListener('input', () => {
+  draftRevision += 1;
+});
+
+document.querySelector('#clear').addEventListener('click', () => {
+  if (input.value) {
+    input.value = '';
+    draftRevision += 1;
+  }
+  input.focus();
+});
+
 save.onclick = async () => {
+  const submission = {
+    value: input.value,
+    draftRevision,
+  };
+
   save.disabled = true;
   feedback.textContent = 'Saving';
   try {
-    const response = await fetch('/save', { method: 'POST', body: input.value });
+    const response = await fetch('/save', { method: 'POST', body: submission.value });
     if (!response.ok) throw new Error('Save failed');
-    document.querySelector('td').textContent = input.value;
+    document.querySelector('td').textContent = submission.value;
     feedback.textContent = 'Saved';
-  } catch { feedback.textContent = 'Save failed'; }
-  finally { input.value = ''; save.disabled = false; }
+    if (draftRevision === submission.draftRevision) {
+      input.value = '';
+      draftRevision += 1;
+    }
+  } catch {
+    feedback.textContent = 'Save failed';
+  } finally {
+    save.disabled = false;
+  }
 };
+
 const body = document.querySelector('tbody');
 for (let index = 0; index < 30; index++) {
-  const row = body.insertRow(); row.dataset.row = String(index);
+  const row = body.insertRow();
+  row.dataset.row = String(index);
   row.insertCell().textContent = 'Record ' + index;
 }
-if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
-  for (const row of [...body.rows].slice(0, 8)) row.animate({ opacity: [0, 1] }, { duration: 240 });
+
+function animateVisibleRows() {
+  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !Element.prototype.animate) return;
+
+  const gridBounds = grid.getBoundingClientRect();
+  const visibleTop = Math.max(gridBounds.top, 0);
+  const visibleBottom = Math.min(gridBounds.bottom, window.innerHeight);
+  const visibleRows = [...body.rows].filter((row) => {
+    const bounds = row.getBoundingClientRect();
+    return bounds.bottom > visibleTop && bounds.top < visibleBottom;
+  });
+
+  for (const row of visibleRows) {
+    row.animate(
+      [
+        { opacity: 0, transform: 'translateY(6px)' },
+        { opacity: 1, transform: 'translateY(0)' },
+      ],
+      { duration: 180, easing: 'ease-out' },
+    );
+  }
 }
-setTimeout(() => { grid.dataset.ready = 'true'; }, Number(new URLSearchParams(location.search).get('delay') || 200));
+
+const requestedDelay = new URLSearchParams(location.search).get('delay');
+const parsedDelay = requestedDelay === null ? 200 : Number(requestedDelay);
+const readyDelay = Number.isFinite(parsedDelay) ? Math.max(0, parsedDelay) : 200;
+
+setTimeout(() => {
+  grid.dataset.ready = 'true';
+  requestAnimationFrame(() => requestAnimationFrame(animateVisibleRows));
+}, readyDelay);
