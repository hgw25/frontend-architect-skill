+      // file-scoped watch as the owner of that extra input and forward it into
+      // Vite's normal HMR pipeline. Duplicate host events are harmless:
+      // Vite coalesces invalidation around the same module graph entry.
+      const onSourceChange = (): void => {
+        server.watcher.emit('change', path)
+      }
+      watchFile(path, { persistent: false, interval: 100 }, onSourceChange)
+      stopDevSourceWatcher = () => unwatchFile(path, onSourceChange)
+    },
+
+    resolveId(id) {
+      if (id === PUBLIC_ID) return RESOLVED_ID
+      return null
+    },
+
+    async load(id) {
+      if (id !== RESOLVED_ID) return null
+
+      this.addWatchFile(requireSourcePath())
+      return (await loadSnapshot()).code
+    },
+
+    watchChange(id) {
+      if (samePath(id, requireSourcePath())) invalidateSnapshot()
+    },
+
+    handleHotUpdate(context) {
+      if (!samePath(context.file, requireSourcePath())) return
+
+      invalidateSnapshot()
+      const virtualModule = context.server.moduleGraph.getModuleById(RESOLVED_ID)
+      if (virtualModule === undefined) return []
+
+      context.server.moduleGraph.invalidateModule(virtualModule)
+      return [virtualModule]
+    },
+
+    closeBundle() {
+      stopDevSourceWatcher?.()
+      stopDevSourceWatcher = undefined
     },
   }
 }
+
+function validateOptions(options: FeatureFlagsOptions): ValidatedOptions {
+  if (options === null || typeof options !== 'object') {
+    throw new FeatureFlagsError(
+      'INVALID_OPTIONS',
+      'Expected featureFlags({ source, expose }). Pass a JSON file and an explicit public-key allowlist.',
+    )
+  }
+
+  const { source, expose } = options
+  if (typeof source !== 'string' && !(source instanceof URL)) {
+    throw new FeatureFlagsError(
+      'INVALID_SOURCE',
+      'Option "source" must be a file URL or path string, for example new URL("./flags.json", import.meta.url).',
+    )
+  }
+  if (typeof source === 'string' && source.trim() === '') {
+    throw new FeatureFlagsError('INVALID_SOURCE', 'Option "source" must not be empty.')
+  }
+  if (source instanceof URL && source.protocol !== 'file:') {
+    throw new FeatureFlagsError(
+      'INVALID_SOURCE',
+      `Option "source" only supports file: URLs; received ${source.protocol}`,
+    )
+  }
+
+  if (!Array.isArray(expose)) {
+    throw new FeatureFlagsError(
+      'INVALID_EXPOSE',
+      'Option "expose" must be an array of public flag names. Server-only keys must be omitted.',
+    )
+  }
+
+  const publicKeys = new Set<string>()
+  for (const key of expose) {
+    if (typeof key !== 'string' || key.length === 0) {
+      throw new FeatureFlagsError(
+        'INVALID_EXPOSE',
+        'Every entry in option "expose" must be a non-empty string.',
+      )
+    }
+    if (publicKeys.has(key)) {
+      throw new FeatureFlagsError(
+        'INVALID_EXPOSE',
+        `Option "expose" contains duplicate key ${JSON.stringify(key)}. Remove the duplicate entry.`,
+      )
+    }
+    publicKeys.add(key)
+  }
+
+  return { source, expose: Object.freeze([...expose]) }
+}
+
+function resolveSource(source: string | URL, config: ResolvedConfig): string {
+  if (source instanceof URL) return fileURLToPath(source)
+  return isAbsolute(source) ? source : resolve(config.root, source)
+}
+
+async function readSnapshot(
+  sourcePath: string,
+  exposedKeys: readonly string[],
+): Promise<FlagSnapshot> {
+  let contents: string
+  try {
+    contents = await readFile(sourcePath, 'utf8')
+  } catch {
+    throw new FeatureFlagsError(
+      'READ_FAILED',
+      `Could not read ${sourcePath}. Check that the file exists and is readable.`,
+    )
+  }
+
+  let document: unknown
+  try {
+    document = JSON.parse(contents)
+  } catch {
+    // JSON parser messages can contain source excerpts, so do not surface the
+    // original message: the same document may contain server-only values.
+    throw new FeatureFlagsError(
+      'INVALID_JSON',
+      `Could not parse ${sourcePath} as JSON. Validate the file with a JSON formatter.`,
+    )
+  }
+
+  if (!isRecord(document)) {
+    throw new FeatureFlagsError(
+      'INVALID_DOCUMENT',
+      `Expected ${sourcePath} to contain a JSON object keyed by flag name.`,
+    )
+  }
+
+  const publicFlags: Record<string, FeatureFlagValue> = Object.create(null)
+  for (const key of exposedKeys) {
+    if (!Object.hasOwn(document, key)) {
+      throw new FeatureFlagsError(
+        'MISSING_FLAG',
+        `Public flag ${JSON.stringify(key)} is missing from ${sourcePath}. Add it to the file or remove it from option "expose".`,
+      )
+    }
+
+    const value = document[key]
+    if (!isFeatureFlagValue(value)) {
+      throw new FeatureFlagsError(
+        'INVALID_FLAG_VALUE',
+        `Public flag ${JSON.stringify(key)} in ${sourcePath} must be a string, number, or boolean; received ${describeType(value)}.`,
+      )
+    }
+    publicFlags[key] = value
+  }
+
+  const serializedFlags = JSON.stringify(publicFlags)
+  return {
+    code: [
+      `const data = JSON.parse(${JSON.stringify(serializedFlags)});`,
+      'export const flags = Object.freeze(data);',
+      '',
+    ].join('\n'),
+  }
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function isFeatureFlagValue(value: unknown): value is FeatureFlagValue {
+  return (
+    typeof value === 'boolean' ||
+    typeof value === 'string' ||
+    (typeof value === 'number' && Number.isFinite(value))
+  )
+}
+
+function describeType(value: unknown): string {
+  if (value === null) return 'null'
+  if (Array.isArray(value)) return 'array'
+  return typeof value
+}
+
+function samePath(left: string, right: string): boolean {
+  return normalizePath(resolve(left)) === normalizePath(resolve(right))
+}
