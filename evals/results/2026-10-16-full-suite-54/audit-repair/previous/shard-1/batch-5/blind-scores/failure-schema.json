{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audits"
  ],
  "properties": {
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "triggered",
          "routing_review"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "routing_review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "verdict",
              "reason"
            ],
            "properties": {
              "verdict": {
                "type": "string",
                "enum": [
                  "not_required",
                  "justified",
                  "unjustified",
                  "insufficient_evidence"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "triggered": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rule",
                "reason"
              ],
              "properties": {
                "rule": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}