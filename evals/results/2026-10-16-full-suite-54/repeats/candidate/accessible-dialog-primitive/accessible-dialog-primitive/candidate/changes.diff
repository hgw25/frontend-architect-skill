+    const handlePointerDown: PointerEventHandler<HTMLDivElement> = composeEventHandlers(
+      onPointerDown,
+      (event) => {
+        if (event.button === 0 && event.target === event.currentTarget) {
+          setOpen(false, { nativeEvent: event.nativeEvent, reason: 'outside-pointer' })
+        }
+      },
+    )
+
+    if (!open) return null
+
+    return (
+      <div
+        {...props}
+        ref={forwardedRef}
+        data-dialog-overlay=""
+        data-state="open"
+        onPointerDown={handlePointerDown}
+      />
+    )
+  },
+)
+
+export type DialogContentProps = Omit<HTMLAttributes<HTMLDivElement>, 'role'> & {
+  initialFocusRef?: RefObject<HTMLElement | null>
+  onEscapeKeyDown?: (event: KeyboardEvent) => void
+  restoreFocus?: boolean
+}
+
+export const DialogContent = forwardRef<HTMLDivElement, DialogContentProps>(
+  function DialogContent(allProps, forwardedRef) {
+    const hasAriaDescribedBy = Object.hasOwn(allProps, 'aria-describedby')
+    const hasAriaLabelledBy = Object.hasOwn(allProps, 'aria-labelledby')
+    const {
+      'aria-label': ariaLabel,
+      'aria-describedby': ariaDescribedBy,
+      'aria-labelledby': ariaLabelledBy,
+      initialFocusRef,
+      onEscapeKeyDown,
+      restoreFocus = true,
+      tabIndex = -1,
+      ...props
+    } = allProps
+    const { contentId, descriptionId, open, setOpen, titleId, triggerRef } =
+      useDialogContext('Dialog.Content')
+    const [content, setContent] = useState<HTMLDivElement | null>(null)
+    const setOpenRef = useRef(setOpen)
+    const onEscapeKeyDownRef = useRef(onEscapeKeyDown)
+    setOpenRef.current = setOpen
+    onEscapeKeyDownRef.current = onEscapeKeyDown
+
+    const composedRef = useCallback(
+      (element: HTMLDivElement | null) => {
+        setContent(element)
+        setRef(forwardedRef, element)
+      },
+      [forwardedRef],
+    )
+
+    useIsomorphicLayoutEffect(() => {
+      if (!open || !content) return
+      const activeElement = content.ownerDocument.activeElement
+      const HTMLElementConstructor = content.ownerDocument.defaultView?.HTMLElement
+
+      return registerDialogLayer({
+        content,
+        fallbackReturnFocus: () => triggerRef.current,
+        initialFocus: initialFocusRef?.current ?? null,
+        onEscapeKeyDown: (event) => {
+          onEscapeKeyDownRef.current?.(event)
+          if (!event.defaultPrevented) {
+            event.preventDefault()
+            setOpenRef.current(false, { nativeEvent: event, reason: 'escape-key' })
+          }
+        },
+        restoreFocus,
+        returnFocus:
+          HTMLElementConstructor && activeElement instanceof HTMLElementConstructor
+            ? activeElement
+            : triggerRef.current,
+      })
+    }, [content, initialFocusRef, open, restoreFocus, triggerRef])
+
+    if (!open) return null
+
+    return (
+      <div
+        {...props}
+        ref={composedRef}
+        id={contentId}
+        role="dialog"
+        aria-label={ariaLabel}
+        aria-describedby={hasAriaDescribedBy ? ariaDescribedBy : descriptionId}
+        aria-labelledby={hasAriaLabelledBy || ariaLabel ? ariaLabelledBy : titleId}
+        aria-modal="true"
+        data-dialog-content=""
+        data-state="open"
+        tabIndex={tabIndex}
+      />
+    )
+  },
+)
+
+export type DialogTitleProps = HTMLAttributes<HTMLHeadingElement>
+
+export const DialogTitle = forwardRef<HTMLHeadingElement, DialogTitleProps>(
+  function DialogTitle(props, forwardedRef) {
+    const { titleId } = useDialogContext('Dialog.Title')
+    return <h2 {...props} ref={forwardedRef} id={titleId} data-dialog-title="" />
+  },
+)
+
+export type DialogDescriptionProps = HTMLAttributes<HTMLParagraphElement>
+
+export const DialogDescription = forwardRef<HTMLParagraphElement, DialogDescriptionProps>(
+  function DialogDescription(props, forwardedRef) {
+    const { descriptionId } = useDialogContext('Dialog.Description')
+    return <p {...props} ref={forwardedRef} id={descriptionId} data-dialog-description="" />
+  },
+)
+
+export type DialogCloseProps = ButtonHTMLAttributes<HTMLButtonElement>
+
+export const DialogClose = forwardRef<HTMLButtonElement, DialogCloseProps>(
+  function DialogClose({ onClick, type = 'button', ...props }, forwardedRef) {
+    const { setOpen } = useDialogContext('Dialog.Close')
+    const handleClick: MouseEventHandler<HTMLButtonElement> = composeEventHandlers(
+      onClick,
+      (event) => setOpen(false, { nativeEvent: event.nativeEvent, reason: 'close-button' }),
+    )
+
+    return <button {...props} ref={forwardedRef} type={type} onClick={handleClick} />
+  },
+)
+
+export const Dialog = {
+  Close: DialogClose,
+  Content: DialogContent,
+  Description: DialogDescription,
+  Overlay: DialogOverlay,
+  Portal: DialogPortal,
+  Root: DialogRoot,
+  Title: DialogTitle,
+  Trigger: DialogTrigger,
 }
diff --git a/src/dialogManager.ts b/src/dialogManager.ts
new file mode 100644
index 0000000..1259896
--- /dev/null
+++ b/src/dialogManager.ts
@@ -0,0 +1,241 @@
+type DialogLayer = {
+  content: HTMLElement
+  fallbackReturnFocus: () => HTMLElement | null
+  initialFocus: HTMLElement | null
+  onEscapeKeyDown: (event: KeyboardEvent) => void
+  restoreFocus: boolean
+  returnFocus: HTMLElement | null
+}
+
+type HiddenElementState = {
+  ariaHidden: string | null
+  inert: boolean
+}
+
+const focusableSelector = [
+  'a[href]',
+  'area[href]',
+  'button:not([disabled])',
+  'input:not([disabled]):not([type="hidden"])',
+  'select:not([disabled])',
+  'textarea:not([disabled])',
+  'iframe',
+  'object',
+  'embed',
+  '[contenteditable]:not([contenteditable="false"])',
+  '[tabindex]:not([tabindex="-1"])',
+].join(',')
+
+function isTabbable(element: HTMLElement) {
+  const view = element.ownerDocument.defaultView
+  const style = view?.getComputedStyle(element)
+
+  return (
+    !element.hidden &&
+    !element.matches(':disabled') &&
+    !element.closest('[inert]') &&
+    element.getAttribute('aria-hidden') !== 'true' &&
+    style?.display !== 'none' &&
+    style?.visibility !== 'hidden' &&
+    element.getClientRects().length > 0
+  )
+}
+
+function getTabbableElements(content: HTMLElement) {
+  return Array.from(content.querySelectorAll<HTMLElement>(focusableSelector)).filter(isTabbable)
+}
+
+function focusElement(element: HTMLElement) {
+  element.focus({ preventScroll: true })
+}
+
+function focusInitialElement(layer: DialogLayer) {
+  const requestedTarget = layer.initialFocus
+  if (requestedTarget && layer.content.contains(requestedTarget) && isTabbable(requestedTarget)) {
+    focusElement(requestedTarget)
+    return
+  }
+
+  const autofocusTarget = layer.content.querySelector<HTMLElement>('[autofocus]')
+  if (autofocusTarget && isTabbable(autofocusTarget)) {
+    focusElement(autofocusTarget)
+    return
+  }
+
+  const firstTarget = getTabbableElements(layer.content)[0]
+  focusElement(firstTarget ?? layer.content)
+}
+
+class DialogManager {
+  private layers: DialogLayer[] = []
+  private hiddenElements = new Map<HTMLElement, HiddenElementState>()
+  private mutationObserver: MutationObserver | null = null
+  private originalBodyOverflow: string | null = null
+
+  constructor(private readonly document: Document) {}
+
+  add(layer: DialogLayer) {
+    if (this.layers.length === 0) {
+      this.document.addEventListener('keydown', this.handleKeyDown, true)
+      this.document.addEventListener('focusin', this.handleFocusIn, true)
+      this.originalBodyOverflow = this.document.body.style.overflow
+      this.document.body.style.overflow = 'hidden'
+      const MutationObserverConstructor = this.document.defaultView?.MutationObserver
+      if (MutationObserverConstructor) {
+        this.mutationObserver = new MutationObserverConstructor(() => this.updateOutsideElements())
+        this.mutationObserver.observe(this.document.body, { childList: true, subtree: true })
+      }
+    }
+
+    this.layers.push(layer)
+    this.updateOutsideElements()
+    focusInitialElement(layer)
+
+    return () => this.remove(layer)
+  }
+
+  private remove(layer: DialogLayer) {
+    const layerIndex = this.layers.indexOf(layer)
+    if (layerIndex === -1) return
+
+    const wasTopLayer = layerIndex === this.layers.length - 1
+    this.layers.splice(layerIndex, 1)
+    this.updateOutsideElements()
+
+    if (this.layers.length === 0) {
+      this.document.removeEventListener('keydown', this.handleKeyDown, true)
+      this.document.removeEventListener('focusin', this.handleFocusIn, true)
+      this.mutationObserver?.disconnect()
+      this.mutationObserver = null
+      this.document.body.style.overflow = this.originalBodyOverflow ?? ''
+      this.originalBodyOverflow = null
+    }
+
+    const returnFocus = layer.returnFocus?.isConnected
+      ? layer.returnFocus
+      : layer.fallbackReturnFocus()
+    if (
+      wasTopLayer &&
+      layer.restoreFocus &&
+      returnFocus?.isConnected &&
+      !returnFocus.closest('[inert]')
+    ) {
+      focusElement(returnFocus)
+    }
+  }
+
+  private readonly handleKeyDown = (event: KeyboardEvent) => {
+    const layer = this.layers.at(-1)
+    if (!layer) return
+
+    if (event.key === 'Escape') {
+      layer.onEscapeKeyDown(event)
+      return
+    }
+
+    if (event.key !== 'Tab') return
+
+    const tabbableElements = getTabbableElements(layer.content)
+    const activeElement = this.document.activeElement
+    const firstElement = tabbableElements[0]
+    const lastElement = tabbableElements.at(-1)
+
+    if (!firstElement || !lastElement) {
+      event.preventDefault()
+      focusElement(layer.content)
+      return
+    }
+
+    if (!activeElement || !layer.content.contains(activeElement)) {
+      event.preventDefault()
+      focusElement(event.shiftKey ? lastElement : firstElement)
+      return
+    }
+
+    if (event.shiftKey && (activeElement === firstElement || activeElement === layer.content)) {
+      event.preventDefault()
+      focusElement(lastElement)
+    } else if (!event.shiftKey && activeElement === lastElement) {
+      event.preventDefault()
+      focusElement(firstElement)
+    }
+  }
+
+  private readonly handleFocusIn = (event: FocusEvent) => {
+    const layer = this.layers.at(-1)
+    const NodeConstructor = layer?.content.ownerDocument.defaultView?.Node
+    if (
+      !layer ||
+      (NodeConstructor && event.target instanceof NodeConstructor && layer.content.contains(event.target))
+    ) {
+      return
+    }
+
+    focusInitialElement(layer)
+  }
+
+  private restoreOutsideElements() {
+    for (const [element, state] of this.hiddenElements) {
+      element.inert = state.inert
+      if (state.ariaHidden === null) {
+        element.removeAttribute('aria-hidden')
+      } else {
+        element.setAttribute('aria-hidden', state.ariaHidden)
+      }
+    }
+    this.hiddenElements.clear()
+  }
+
+  private updateOutsideElements() {
+    this.restoreOutsideElements()
+
+    let branch: HTMLElement | null = this.layers.at(-1)?.content ?? null
+    while (branch && branch !== this.document.body) {
+      const parent = branch.parentElement
+      if (!parent) break
+      const HTMLElementConstructor = this.document.defaultView?.HTMLElement
+
+      for (const sibling of parent.children) {
+        if (
+          !HTMLElementConstructor ||
+          sibling === branch ||
+          !(sibling instanceof HTMLElementConstructor)
+        ) {
+          continue
+        }
+
+        this.hiddenElements.set(sibling, {
+          ariaHidden: sibling.getAttribute('aria-hidden'),
+          inert: sibling.inert,
+        })
+        sibling.inert = true
+        sibling.setAttribute('aria-hidden', 'true')
+      }
+
+      branch = parent
+    }
+  }
+}
+
+const managers = new WeakMap<Document, DialogManager>()
+
+type RegisterDialogLayerOptions = Omit<DialogLayer, 'fallbackReturnFocus' | 'returnFocus'> & {
+  fallbackReturnFocus?: () => HTMLElement | null
+  returnFocus?: HTMLElement | null
+}
+
+export function registerDialogLayer({
+  fallbackReturnFocus = () => null,
+  returnFocus = null,
+  ...options
+}: RegisterDialogLayerOptions) {
+  const document = options.content.ownerDocument
+  let manager = managers.get(document)
+
+  if (!manager) {
+    manager = new DialogManager(document)
+    managers.set(document, manager)
+  }
+
+  return manager.add({ ...options, fallbackReturnFocus, returnFocus })
+}
