+      })
+
+      const event = new Event('dialog.openAutoFocus', { cancelable: true })
+      latestCallbacks.current.onOpenAutoFocus?.(event)
+      if (!event.defaultPrevented) focusFirst(content, initialFocusRef?.current)
+
+      return () => {
+        registered.current = false
+        unregister()
+      }
+    }, [context.contentRef, context.triggerRef, initialFocusRef])
+
+    return (
+      <div
+        {...props}
+        aria-describedby={ariaDescribedBy ?? (context.hasDescription ? context.descriptionId : undefined)}
+        aria-label={ariaLabel}
+        aria-labelledby={
+          ariaLabelledBy ?? (!ariaLabel && context.hasTitle ? context.titleId : undefined)
+        }
+        aria-modal="true"
+        data-state={context.open ? 'open' : 'closed'}
+        id={context.contentId}
+        ref={(element) => {
+          context.contentRef.current = element
+          assignRef(forwardedRef, element)
+        }}
+        role="dialog"
+        tabIndex={props.tabIndex ?? -1}
+        onFocusCapture={(event) => {
+          props.onFocusCapture?.(event)
+          if (!event.defaultPrevented) lastFocusedInside.current = event.target as HTMLElement
+        }}
+      />
+    )
+  },
+)
+
+export type DialogTitleProps = Omit<HTMLAttributes<HTMLHeadingElement>, 'id'> & { id?: never }
+
+export const DialogTitle = forwardRef<HTMLHeadingElement, DialogTitleProps>(
+  function DialogTitle(props, forwardedRef) {
+    const context = useDialogContext('Dialog.Title')
+    useBrowserLayoutEffect(() => {
+      context.setHasTitle(true)
+      return () => context.setHasTitle(false)
+    }, [context.setHasTitle])
+    return <h2 {...props} id={context.titleId} ref={forwardedRef} />
+  },
+)
+
+export type DialogDescriptionProps = Omit<HTMLAttributes<HTMLParagraphElement>, 'id'> & {
+  id?: never
+}
+
+export const DialogDescription = forwardRef<HTMLParagraphElement, DialogDescriptionProps>(
+  function DialogDescription(props, forwardedRef) {
+    const context = useDialogContext('Dialog.Description')
+    useBrowserLayoutEffect(() => {
+      context.setHasDescription(true)
+      return () => context.setHasDescription(false)
+    }, [context.setHasDescription])
+    return <p {...props} id={context.descriptionId} ref={forwardedRef} />
+  },
+)
+
+export type DialogCloseProps = ButtonHTMLAttributes<HTMLButtonElement>
+
+export const DialogClose = forwardRef<HTMLButtonElement, DialogCloseProps>(
+  function DialogClose({ onClick, type = 'button', ...props }, forwardedRef) {
+    const context = useDialogContext('Dialog.Close')
+    return (
+      <button
+        {...props}
+        ref={forwardedRef}
+        type={type}
+        onClick={(event) => {
+          onClick?.(event)
+          if (!event.defaultPrevented) context.requestOpenChange(false, 'close')
+        }}
+      />
+    )
+  },
+)
+
+export const Dialog = Object.freeze({
+  Close: DialogClose,
+  Content: DialogContent,
+  Description: DialogDescription,
+  Overlay: DialogOverlay,
+  Portal: DialogPortal,
+  Root: DialogRoot,
+  Title: DialogTitle,
+  Trigger: DialogTrigger,
+})
