-import type { Plugin } from 'vite'
+import { unwatchFile, watchFile } from 'node:fs'
+import { readFile } from 'node:fs/promises'
+import { isAbsolute, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import { normalizePath } from 'vite'
+import type { Plugin, ResolvedConfig } from 'vite'
+
+export type FeatureFlagValue = boolean | number | string
+
+/**
+ * Consumer-owned type contract for `virtual:feature-flags`.
+ *
+ * Augment this interface from an application declaration file to expose exact
+ * flag names and value types. Runtime data is still validated independently.
+ */
+export interface FeatureFlagSchema {}
+
+type TypedFeatureFlagSchema = {
+  readonly [Key in keyof FeatureFlagSchema]: FeatureFlagSchema[Key] extends FeatureFlagValue
+    ? FeatureFlagSchema[Key]
+    : never
+}
+
+/** The type exported by the virtual module after consumer augmentation. */
+export type FeatureFlags = keyof FeatureFlagSchema extends never
+  ? Readonly<Record<string, FeatureFlagValue>>
+  : TypedFeatureFlagSchema
+
+export interface FeatureFlagsOptions {
+  /** JSON file containing both public and server-only configuration. */
+  readonly source: string | URL
+  /** Explicit allowlist of keys that may cross into browser code. */
+  readonly expose: readonly string[]
+}
+
+export type FeatureFlagsErrorCode =
+  | 'INVALID_OPTIONS'
+  | 'INVALID_SOURCE'
+  | 'INVALID_EXPOSE'
+  | 'READ_FAILED'
+  | 'INVALID_JSON'
+  | 'INVALID_DOCUMENT'
+  | 'MISSING_FLAG'
+  | 'INVALID_FLAG_VALUE'
+
+/** Stable, non-sensitive configuration error suitable for build diagnostics. */
+export class FeatureFlagsError extends Error {
+  readonly code: FeatureFlagsErrorCode
+
+  constructor(code: FeatureFlagsErrorCode, message: string, options?: ErrorOptions) {
+    super(`[feature-flags:${code}] ${message}`, options)
+    this.name = 'FeatureFlagsError'
+    this.code = code
+  }
+}
+
+const PUBLIC_ID = 'virtual:feature-flags'
+const RESOLVED_ID = `\0${PUBLIC_ID}`
+
+interface ValidatedOptions {
+  readonly source: string | URL
+  readonly expose: readonly string[]
+}
+
+interface FlagSnapshot {
+  readonly code: string
+}
+
+export function featureFlags(options: FeatureFlagsOptions): Plugin {
+  const validatedOptions = validateOptions(options)
+  let sourcePath: string | undefined
+  let cachedSnapshot: Promise<FlagSnapshot> | undefined
+  let sourceRevision = 0
+  let stopDevSourceWatcher: (() => void) | undefined
+
+  const requireSourcePath = (): string => {
+    if (sourcePath === undefined) {
+      throw new FeatureFlagsError(
+        'INVALID_SOURCE',
+        'The source path was requested before Vite resolved the project configuration.',
+      )
+    }
+    return sourcePath
+  }
+
+  const loadSnapshot = (): Promise<FlagSnapshot> => {
+    if (cachedSnapshot !== undefined) return cachedSnapshot
+
+    const requestedRevision = sourceRevision
+    const pendingSnapshot = readSnapshot(requireSourcePath(), validatedOptions.expose).then(
+      (snapshot) =>
+        requestedRevision === sourceRevision ? snapshot : loadSnapshot(),
+      (error: unknown) => {
+        if (requestedRevision !== sourceRevision) return loadSnapshot()
+        if (cachedSnapshot === pendingSnapshot) cachedSnapshot = undefined
+        throw error
+      },
+    )
+    cachedSnapshot = pendingSnapshot
+    return pendingSnapshot
+  }
+
+  const invalidateSnapshot = (): void => {
+    sourceRevision += 1
+    cachedSnapshot = undefined
+  }
 
-export function featureFlags(flags: Record<string, unknown>): Plugin {
   return {
     name: 'feature-flags',
-    transform(code: string) {
-      return code.replaceAll('__FLAGS__', JSON.stringify(flags))
+    enforce: 'pre',
