{
  "name": "@example/headless-dialog",
  "version": "0.1.0",
  "description": "Accessible headless React dialog primitive",
  "type": "module",
  "files": [
    "dist/package"
  ],
  "types": "./dist/package/index.d.ts",
  "module": "./dist/package/index.js",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:app && npm run build:package",
    "build:app": "vite build",
    "build:package": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test:ssr && npm run build && playwright test",
    "test:browser": "npm run build:app && playwright test",
    "test:ssr": "vitest run src/Dialog.ssr.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
