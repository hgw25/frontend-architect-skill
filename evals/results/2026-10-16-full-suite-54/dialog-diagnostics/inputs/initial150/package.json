{
  "name": "@fixture/headless-dialog",
  "version": "1.0.0",
  "description": "Headless, accessible React dialog primitives",
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist/package"
  ],
  "main": "./dist/package/index.js",
  "module": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:app && npm run build:lib",
    "build:app": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc --project tsconfig.build.json",
    "check": "npm run typecheck && npm run test:ssr && npm run test:browser && npm run build && npm run test:package",
    "test:package": "node tests/package.test.mjs",
    "test:browser": "npm run build:app && playwright test",
    "test:ssr": "vitest run src/Dialog.ssr.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
