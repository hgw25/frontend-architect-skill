{
  "name": "@fixture/headless-dialog",
  "version": "0.1.0",
  "description": "A headless, accessible React dialog primitive",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/package",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js"
    }
  },
  "scripts": {
    "build": "vite build && vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test:ssr && npm run test:browser && npm run build && npm run test:package",
    "test:browser": "vite build --config vite.browser-test.config.ts && playwright test",
    "test:package": "npm pack --dry-run --cache ./node_modules/.cache/npm && node scripts/check-package.mjs",
    "test:ssr": "vitest run src/Dialog.ssr.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
