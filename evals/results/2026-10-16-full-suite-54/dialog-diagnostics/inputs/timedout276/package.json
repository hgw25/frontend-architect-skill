{
  "name": "frontend-architect-dialog-browser-eval",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "package-dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./package-dist/index.d.ts",
      "import": "./package-dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "build:package": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test:ssr && npm run test:browser && npm run test:package",
    "prepack": "npm run build:package",
    "test:browser": "npm run build && playwright test",
    "test:package": "npm run build:package && tsc -p tsconfig.package-test.json",
    "test:ssr": "vitest run src/Dialog.ssr.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "devDependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
