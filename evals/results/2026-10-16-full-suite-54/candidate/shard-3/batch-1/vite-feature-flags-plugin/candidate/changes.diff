diff --git a/packages/plugin/test/plugin.test.mjs b/packages/plugin/test/plugin.test.mjs
new file mode 100644
index 0000000..8ae959d
--- /dev/null
+++ b/packages/plugin/test/plugin.test.mjs
@@ -0,0 +1,105 @@
+import assert from 'node:assert/strict'
+import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import test from 'node:test'
+
+import { build, createServer } from 'vite'
+
+import { featureFlags } from '../dist/index.js'
+
+async function createFixture() {
+  const root = await mkdtemp(join(tmpdir(), 'feature-flags-plugin-'))
+  const source = join(root, 'flags.json')
+  await writeFile(
+    source,
+    JSON.stringify({ checkoutV2: true, SERVER_TOKEN: 'do-not-ship' }),
+  )
+  await writeFile(
+    join(root, 'entry.js'),
+    "export { flags } from 'virtual:feature-flags'\n",
+  )
+  return { root, source }
+}
+
+test('uses the same allowlisted module in build and dev updates', async (t) => {
+  const { root, source } = await createFixture()
+  t.after(() => rm(root, { recursive: true, force: true }))
+
+  const buildResult = await build({
+    root,
+    configFile: false,
+    logLevel: 'silent',
+    plugins: [featureFlags({ source, expose: ['checkoutV2'] })],
+    build: {
+      write: false,
+      sourcemap: true,
+      rolldownOptions: { input: join(root, 'entry.js') },
+    },
+  })
+  const outputs = Array.isArray(buildResult) ? buildResult : [buildResult]
+  const clientArtifacts = outputs
+    .flatMap(({ output }) => output)
+    .map((item) =>
+      item.type === 'chunk'
+        ? `${item.code}\n${JSON.stringify(item.map)}`
+        : String(item.source),
+    )
+    .join('\n')
+  assert.match(clientArtifacts, /checkoutV2/)
+  assert.doesNotMatch(clientArtifacts, /do-not-ship/)
+
+  const server = await createServer({
+    root,
+    configFile: false,
+    logLevel: 'silent',
+    server: { middlewareMode: true },
+    plugins: [featureFlags({ source, expose: ['checkoutV2'] })],
+  })
+  t.after(() => server.close())
+
+  const first = await server.ssrLoadModule('/entry.js')
+  assert.deepEqual(first.flags, { checkoutV2: true })
+
+  await writeFile(
+    source,
+    JSON.stringify({ checkoutV2: false, SERVER_TOKEN: 'still-private' }),
+  )
+  server.watcher.emit('change', source)
+
+  const deadline = Date.now() + 2_000
+  let updated
+  do {
+    await new Promise((resolve) => setTimeout(resolve, 25))
+    updated = await server.ssrLoadModule('/entry.js')
+  } while (updated.flags.checkoutV2 !== false && Date.now() < deadline)
+
+  assert.deepEqual(updated.flags, { checkoutV2: false })
+  assert.doesNotMatch(JSON.stringify(updated.flags), /still-private/)
+})
+
+test('reports a missing exposed key with a corrective diagnostic', async (t) => {
+  const { root, source } = await createFixture()
+  t.after(() => rm(root, { recursive: true, force: true }))
+
+  await assert.rejects(
+    build({
+      root,
+      configFile: false,
+      logLevel: 'silent',
+      plugins: [featureFlags({ source, expose: ['missingFlag'] })],
+      build: {
+        write: false,
+        rolldownOptions: { input: join(root, 'entry.js') },
+      },
+    }),
+    (error) => {
+      const message = error instanceof Error ? error.message : String(error)
+      return (
+        message.includes('missingFlag') &&
+        message.includes('flags.json') &&
+        message.includes('remove it from "expose"')
+      )
+    },
+  )
+})
