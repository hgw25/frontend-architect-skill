-import type { Plugin } from 'vite'
+import { readFile } from 'node:fs/promises'
+import { isAbsolute, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import { normalizePath, type Plugin } from 'vite'
+
+const PUBLIC_MODULE_ID = 'virtual:feature-flags'
+const RESOLVED_MODULE_ID = `\0${PUBLIC_MODULE_ID}`
+const ERROR_PREFIX = '[feature-flags]'
+
+export type FeatureFlagValue = boolean | number | string
+
+export interface FeatureFlagsOptions<FlagName extends string = string> {
+  /** JSON file containing all flag values. Relative paths resolve from Vite's root. */
+  readonly source: string | URL
+  /** The only keys that may cross from the source file into browser code. */
+  readonly expose: readonly FlagName[]
+}
+
+interface ValidatedOptions {
+  readonly source: string | URL
+  readonly expose: readonly string[]
+}
+
+export function featureFlags<const FlagName extends string>(
+  options: FeatureFlagsOptions<FlagName>,
+): Plugin {
+  const validatedOptions = validateOptions(options)
+  let sourcePath: string | undefined
+  let cachedModule: Promise<string> | undefined
+
+  const getSourcePath = (): string => {
+    if (sourcePath === undefined) {
+      throw new Error(
+        `${ERROR_PREFIX} Internal lifecycle error: the source path was used before Vite resolved its config.`,
+      )
+    }
+
+    return sourcePath
+  }
+
+  const loadModule = (): Promise<string> => {
+    cachedModule ??= createVirtualModule(
+      getSourcePath(),
+      validatedOptions.expose,
+    ).catch((error: unknown) => {
+      cachedModule = undefined
+      throw error
+    })
+
+    return cachedModule
+  }
+
+  const invalidate = (): void => {
+    cachedModule = undefined
+  }
 
-export function featureFlags(flags: Record<string, unknown>): Plugin {
   return {
     name: 'feature-flags',
-    transform(code: string) {
-      return code.replaceAll('__FLAGS__', JSON.stringify(flags))
+    enforce: 'pre',
+
+    configResolved(config) {
+      sourcePath = resolveSourcePath(validatedOptions.source, config.root)
+    },
+
+    configureServer(server) {
+      server.watcher.add(getSourcePath())
+    },
+
+    async buildStart() {
+      const path = getSourcePath()
+      this.addWatchFile(path)
+      await loadModule()
+    },
+
+    resolveId(id) {
+      if (id === PUBLIC_MODULE_ID) return RESOLVED_MODULE_ID
+    },
+
+    async load(id) {
+      if (id !== RESOLVED_MODULE_ID) return
+
+      return {
+        code: await loadModule(),
+        // Generated code has no authored source to map back to. Consumer modules
+        // remain untouched, so Vite keeps their original source maps intact.
+        map: { mappings: '' },
+      }
+    },
+
+    watchChange(id) {
+      if (isSourceFile(id, getSourcePath())) invalidate()
+    },
+
+    async hotUpdate(options) {
+      if (!isSourceFile(options.file, getSourcePath())) return
+
+      invalidate()
+      await loadModule()
+
+      const virtualModule = this.environment.moduleGraph.getModuleById(
+        RESOLVED_MODULE_ID,
+      )
+      if (virtualModule === undefined) return []
+
+      this.environment.moduleGraph.invalidateModule(
+        virtualModule,
+        undefined,
+        options.timestamp,
+        true,
+      )
+      return [virtualModule]
     },
   }
 }
+
+function validateOptions<FlagName extends string>(
+  options: FeatureFlagsOptions<FlagName>,
+): ValidatedOptions {
+  if (options === null || typeof options !== 'object') {
+    throw configError(
+      'Expected an options object with "source" and "expose" fields.',
+    )
+  }
+
+  const { source, expose } = options
+  if (
+    !(
+      (typeof source === 'string' && source.trim().length > 0) ||
+      source instanceof URL
+    )
+  ) {
+    throw configError(
+      'Invalid "source": expected a non-empty file path or a file: URL.',
+    )
+  }
+
+  if (source instanceof URL && source.protocol !== 'file:') {
+    throw configError(
+      `Invalid "source" protocol "${source.protocol}". Use a file: URL or file path.`,
+    )
+  }
+
+  if (!Array.isArray(expose)) {
+    throw configError(
+      'Invalid "expose": expected an array of flag names that are safe for browser code.',
+    )
+  }
+
+  const names = new Set<string>()
+  for (const [index, name] of expose.entries()) {
+    if (typeof name !== 'string' || name.length === 0) {
+      throw configError(
+        `Invalid "expose[${index}]": expected a non-empty flag name.`,
+      )
+    }
+    if (names.has(name)) {
+      throw configError(
+        `Duplicate flag "${name}" in "expose". Keep each browser flag once.`,
+      )
+    }
+    names.add(name)
+  }
+
+  return {
+    source: source instanceof URL ? new URL(source.href) : source,
+    expose: Object.freeze([...names]),
+  }
+}
+
+function resolveSourcePath(source: string | URL, root: string): string {
+  let path: string
+  try {
+    path =
+      source instanceof URL
+        ? fileURLToPath(source)
+        : isAbsolute(source)
+          ? source
+          : resolve(root, source)
+  } catch {
+    throw configError(
+      'Invalid "source": use a valid file: URL or filesystem path.',
+    )
+  }
+
+  return normalizePath(path)
+}
+
+function isSourceFile(candidate: string, sourcePath: string): boolean {
+  return normalizePath(resolve(candidate)) === sourcePath
+}
+
+async function createVirtualModule(
+  sourcePath: string,
+  exposedNames: readonly string[],
+): Promise<string> {
+  const document = await readSource(sourcePath)
+  const sourceFlags = parseSource(document, sourcePath)
+  const publicFlags: Record<string, FeatureFlagValue> = Object.create(null)
+
+  for (const name of exposedNames) {
+    if (!Object.hasOwn(sourceFlags, name)) {
+      throw configError(
+        `Flag "${name}" is listed in "expose" but is missing from "${sourcePath}". Add it to the JSON file or remove it from "expose".`,
+      )
+    }
+
+    const value = sourceFlags[name]
+    if (!isFeatureFlagValue(value)) {
+      throw configError(
+        `Flag "${name}" in "${sourcePath}" must be a string, number, or boolean; received ${describeValue(value)}.`,
+      )
+    }
+    publicFlags[name] = value
+  }
+
+  // Stringifying twice makes the JSON a JavaScript string literal first. JSON.parse
+  // then recreates keys such as "__proto__" as ordinary own properties.
+  const serializedFlags = JSON.stringify(publicFlags)
+  return [
+    `const data = JSON.parse(${JSON.stringify(serializedFlags)});`,
+    'export const flags = Object.freeze(data);',
+    '',
+  ].join('\n')
+}
+
+async function readSource(sourcePath: string): Promise<string> {
+  try {
+    return await readFile(sourcePath, 'utf8')
+  } catch (error: unknown) {
+    const code = getErrorCode(error)
+    throw configError(
+      `Cannot read feature flag source "${sourcePath}"${code === undefined ? '' : ` (${code})`}. Check that "source" points to a readable JSON file.`,
+    )
+  }
+}
+
+function parseSource(
+  document: string,
+  sourcePath: string,
+): Record<string, unknown> {
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(document.replace(/^\uFEFF/, ''))
+  } catch (error: unknown) {
+    throw configError(
+      `Invalid JSON in feature flag source "${sourcePath}"${getJsonLocation(error)}. Fix the JSON syntax and save the file again.`,
+    )
+  }
+
+  if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    throw configError(
+      `Feature flag source "${sourcePath}" must contain one JSON object at the top level.`,
+    )
+  }
+
+  return parsed as Record<string, unknown>
+}
+
+function isFeatureFlagValue(value: unknown): value is FeatureFlagValue {
+  return (
+    typeof value === 'boolean' ||
+    typeof value === 'string' ||
+    (typeof value === 'number' && Number.isFinite(value))
+  )
+}
+
+function describeValue(value: unknown): string {
+  if (value === null) return 'null'
+  if (Array.isArray(value)) return 'an array'
+  return typeof value
+}
+
+function getErrorCode(error: unknown): string | undefined {
+  if (
+    error !== null &&
+    typeof error === 'object' &&
+    'code' in error &&
+    typeof error.code === 'string'
+  ) {
+    return error.code
+  }
+  return undefined
+}
+
+function getJsonLocation(error: unknown): string {
+  if (!(error instanceof SyntaxError)) return ''
+  const position = /position \d+/.exec(error.message)?.[0]
+  return position === undefined ? '' : ` at ${position}`
+}
+
+function configError(message: string): Error {
+  return new Error(`${ERROR_PREFIX} ${message}`)
+}
