   row.insertCell().textContent = 'Record ' + index;
 }
-if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
-  for (const row of [...body.rows].slice(0, 8)) row.animate({ opacity: [0, 1] }, { duration: 240 });
+
+function animateVisibleRows() {
+  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+
+  const gridRect = grid.getBoundingClientRect();
+  const visibleTop = Math.max(gridRect.top, 0);
+  const visibleBottom = Math.min(gridRect.bottom, window.innerHeight);
+  const visibleRows = [...body.rows].filter((row) => {
+    const rowRect = row.getBoundingClientRect();
+    return rowRect.bottom > visibleTop && rowRect.top < visibleBottom;
+  });
+
+  for (const row of visibleRows) {
+    row.animate({ opacity: [0, 1] }, { duration: 240, easing: 'ease-out' });
+  }
 }
-setTimeout(() => { grid.dataset.ready = 'true'; }, Number(new URLSearchParams(location.search).get('delay') || 200));
+
+const delayParam = new URLSearchParams(location.search).get('delay');
+const requestedDelay = Number(delayParam);
+const readyDelay = delayParam !== null && delayParam !== ''
+  && Number.isFinite(requestedDelay) && requestedDelay >= 0
+  ? requestedDelay
+  : 200;
+
+setTimeout(() => {
+  grid.dataset.ready = 'true';
+  requestAnimationFrame(animateVisibleRows);
+}, readyDelay);
