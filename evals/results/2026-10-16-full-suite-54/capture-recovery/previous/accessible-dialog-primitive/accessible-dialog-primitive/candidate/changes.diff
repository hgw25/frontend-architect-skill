+    const context = useDialogContext('Dialog.Close')
+
+    return (
+      <button
+        {...props}
+        onClick={(event) => {
+          onClick?.(event)
+          if (!event.defaultPrevented) context.requestOpenChange(false, 'close-button')
+        }}
+        ref={ref}
+        type={type}
+      />
+    )
+  },
+)
+
+export const Dialog = {
+  Close: DialogClose,
+  Content: DialogContent,
+  Description: DialogDescription,
+  Overlay: DialogOverlay,
+  Portal: DialogPortal,
+  Root: DialogRoot,
+  Title: DialogTitle,
