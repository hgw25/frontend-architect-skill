-function draw() {
+const state = {
+  rows: [...invitations],
+  overview: initialOverview,
+  email: '',
+  note: '',
+  message: '',
+  sendError: '',
+  overviewError: '',
+  sending: false,
+  refreshingOverview: false,
+};
+
+function element(tag, text) {
+  const node = document.createElement(tag);
+  if (text) node.textContent = text;
+  return node;
+}
+
+function restoreListFocus(target) {
+  if (!target) return;
+  const row = app.querySelector(`[data-invite-id="${target.inviteId}"]`);
+  row?.querySelector(`[data-action="${target.action}"]`)?.focus();
+}
+
+function moveInvitation(inviteId, delta, action) {
+  const position = state.rows.findIndex(row => row.id === inviteId);
+  const nextPosition = position + delta;
+  if (nextPosition < 0 || nextPosition >= state.rows.length) return;
+
+  [state.rows[position], state.rows[nextPosition]] = [state.rows[nextPosition], state.rows[position]];
+  draw({ inviteId, action });
+}
+
+async function refreshOverview({ render = true } = {}) {
+  state.refreshingOverview = true;
+  try {
+    state.overview = await readOverview();
+    state.overviewError = '';
+  } catch {
+    state.overviewError = 'Overview unavailable. Try refreshing again.';
+  } finally {
+    state.refreshingOverview = false;
+    if (render) draw();
+  }
+}
+
+async function submitInvitation(event) {
+  event.preventDefault();
+  if (state.sending) return;
+
+  const submittedEmail = state.email;
+  state.sending = true;
+  state.sendError = '';
+  state.message = '';
+  // Keep the current DOM in place while the request is pending so a user can
+  // continue working in the note and list without replacing their active control.
+  event.currentTarget.querySelector('button[type="submit"]').disabled = true;
+
+  try {
+    const result = await sendInvitation(submittedEmail);
+    state.rows.push(result.invitation);
+    state.message = `Invitation accepted for ${result.invitation.email}.`;
+    if (state.email === submittedEmail) state.email = '';
+    await refreshOverview({ render: false });
+  } catch {
+    state.sendError = 'Invitation failed. Check the email and try again.';
+    state.message = '';
+    state.sending = false;
+    draw();
+    return;
+  }
+
+  state.sending = false;
+  draw();
+}
+
