+for (const returnsToSubmitted of [false, true]) {
+  test(`pending send preserves ${returnsToSubmitted ? 'A → B → A' : 'a different'} Email edit without taking focus`, async ({ page }) => {
+    const request = deferred();
+    const release = deferred();
+    await page.route('**/api/invitations', async route => {
+      request.resolve();
+      await release.promise;
+      await route.fulfill({ json: accepted('ada@example.test') });
+    });
+    await page.goto('/');
+    const email = page.getByRole('textbox', { name: 'Email', exact: true });
+    await email.fill('ada@example.test');
+    await email.press('Enter');
+    await request.promise;
+    await email.fill('next@example.test');
+    if (returnsToSubmitted) await email.fill('ada@example.test');
+    release.resolve();
+    await expect(confirmation(page)).toContainText('ada@example.test');
+    await expect(page.getByTestId('overview')).toHaveText('Pending: 5');
+    await expect(email).toHaveValue(returnsToSubmitted ? 'ada@example.test' : 'next@example.test');
+    await expect(email).toBeFocused();
+  });
+}
