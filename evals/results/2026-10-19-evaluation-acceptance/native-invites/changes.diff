@@ -0,0 +1,32 @@
+import { readOverview } from './transport.mjs';
+
+export function mountOverview(section, initialOverview) {
+  const total = section.querySelector('[data-testid="overview"]');
+  const progress = section.querySelector('[data-overview-progress]');
+  const error = section.querySelector('[data-overview-error]');
+  let requestVersion = 0;
+  total.textContent = `Pending: ${initialOverview.pending}`;
+
+  async function refresh() {
+    const version = ++requestVersion;
+    progress.textContent = 'Refreshing overview…';
+    error.textContent = '';
+
+    let overview;
+    try {
+      overview = await readOverview();
+    } catch {
+      if (version !== requestVersion) return;
+      progress.textContent = '';
+      error.textContent = 'Overview unavailable. Showing the last known total. Use Refresh overview to try again.';
+      return;
+    }
+
+    if (version !== requestVersion) return;
+    total.textContent = `Pending: ${overview.pending}`;
+    progress.textContent = '';
+  }
+
+  section.querySelector('button').addEventListener('click', refresh);
+  return { refresh };
+}
