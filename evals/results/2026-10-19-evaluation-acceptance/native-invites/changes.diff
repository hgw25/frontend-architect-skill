+test('a rejected send preserves its draft and error through overview refresh, then permits an edited retry', async ({ page }) => {
+  const submitted = [];
+  await page.route('**/api/invitations', route => {
+    const { email } = route.request().postDataJSON();
+    submitted.push(email);
+    return submitted.length === 1
+      ? route.fulfill({ status: 503, body: 'Unavailable' })
+      : route.fulfill({ json: accepted(email) });
+  });
+  await page.goto('/');
+  const email = page.getByRole('textbox', { name: 'Email', exact: true });
+  const send = page.getByRole('button', { name: 'Send invitation', exact: true });
+  await email.fill('first@example.test');
+  await send.click();
+  const failure = page.getByRole('alert').filter({ hasText: /Invitation could not be sent/ });
+  await expect(failure).toBeVisible();
+  await expect(email).toHaveValue('first@example.test');
+  await expect(send).toBeEnabled();
+  await expect(rows(page)).toHaveCount(4);
+  await page.getByRole('button', { name: 'Refresh overview', exact: true }).click();
+  await expect(page.getByTestId('overview')).toHaveText('Pending: 5');
+  await expect(failure).toBeVisible();
+
+  await email.fill('second@example.test');
+  await send.click();
+  await expect(confirmation(page)).toContainText('second@example.test');
+  await expect(failure).toHaveCount(0);
+  await expect(rows(page)).toHaveCount(5);
+  expect(submitted).toEqual(['first@example.test', 'second@example.test']);
+});
