+import { sendInvitation } from './transport.mjs';
+
+export function mountInvitationForm(form, onAccepted) {
+  const email = form.elements.namedItem('email');
+  const submit = form.querySelector('[type="submit"]');
+  const progress = form.querySelector('[data-send-progress]');
+  const confirmation = form.querySelector('[data-send-confirmation]');
+  const error = form.querySelector('[data-send-error]');
+  let sending = false;
+  let editVersion = 0;
+
+  email.addEventListener('input', () => { editVersion += 1; });
+
+  form.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (sending) return;
+
+    const submittedEmail = email.value;
+    const submittedVersion = editVersion;
+    sending = true;
+    submit.disabled = true;
+    error.textContent = '';
+    progress.textContent = 'Sending invitation…';
+
+    let result;
+    try {
+      result = await sendInvitation(submittedEmail);
+    } catch {
+      error.textContent = 'Invitation could not be sent. Edit the email or try again.';
+      return;
+    } finally {
+      sending = false;
+      submit.disabled = false;
+      progress.textContent = '';
+    }
+
+    confirmation.textContent = `Invitation sent to ${result.invitation.email}. Sending number: ${result.receipt.id}.`;
+    // Text equality alone misses edits such as A → B → A while the request waits.
+    if (editVersion === submittedVersion) {
+      email.value = '';
+      editVersion += 1;
+    }
+    onAccepted(result);
+  });
+}
