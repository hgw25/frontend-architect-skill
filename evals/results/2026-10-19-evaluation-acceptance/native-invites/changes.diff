+test('one pending submission sends once while list actions and selected note editing remain usable', async ({ page }) => {
+  const request = deferred();
+  const release = deferred();
+  let sends = 0;
+  await page.route('**/api/invitations', async route => {
+    sends += 1;
+    request.resolve(route.request().postDataJSON());
+    await release.promise;
+    await route.fulfill({ json: accepted('ada@example.test') });
+  });
+  await page.goto('/');
+  const email = page.getByRole('textbox', { name: 'Email', exact: true });
+  const note = page.getByRole('textbox', { name: 'Team note', exact: true });
+  const send = page.getByRole('button', { name: 'Send invitation', exact: true });
+  await email.fill('ada@example.test');
+  await email.press('Enter');
+  expect(await request.promise).toEqual({ email: 'ada@example.test' });
+  await expect(send).toBeDisabled();
+  await expect(email).toBeFocused();
+  await page.keyboard.press('Enter');
+  await page.keyboard.press('Enter');
+  await page.locator('[data-invite-id="mia"]').getByRole('button', { name: 'Move later', exact: true }).click();
+  expect(await order(page)).toEqual(['tom', 'mia', 'zoe', 'lee']);
+
+  await note.fill('Plan launch today');
+  for (let i = 0; i < 6; i++) await page.keyboard.press('ArrowLeft');
+  for (let i = 0; i < 6; i++) await page.keyboard.press('Shift+ArrowLeft');
+  await expect(note).toBeFocused();
+  expect(await note.evaluate(node => [node.selectionStart, node.selectionEnd])).toEqual([5, 11]);
+  release.resolve();
+  await expect(confirmation(page)).toContainText('receipt-new-1');
+  await expect(page.getByTestId('overview')).toHaveText('Pending: 5');
+  await expect(note).toBeFocused();
+  expect(await note.evaluate(node => [node.selectionStart, node.selectionEnd])).toEqual([5, 11]);
+  await page.keyboard.type('review');
+  await expect(note).toHaveValue('Plan review today');
+  expect(await order(page)).toEqual(['tom', 'mia', 'zoe', 'lee', 'new-1']);
+  expect(sends).toBe(1);
+});
