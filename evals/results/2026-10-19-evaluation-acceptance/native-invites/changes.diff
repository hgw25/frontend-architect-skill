+export function mountInvitationList(list, invitations) {
+  function addInvitation(invitation) {
+    const item = document.createElement('li');
+    item.dataset.inviteId = invitation.id;
+    const email = document.createElement('span');
+    email.textContent = invitation.email;
+    item.append(email);
+
+    for (const [name, delta] of [['Move earlier', -1], ['Move later', 1]]) {
+      const button = document.createElement('button');
+      button.type = 'button';
+      button.textContent = name;
+      button.addEventListener('click', () => {
+        const neighbor = delta < 0 ? item.previousElementSibling : item.nextElementSibling;
+        if (!neighbor) return;
+
+        const focused = document.activeElement;
+        const restoreFocus = item.contains(focused);
+        list.insertBefore(item, delta < 0 ? neighbor : neighbor.nextElementSibling);
+        // Moving an existing node can blur it; continue the same keyboard action.
+        if (restoreFocus && document.activeElement !== focused) {
+          focused.focus({ preventScroll: true });
+        }
+      });
+      item.append(button);
+    }
+
+    list.append(item);
+  }
+
+  invitations.forEach(addInvitation);
+  return { addInvitation };
+}
