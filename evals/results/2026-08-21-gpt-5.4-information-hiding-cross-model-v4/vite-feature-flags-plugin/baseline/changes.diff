@@ -1,10 +1,403 @@
-import type { Plugin } from 'vite'
+import { readFile } from 'node:fs/promises'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import type { HmrContext, Plugin, ResolvedConfig } from 'vite'
+
+export type FeatureFlagPrimitive = boolean | number | string
+
+type BooleanFlagDefinition = { kind: 'boolean' }
+type NumberFlagDefinition = { kind: 'number' }
+type StringFlagDefinition = { kind: 'string' }
+type EnumFlagDefinition<TValues extends readonly [string, ...string[]] = readonly [string, ...string[]]> = {
+  kind: 'enum'
+  values: TValues
+}
+
+export type FeatureFlagDefinition =
+  | BooleanFlagDefinition
+  | NumberFlagDefinition
+  | StringFlagDefinition
+  | EnumFlagDefinition
+
+export type FeatureFlagSchema = Record<string, FeatureFlagDefinition>
+
+export interface FeatureFlagsRegistry {}
+
+export type InferFeatureFlags<TSchema extends FeatureFlagSchema> = Readonly<{
+  [TKey in keyof TSchema]: InferFeatureFlagValue<TSchema[TKey]>
+}>
+
+type InferFeatureFlagValue<TDefinition extends FeatureFlagDefinition> =
+  TDefinition extends BooleanFlagDefinition ? boolean
+  : TDefinition extends NumberFlagDefinition ? number
+  : TDefinition extends StringFlagDefinition ? string
+  : TDefinition extends EnumFlagDefinition<infer TValues> ? TValues[number]
+  : never
+
+export interface FeatureFlagsOptions<TSchema extends FeatureFlagSchema> {
+  source: string | URL
+  schema: TSchema
+  expose: readonly (keyof TSchema & string)[]
+}
+
+interface ResolvedFeatureFlagsOptions<TSchema extends FeatureFlagSchema> {
+  sourcePath: string
+  schema: TSchema
+  expose: readonly (keyof TSchema & string)[]
+}
+
+interface LoadedFlags {
+  publicFlags: Record<string, FeatureFlagPrimitive>
+  sourceMapContent: string
+}
+
+const PLUGIN_NAME = 'feature-flags'
+const VIRTUAL_MODULE_ID = 'virtual:feature-flags'
+const RESOLVED_VIRTUAL_MODULE_ID = '\0virtual:feature-flags'
+
+export const flag = {
+  boolean(): BooleanFlagDefinition {
+    return { kind: 'boolean' }
+  },
+  number(): NumberFlagDefinition {
+    return { kind: 'number' }
+  },
+  string(): StringFlagDefinition {
+    return { kind: 'string' }
+  },
+  enum<const TValues extends readonly [string, ...string[]]>(values: TValues): EnumFlagDefinition<TValues> {
+    return { kind: 'enum', values }
+  },
+}
+
+export function defineFeatureFlags<const TSchema extends FeatureFlagSchema>(schema: TSchema): TSchema {
+  return schema
+}
+
+export function featureFlags<const TSchema extends FeatureFlagSchema>(
+  options: FeatureFlagsOptions<TSchema>,
+): Plugin {
+  let config: ResolvedConfig | undefined
+  let resolvedOptions: ResolvedFeatureFlagsOptions<TSchema> | undefined
+  let cachedFlags: LoadedFlags | undefined
+  let dirty = true
 
-export function featureFlags(flags: Record<string, unknown>): Plugin {
   return {
-    name: 'feature-flags',
-    transform(code: string) {
-      return code.replaceAll('__FLAGS__', JSON.stringify(flags))
+    name: PLUGIN_NAME,
+    enforce: 'pre',
+    configResolved(resolvedConfig) {
+      config = resolvedConfig
+      resolvedOptions = resolveOptions(options, resolvedConfig)
+    },
+    async buildStart() {
+      const flags = await loadFlags()
+      this.addWatchFile(getOptions().sourcePath)
+
+      if (config?.command === 'build') {
+        cachedFlags = flags
+        dirty = false
+      }
+    },
+    resolveId(id) {
+      if (id === VIRTUAL_MODULE_ID) {
+        return RESOLVED_VIRTUAL_MODULE_ID
+      }
+
+      return null
     },
+    async load(id) {
+      if (id !== RESOLVED_VIRTUAL_MODULE_ID) {
+        return null
+      }
+
+      const { publicFlags, sourceMapContent } = await loadFlags()
+      const sourcePath = getOptions().sourcePath
+
+      return {
+        code: createVirtualModuleCode(publicFlags),
+        map: {
+          version: 3,
+          file: id,
+          sources: [sourcePath],
+          sourcesContent: [sourceMapContent],
+          names: [],
+          mappings: '',
+        },
+      }
+    },
+    handleHotUpdate(context) {
+      if (normalizePath(context.file) !== normalizePath(getOptions().sourcePath)) {
+        return
+      }
+
+      dirty = true
+      invalidateVirtualModule(context)
+      context.server.ws.send({ type: 'full-reload' })
+      return []
+    },
+  }
+
+  function getOptions(): ResolvedFeatureFlagsOptions<TSchema> {
+    if (!resolvedOptions) {
+      throw new Error(`[${PLUGIN_NAME}] Vite config was not resolved before plugin execution.`)
+    }
+
+    return resolvedOptions
+  }
+
+  async function loadFlags(): Promise<LoadedFlags> {
+    if (!dirty && cachedFlags) {
+      return cachedFlags
+    }
+
+    const nextFlags = await readAndValidateFlags(getOptions())
+    cachedFlags = nextFlags
+    dirty = false
+    return nextFlags
+  }
+}
+
+function resolveOptions<const TSchema extends FeatureFlagSchema>(
+  options: FeatureFlagsOptions<TSchema>,
+  config: ResolvedConfig,
+): ResolvedFeatureFlagsOptions<TSchema> {
+  const sourcePath = resolveSourcePath(options.source, config.root)
+  const expose = validateExposeOption(options.expose)
+  validateSchemaOption(options.schema)
+
+  return {
+    sourcePath,
+    schema: options.schema,
+    expose,
+  }
+}
+
+function resolveSourcePath(source: string | URL, root: string): string {
+  if (source instanceof URL) {
+    if (source.protocol !== 'file:') {
+      throw createDiagnostic(
+        `Invalid "source" URL ${String(source)}.`,
+        'Use a file URL such as new URL("./flags.json", import.meta.url).',
+      )
+    }
+
+    return normalizePath(fileURLToPath(source))
+  }
+
+  if (!source.trim()) {
+    throw createDiagnostic('Invalid "source" option.', 'Provide a non-empty path to a JSON file.')
+  }
+
+  return normalizePath(path.isAbsolute(source) ? source : path.resolve(root, source))
+}
+
+function validateExposeOption<TExpose extends readonly string[]>(expose: TExpose): TExpose {
+  if (expose.length === 0) {
+    throw createDiagnostic(
+      'Invalid "expose" option.',
+      'List the public flags that are safe to ship to the browser, for example expose: ["checkoutV2"].',
+    )
+  }
+
+  const duplicates = findDuplicates(expose)
+  if (duplicates.length > 0) {
+    throw createDiagnostic(
+      `Duplicate keys in "expose": ${duplicates.join(', ')}.`,
+      'Remove duplicate names so the browser contract stays deterministic.',
+    )
+  }
+
+  return expose
+}
+
+function validateSchemaOption(schema: FeatureFlagSchema): void {
+  const keys = Object.keys(schema)
+  if (keys.length === 0) {
+    throw createDiagnostic(
+      'Invalid "schema" option.',
+      'Define at least one public flag schema with defineFeatureFlags({ ... }).',
+    )
   }
 }
+
+async function readAndValidateFlags<TSchema extends FeatureFlagSchema>(
+  options: ResolvedFeatureFlagsOptions<TSchema>,
+): Promise<LoadedFlags> {
+  let raw: string
+
+  try {
+    raw = await readFile(options.sourcePath, 'utf8')
+  } catch (error) {
+    const detail = error instanceof Error ? error.message : String(error)
+    throw createDiagnostic(
+      `Cannot read feature flag source "${options.sourcePath}".`,
+      `Create the file or fix the path. Underlying error: ${detail}`,
+    )
+  }
+
+  const parsed = parseFlagSource(raw, options.sourcePath)
+  const publicFlags = projectPublicFlags(parsed, options)
+
+  return {
+    publicFlags,
+    sourceMapContent: JSON.stringify(publicFlags, null, 2),
+  }
+}
+
+function parseFlagSource(raw: string, sourcePath: string): Record<string, unknown> {
+  let parsed: unknown
+
+  try {
+    parsed = JSON.parse(raw)
+  } catch (error) {
+    const detail = error instanceof Error ? error.message : String(error)
+    throw createDiagnostic(
+      `Cannot parse JSON from "${sourcePath}".`,
+      `Fix the JSON syntax. Underlying error: ${detail}`,
+    )
+  }
+
+  if (!isPlainObject(parsed)) {
+    throw createDiagnostic(
+      `Invalid flag source "${sourcePath}".`,
+      'The JSON file must contain a top-level object such as { "checkoutV2": true }.',
+    )
+  }
+
+  return parsed
+}
+
+function projectPublicFlags<TSchema extends FeatureFlagSchema>(
+  source: Record<string, unknown>,
+  options: ResolvedFeatureFlagsOptions<TSchema>,
+): Record<string, FeatureFlagPrimitive> {
+  const publicFlags: Record<string, FeatureFlagPrimitive> = {}
+
+  for (const flagName of options.expose) {
+    const definition = options.schema[flagName]
+    if (!definition) {
+      throw createDiagnostic(
+        `Unknown exposed flag "${flagName}".`,
+        `Add "${flagName}" to the schema or remove it from expose: [...].`,
+      )
+    }
+
+    if (!(flagName in source)) {
+      throw createDiagnostic(
+        `Missing exposed flag "${flagName}" in "${options.sourcePath}".`,
+        `Add "${flagName}" to the JSON file or remove it from expose: [...].`,
+      )
+    }
+
+    const value = source[flagName]
+    assertFlagValue(flagName, value, definition, options.sourcePath)
+    publicFlags[flagName] = value
+  }
+
+  return publicFlags
+}
+
+function assertFlagValue(
+  flagName: string,
+  value: unknown,
+  definition: FeatureFlagDefinition,
+  sourcePath: string,
+): asserts value is FeatureFlagPrimitive {
+  if (definition.kind === 'boolean') {
+    if (typeof value !== 'boolean') {
+      throw createDiagnostic(
+        `Flag "${flagName}" in "${sourcePath}" must be a boolean.`,
+        `Received ${describeValue(value)}. Update the JSON value or change the schema.`,
+      )
+    }
+
+    return
+  }
+
+  if (definition.kind === 'number') {
+    if (typeof value !== 'number' || Number.isNaN(value)) {
+      throw createDiagnostic(
+        `Flag "${flagName}" in "${sourcePath}" must be a number.`,
+        `Received ${describeValue(value)}. Update the JSON value or change the schema.`,
+      )
+    }
+
+    return
+  }
+
+  if (definition.kind === 'string') {
+    if (typeof value !== 'string') {
+      throw createDiagnostic(
+        `Flag "${flagName}" in "${sourcePath}" must be a string.`,
+        `Received ${describeValue(value)}. Update the JSON value or change the schema.`,
+      )
+    }
+
+    return
+  }
+
+  if (typeof value !== 'string' || !definition.values.includes(value)) {
+    throw createDiagnostic(
+      `Flag "${flagName}" in "${sourcePath}" must be one of ${definition.values.map((item) => JSON.stringify(item)).join(', ')}.`,
+      `Received ${describeValue(value)}. Update the JSON value or widen the enum schema.`,
+    )
+  }
+}
+
+function createVirtualModuleCode(flags: Record<string, FeatureFlagPrimitive>): string {
+  const serializedFlags = JSON.stringify(flags, null, 2)
+  return [
+    `const flags = Object.freeze(${serializedFlags})`,
+    '',
+    'export { flags }',
+    'export default flags',
+    '',
+  ].join('\n')
+}
+
+function invalidateVirtualModule(context: HmrContext): void {
+  const module = context.server.moduleGraph.getModuleById(RESOLVED_VIRTUAL_MODULE_ID)
+  if (module) {
+    context.server.moduleGraph.invalidateModule(module)
+  }
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function findDuplicates(values: readonly string[]): string[] {
+  const seen = new Set<string>()
+  const duplicates = new Set<string>()
+
+  for (const value of values) {
+    if (seen.has(value)) {
+      duplicates.add(value)
+    }
+
+    seen.add(value)
+  }
+
+  return [...duplicates]
+}
+
+function normalizePath(input: string): string {
+  return input.split(path.sep).join(path.posix.sep)
+}
+
+function describeValue(value: unknown): string {
+  if (typeof value === 'string') {
+    return `string ${JSON.stringify(value)}`
+  }
+
+  if (value === null) {
+    return 'null'
+  }
+
+  return `${typeof value} ${String(value)}`
+}
+
+function createDiagnostic(problem: string, remediation: string): Error {
+  return new Error(`[${PLUGIN_NAME}] ${problem} ${remediation}`)
+}
