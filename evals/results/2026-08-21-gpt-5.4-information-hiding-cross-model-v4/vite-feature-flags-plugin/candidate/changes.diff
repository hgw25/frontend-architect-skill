+}
+
+function parseFeatureFlagSource(rawSource: string, sourcePath: string): Record<string, unknown> {
+  let parsed: unknown
+
+  try {
+    parsed = JSON.parse(rawSource)
+  } catch (error) {
+    throw createDiagnostic(
+      `Cannot parse feature flag source "${sourcePath}" as JSON.`,
+      'Fix the JSON syntax or point the "source" option at a valid JSON file.',
+      error,
+    )
+  }
+
+  if (!isPlainRecord(parsed)) {
+    throw createDiagnostic(
+      `Feature flag source "${sourcePath}" must contain a top-level JSON object.`,
+      'Export a flat object whose values are booleans, numbers, strings, or null.',
+    )
+  }
+
+  return parsed
+}
+
+function selectExposedFlags(
+  source: Record<string, unknown>,
+  expose: readonly string[],
+  sourcePath: string,
+): FeatureFlagsShape {
+  if (expose.length === 0) {
+    throw createDiagnostic(
+      'The "expose" option must contain at least one public flag name.',
+      'Add the public flag keys you want the client bundle to receive.',
+    )
+  }
+
+  const missingFlags = expose.filter((name) => !(name in source))
+  if (missingFlags.length > 0) {
+    throw createDiagnostic(
+      `The "expose" list references missing flags in "${sourcePath}": ${missingFlags.join(', ')}.`,
+      `Available flags: ${Object.keys(source).sort().join(', ') || '(none)'}.`,
+    )
+  }
+
+  const filteredFlags: FeatureFlagsShape = {}
+
+  for (const flagName of expose) {
+    const value = source[flagName]
+
+    if (!isFeatureFlagPrimitive(value)) {
+      throw createDiagnostic(
+        `Flag "${flagName}" in "${sourcePath}" is not client-safe.`,
+        'Only booleans, numbers, strings, and null can be exposed through "virtual:feature-flags".',
+      )
+    }
+
+    filteredFlags[flagName] = value
+  }
+
+  return filteredFlags
+}
+
+function createVirtualModuleCode(flags: FeatureFlagsShape): string {
+  return [
+    `const flags = Object.freeze(${JSON.stringify(flags, null, 2)})`,
+    '',
+    'export { flags }',
+    '',
+  ].join('\n')
+}
+
+function createDeclarationCode(flags: FeatureFlagsShape): string {
+  const properties = Object.entries(flags)
+    .sort(([left], [right]) => left.localeCompare(right))
+    .map(([name, value]) => `    readonly ${formatPropertyName(name)}: ${mapDeclarationType(value)}`)
+    .join('\n')
+
+  return [
+    "declare module 'virtual:feature-flags' {",
+    '  export const flags: {',
+    properties || '    // no public flags',
+    '  }',
+    '}',
+    '',
+  ].join('\n')
+}
+
+function mapDeclarationType(value: FeatureFlagPrimitive): string {
+  if (value === null) {
+    return 'null'
+  }
+  switch (typeof value) {
+    case 'boolean':
+      return 'boolean'
+    case 'number':
+      return 'number'
+    default:
+      return 'string'
+  }
+}
+
+function formatPropertyName(name: string): string {
+  return /^[A-Za-z_$][\w$]*$/u.test(name) ? name : JSON.stringify(name)
+}
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function isFeatureFlagPrimitive(value: unknown): value is FeatureFlagPrimitive {
+  return value === null || ['boolean', 'number', 'string'].includes(typeof value)
+}
+
+function createDiagnostic(summary: string, detail: string, cause?: unknown): Error {
+  const message = [`[${PLUGIN_NAME}] ${summary}`, detail]
+  if (cause instanceof Error && cause.message) {
+    message.push(`Cause: ${cause.message}`)
   }
+  return new Error(message.join('\n'))
 }
