-import type { Plugin } from 'vite'
+import { watch } from 'node:fs'
+import type { FSWatcher } from 'node:fs'
+import { mkdir, readFile, writeFile } from 'node:fs/promises'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import type { ModuleNode, Plugin, ResolvedConfig, ViteDevServer } from 'vite'
+import { normalizePath } from 'vite'
+
+export type FeatureFlagPrimitive = boolean | number | string | null
+export interface FeatureFlagsShape extends Record<string, FeatureFlagPrimitive> {}
+
+export interface FeatureFlagsOptions<T extends FeatureFlagsShape = FeatureFlagsShape> {
+  source: string | URL
+  expose: readonly (Extract<keyof T, string>)[]
+  declarationPath?: string
+}
+
+const PLUGIN_NAME = 'feature-flags'
+const VIRTUAL_MODULE_ID = 'virtual:feature-flags'
+const RESOLVED_VIRTUAL_MODULE_ID = '\0virtual:feature-flags'
+const DEFAULT_DECLARATION_PATH = 'src/feature-flags.generated.d.ts'
+const PACKAGE_NAME = '@frontend-architect-eval/feature-flags'
+
+type FeatureFlagsSnapshot = {
+  declarationCode: string
+  filteredFlags: FeatureFlagsShape
+  moduleCode: string
+}
+
+export function featureFlags<T extends FeatureFlagsShape = FeatureFlagsShape>(
+  options: FeatureFlagsOptions<T>,
+): Plugin {
+  let config: ResolvedConfig | null = null
+  let server: ViteDevServer | null = null
+  let cachedKey: string | null = null
+  let cachedSnapshot: FeatureFlagsSnapshot | null = null
+  let fileWatcher: FSWatcher | null = null
+  let refreshPromise: Promise<void> | null = null
+  let sourcePath = ''
+  let declarationPath = ''
+
+  function resolveSourcePath(): string {
+    if (options.source instanceof URL) {
+      return normalizePath(fileURLToPath(options.source))
+    }
+
+    const source = options.source.startsWith('file:')
+      ? fileURLToPath(new URL(options.source))
+      : path.resolve(config?.root ?? process.cwd(), options.source)
+
+    return normalizePath(source)
+  }
+
+  function resolveDeclarationPath(): string {
+    const target = options.declarationPath ?? DEFAULT_DECLARATION_PATH
+
+    if (path.isAbsolute(target)) {
+      return normalizePath(target)
+    }
+
+    return normalizePath(path.resolve(config?.root ?? process.cwd(), target))
+  }
+
+  async function readSnapshot(): Promise<FeatureFlagsSnapshot> {
+    const rawSource = await readFile(sourcePath, 'utf8').catch((error: unknown) => {
+      throw createDiagnostic(
+        `Cannot read feature flag source "${sourcePath}".`,
+        `Update the "source" option to point at a readable JSON file.`,
+        error,
+      )
+    })
+    const cacheKey = JSON.stringify([sourcePath, declarationPath, [...options.expose], rawSource])
+
+    if (cacheKey === cachedKey && cachedSnapshot) {
+      return cachedSnapshot
+    }
+
+    const parsed = parseFeatureFlagSource(rawSource, sourcePath)
+    const filteredFlags = selectExposedFlags(parsed, options.expose, sourcePath)
+    const snapshot = {
+      declarationCode: createDeclarationCode(filteredFlags),
+      filteredFlags,
+      moduleCode: createVirtualModuleCode(filteredFlags),
+    }
+
+    cachedKey = cacheKey
+    cachedSnapshot = snapshot
+    return snapshot
+  }
+
+  async function writeDeclaration(snapshot: FeatureFlagsSnapshot): Promise<void> {
+    await mkdir(path.dirname(declarationPath), { recursive: true })
+
+    const current = await readFile(declarationPath, 'utf8').catch(() => null)
+    if (current === snapshot.declarationCode) {
+      return
+    }
+
+    await writeFile(declarationPath, snapshot.declarationCode, 'utf8')
+  }
+
+  async function syncArtifacts(): Promise<FeatureFlagsSnapshot> {
+    const snapshot = await readSnapshot()
+    await writeDeclaration(snapshot)
+    return snapshot
+  }
+
+  function invalidateVirtualModules(): ModuleNode[] {
+    if (!server) {
+      return []
+    }
+
+    const moduleIds = [VIRTUAL_MODULE_ID, RESOLVED_VIRTUAL_MODULE_ID]
+    const modules = moduleIds
+      .map((id) => server?.moduleGraph.getModuleById(id))
+      .filter((module): module is ModuleNode => module != null)
+
+    for (const module of modules) {
+      server.moduleGraph.invalidateModule(module)
+    }
+
+    return modules
+  }
+
+  function refreshFromSourceChange(): Promise<void> {
+    const refresh = async () => {
+      cachedKey = null
+      cachedSnapshot = null
+      await syncArtifacts()
+      invalidateVirtualModules()
+      server?.watcher.emit('change', sourcePath)
+    }
+
+    refreshPromise = (refreshPromise ?? Promise.resolve()).then(refresh, refresh)
+    return refreshPromise.finally(() => {
+      if (refreshPromise) {
+        refreshPromise = null
+      }
+    })
+  }
 
