new file mode 100644
index 0000000..5c0c342
--- /dev/null
+++ b/src/dialog-layer.ts
@@ -0,0 +1,230 @@
+type ElementSnapshot = {
+  ariaHidden: string | null
+  inert: boolean
+}
+
+export type DialogLayer = {
+  content: HTMLElement
+  dismiss: () => void
+  initialFocus: HTMLElement | null
+  restoreFocus: HTMLElement | null
+}
+
+type DocumentState = {
+  hiddenElements: Map<HTMLElement, ElementSnapshot>
+  layers: DialogLayer[]
+  originalBodyOverflow: string
+  onFocusIn: (event: FocusEvent) => void
+  onKeyDown: (event: KeyboardEvent) => void
+}
+
+const documentStates = new WeakMap<Document, DocumentState>()
+
+const focusableSelector = [
+  'a[href]',
+  'area[href]',
+  'button:not([disabled])',
+  'input:not([disabled]):not([type="hidden"])',
+  'select:not([disabled])',
+  'textarea:not([disabled])',
+  'iframe',
+  'object',
+  'embed',
+  '[contenteditable]:not([contenteditable="false"])',
+  '[tabindex]:not([tabindex="-1"])',
+].join(',')
+
+function isVisible(element: HTMLElement) {
+  const style = element.ownerDocument.defaultView?.getComputedStyle(element)
+
+  return (
+    !element.hidden &&
+    !element.closest('[hidden], [inert], [aria-hidden="true"]') &&
+    style?.display !== 'none' &&
+    style?.visibility !== 'hidden' &&
+    element.getClientRects().length > 0
+  )
+}
+
+function getFocusableElements(content: HTMLElement) {
+  return Array.from(content.querySelectorAll<HTMLElement>(focusableSelector)).filter(
+    (element) => element.tabIndex >= 0 && isVisible(element),
+  )
+}
+
+function focusFirst(layer: DialogLayer, backwards = false) {
+  const focusable = getFocusableElements(layer.content)
+  const target = backwards ? focusable.at(-1) : focusable[0]
+  ;(target ?? layer.content).focus()
+}
+
+function topLayer(state: DocumentState | undefined) {
+  return state?.layers.at(-1)
+}
+
+function restoreIsolation(state: DocumentState) {
+  for (const [element, snapshot] of state.hiddenElements) {
+    if (snapshot.ariaHidden === null) {
+      element.removeAttribute('aria-hidden')
+    } else {
+      element.setAttribute('aria-hidden', snapshot.ariaHidden)
+    }
+    element.inert = snapshot.inert
+  }
+  state.hiddenElements.clear()
+}
+
+function directBodyChild(element: HTMLElement) {
+  const body = element.ownerDocument.body
+  let current = element
+
+  while (current.parentElement && current.parentElement !== body) {
+    current = current.parentElement
+  }
+
+  return current.parentElement === body ? current : null
+}
+
+function applyIsolation(document: Document, state: DocumentState) {
+  restoreIsolation(state)
+
+  const top = topLayer(state)
+  if (!top) return
+
+  const visibleRoot = directBodyChild(top.content)
+  for (const child of document.body.children) {
+    if (!(child instanceof HTMLElement) || child === visibleRoot) continue
+
+    state.hiddenElements.set(child, {
+      ariaHidden: child.getAttribute('aria-hidden'),
+      inert: child.inert,
+    })
+    child.setAttribute('aria-hidden', 'true')
+    child.inert = true
+  }
+}
+
+function trapTab(event: KeyboardEvent, layer: DialogLayer) {
+  const focusable = getFocusableElements(layer.content)
+  const activeElement = layer.content.ownerDocument.activeElement
+
+  if (focusable.length === 0) {
+    event.preventDefault()
+    layer.content.focus()
+    return
+  }
+
+  const first = focusable[0]
+  const last = focusable[focusable.length - 1]
+  const focusIsInside = activeElement instanceof Node && layer.content.contains(activeElement)
+
+  if (!focusIsInside || activeElement === layer.content) {
+    event.preventDefault()
+    ;(event.shiftKey ? last : first).focus()
+  } else if (event.shiftKey && activeElement === first) {
+    event.preventDefault()
+    last.focus()
+  } else if (!event.shiftKey && activeElement === last) {
+    event.preventDefault()
+    first.focus()
+  }
+}
+
+function createDocumentState(document: Document): DocumentState {
+  const state: DocumentState = {
+    hiddenElements: new Map(),
+    layers: [],
+    originalBodyOverflow: document.body.style.overflow,
+    onFocusIn: () => undefined,
+    onKeyDown: () => undefined,
+  }
+
+  state.onKeyDown = (event) => {
+    const layer = topLayer(state)
+    if (!layer) return
+
+    if (event.key === 'Escape') {
+      event.preventDefault()
+      event.stopPropagation()
+      layer.dismiss()
+    } else if (event.key === 'Tab') {
+      trapTab(event, layer)
+    }
+  }
+
+  state.onFocusIn = (event) => {
+    const layer = topLayer(state)
+    const target = event.target
+    if (!layer || !(target instanceof Node) || layer.content.contains(target)) return
+
+    focusFirst(layer)
+  }
+
+  document.addEventListener('keydown', state.onKeyDown)
+  document.addEventListener('focusin', state.onFocusIn)
+  document.body.style.overflow = 'hidden'
+  documentStates.set(document, state)
+  return state
+}
+
+function destroyDocumentState(document: Document, state: DocumentState) {
+  restoreIsolation(state)
+  document.removeEventListener('keydown', state.onKeyDown)
+  document.removeEventListener('focusin', state.onFocusIn)
+  document.body.style.overflow = state.originalBodyOverflow
+  documentStates.delete(document)
+}
+
+export function registerDialogLayer(layer: DialogLayer) {
+  const document = layer.content.ownerDocument
+  const state = documentStates.get(document) ?? createDocumentState(document)
+
+  state.layers.push(layer)
+  applyIsolation(document, state)
+
+  queueMicrotask(() => {
+    if (topLayer(state) !== layer || !layer.content.isConnected) return
+
+    const initialFocus = layer.initialFocus
+    if (initialFocus && layer.content.contains(initialFocus) && isVisible(initialFocus)) {
+      initialFocus.focus()
+    } else {
+      focusFirst(layer)
+    }
+  })
+
+  return () => {
+    const index = state.layers.indexOf(layer)
+    if (index === -1) return
+
+    state.layers.splice(index, 1)
+    applyIsolation(document, state)
+
+    const remainingTopLayer = topLayer(state)
+    if (!remainingTopLayer) {
+      destroyDocumentState(document, state)
+    }
+
+    queueMicrotask(() => {
+      if (state.layers.includes(layer)) return
+
+      const restoreTarget = layer.restoreFocus
+      const activeLayer = topLayer(state)
+      if (
+        restoreTarget?.isConnected &&
+        (!activeLayer || activeLayer.content.contains(restoreTarget))
+      ) {
+        restoreTarget.focus()
+      } else if (activeLayer?.content.isConnected) {
+        focusFirst(activeLayer)
+      }
+    })
+  }
+}
+
+export function isTopDialog(content: HTMLElement | null) {
+  if (!content) return false
+
+  const state = documentStates.get(content.ownerDocument)
+  return topLayer(state)?.content === content
+}
