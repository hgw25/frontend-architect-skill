-import { type FormEvent, useState } from 'react'
+import { type FormEvent, useReducer, useRef, useState } from 'react'
 
 import { type Profile, updateProfile } from './api'
 
+type SaveState = {
+  confirmedProfile: Profile
+  confirmedRequestId: number
+  pending?: { requestId: number; displayName: string }
+  failed?: { requestId: number; displayName: string }
+}
+
+type SaveAction =
+  | { type: 'submitted'; requestId: number; displayName: string }
+  | { type: 'succeeded'; requestId: number; profile: Profile }
+  | { type: 'failed'; requestId: number; displayName: string }
+
+function saveReducer(state: SaveState, action: SaveAction): SaveState {
+  switch (action.type) {
+    case 'submitted':
+      return {
+        ...state,
+        pending: {
+          requestId: action.requestId,
+          displayName: action.displayName,
+        },
+        failed: undefined,
+      }
+    case 'succeeded': {
+      const isNewConfirmation = action.requestId > state.confirmedRequestId
+      const isCurrentRequest = state.pending?.requestId === action.requestId
+
+      if (!isNewConfirmation && !isCurrentRequest) return state
+
+      return {
+        ...state,
+        confirmedProfile: isNewConfirmation
+          ? action.profile
+          : state.confirmedProfile,
+        confirmedRequestId: isNewConfirmation
+          ? action.requestId
+          : state.confirmedRequestId,
+        pending: isCurrentRequest ? undefined : state.pending,
+        failed: isCurrentRequest ? undefined : state.failed,
+      }
+    }
+    case 'failed':
+      if (state.pending?.requestId !== action.requestId) return state
+
+      return {
+        ...state,
+        pending: undefined,
+        failed: {
+          requestId: action.requestId,
+          displayName: action.displayName,
+        },
+      }
+  }
+}
