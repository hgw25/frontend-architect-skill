diff --git a/src/searchI18n.ts b/src/searchI18n.ts
new file mode 100644
index 0000000..852acba
--- /dev/null
+++ b/src/searchI18n.ts
@@ -0,0 +1,65 @@
+export const supportedLocales = ['en-US', 'fr-FR'] as const
+
+export type SupportedLocale = (typeof supportedLocales)[number]
+
+type ResultMessage = (formattedCount: string) => string
+
+type SearchMessages = {
+  title: string
+  searchLabel: string
+  submit: string
+  loading: string
+  searchFailed: string
+  resultCount: Record<'one' | 'other', ResultMessage>
+  currency: string
+}
+
+const messages: Record<SupportedLocale, SearchMessages> = {
+  'en-US': {
+    title: 'Product search',
+    searchLabel: 'Search',
+    submit: 'Search',
+    loading: 'Searching…',
+    searchFailed: 'Search failed',
+    resultCount: {
+      one: (count) => `${count} result`,
+      other: (count) => `${count} results`,
+    },
+    currency: 'USD',
+  },
+  'fr-FR': {
+    title: 'Recherche de produits',
+    searchLabel: 'Rechercher',
+    submit: 'Rechercher',
+    loading: 'Recherche…',
+    searchFailed: 'La recherche a échoué',
+    resultCount: {
+      one: (count) => `${count} résultat`,
+      other: (count) => `${count} résultats`,
+    },
+    currency: 'EUR',
+  },
+}
+
+export function parseLocale(value: string | null): SupportedLocale {
+  return supportedLocales.find((locale) => locale === value) ?? 'en-US'
+}
+
+export function createSearchI18n(locale: SupportedLocale) {
+  const catalog = messages[locale]
+  const countFormat = new Intl.NumberFormat(locale)
+  const currencyFormat = new Intl.NumberFormat(locale, {
+    style: 'currency',
+    currency: catalog.currency,
+  })
+  const pluralRules = new Intl.PluralRules(locale)
+
+  return {
+    messages: catalog,
+    formatPrice: (price: number) => currencyFormat.format(price),
+    formatResultCount(count: number) {
+      const category = pluralRules.select(count) === 'one' ? 'one' : 'other'
+      return catalog.resultCount[category](countFormat.format(count))
+    },
+  }
+}
