+++ b/src/searchUrlState.ts
@@ -0,0 +1,32 @@
+import { parseLocale, type SupportedLocale } from './searchI18n'
+
+export type SearchUrlState = {
+  query: string
+  page: number
+  locale: SupportedLocale
+}
+
+export function parseSearchUrl(search: string): SearchUrlState {
+  const parameters = new URLSearchParams(search)
+  const parsedPage = Number(parameters.get('page'))
+
+  return {
+    query: parameters.get('q') ?? '',
+    page: Number.isSafeInteger(parsedPage) && parsedPage >= 1 ? parsedPage : 1,
+    locale: parseLocale(parameters.get('locale')),
+  }
+}
+
+export function serializeSearchUrl(
+  currentUrl: string,
+  state: SearchUrlState,
+): string {
+  const url = new URL(currentUrl)
+  url.search = new URLSearchParams({
+    q: state.query,
+    page: String(state.page),
+    locale: state.locale,
+  }).toString()
+
+  return `${url.pathname}${url.search}${url.hash}`
+}
