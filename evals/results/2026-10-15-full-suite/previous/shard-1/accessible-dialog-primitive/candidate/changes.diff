diff --git a/src/dialog-layer.ts b/src/dialog-layer.ts
new file mode 100644
index 0000000..f0dd787
--- /dev/null
+++ b/src/dialog-layer.ts
@@ -0,0 +1,149 @@
+type InertState = {
+  ariaHidden: string | null
+  inert: boolean
+}
+
+type DialogLayer = {
+  content: HTMLElement
+  portal: HTMLElement
+}
+
+export type DialogLayerManager = {
+  isTop: (content: HTMLElement | null) => boolean
+  register: (layer: DialogLayer) => () => void
+}
+
+const layerManagers = new WeakMap<Document, DialogLayerManager>()
+
+function createLayerManager(document: Document): DialogLayerManager {
+  const layers: DialogLayer[] = []
+  const originalInertStates = new Map<HTMLElement, InertState>()
+  let originalBodyOverflow = ''
+  let observer: MutationObserver | null = null
+
+  function restoreElements() {
+    for (const [element, state] of originalInertStates) {
+      element.inert = state.inert
+      if (state.ariaHidden === null) {
+        element.removeAttribute('aria-hidden')
+      } else {
+        element.setAttribute('aria-hidden', state.ariaHidden)
+      }
+    }
+  }
+
+  function hideSiblingsOf(element: HTMLElement) {
+    let current: HTMLElement | null = element
+
+    while (current && current !== document.body) {
+      const parent: HTMLElement | null = current.parentElement
+      if (!parent) break
+
+      for (const sibling of parent.children) {
+        if (!(sibling instanceof HTMLElement) || sibling === current) continue
+
+        if (!originalInertStates.has(sibling)) {
+          originalInertStates.set(sibling, {
+            ariaHidden: sibling.getAttribute('aria-hidden'),
+            inert: sibling.inert,
+          })
+        }
+        sibling.inert = true
+        sibling.setAttribute('aria-hidden', 'true')
+      }
+
+      current = parent
+    }
+  }
+
+  function syncModalIsolation() {
+    restoreElements()
+
+    const topLayer = layers.at(-1)
+    if (topLayer) {
+      hideSiblingsOf(topLayer.portal)
+      document.body.style.overflow = 'hidden'
+      return
+    }
+
+    originalInertStates.clear()
+    document.body.style.overflow = originalBodyOverflow
+  }
+
+  return {
+    isTop(content) {
+      return Boolean(content && layers.at(-1)?.content === content)
+    },
+    register(layer) {
+      if (layers.length === 0) {
+        originalBodyOverflow = document.body.style.overflow
+        observer = new MutationObserver(syncModalIsolation)
+        observer.observe(document.body, { childList: true, subtree: true })
+      }
+
+      layers.push(layer)
+      syncModalIsolation()
+
+      return () => {
+        const index = layers.lastIndexOf(layer)
+        if (index !== -1) layers.splice(index, 1)
+
+        if (layers.length === 0) {
+          observer?.disconnect()
+          observer = null
+        }
+        syncModalIsolation()
+      }
+    },
+  }
+}
+
+export function getDialogLayerManager(document: Document) {
+  let manager = layerManagers.get(document)
+  if (!manager) {
+    manager = createLayerManager(document)
+    layerManagers.set(document, manager)
+  }
+  return manager
+}
+
+const tabbableSelector = [
+  'a[href]',
+  'area[href]',
+  'button:not([disabled])',
+  'input:not([disabled]):not([type="hidden"])',
+  'select:not([disabled])',
+  'textarea:not([disabled])',
+  'iframe',
+  'object',
+  'embed',
+  'audio[controls]',
+  'video[controls]',
+  'summary',
+  '[contenteditable="true"]',
+  '[tabindex]:not([tabindex="-1"])',
+].join(',')
+
+function isTabbable(element: HTMLElement) {
+  if (element.hidden || element.closest('[hidden], [inert], [aria-hidden="true"]')) return false
+
+  const styles = element.ownerDocument.defaultView?.getComputedStyle(element)
+  return (
+    styles?.display !== 'none' &&
+    styles?.visibility !== 'hidden' &&
+    element.getClientRects().length > 0
+  )
+}
+
+export function getTabbableElements(container: HTMLElement) {
+  return Array.from(container.querySelectorAll<HTMLElement>(tabbableSelector)).filter(isTabbable)
+}
+
+export function focusFirst(container: HTMLElement, preferred?: HTMLElement | null) {
+  const target =
+    preferred && container.contains(preferred) && !preferred.closest('[inert]')
+      ? preferred
+      : getTabbableElements(container)[0] ?? container
+  target.focus({ preventScroll: true })
+  return target
+}
