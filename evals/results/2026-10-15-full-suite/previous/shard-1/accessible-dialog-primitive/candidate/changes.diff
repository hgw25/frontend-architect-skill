 // @vitest-environment node
 
+import { readFileSync } from 'node:fs'
+
+import { StrictMode } from 'react'
 import { renderToString } from 'react-dom/server'
 import { expect, test } from 'vitest'
 
 import { Dialog } from './Dialog'
+import { HydrationFixture } from './HydrationFixture'
 
 test('renders the closed primitive without accessing browser globals', () => {
   const html = renderToString(
-    <Dialog title="Example" description="Description" triggerLabel="Open">
-      <button type="button">Action</button>
-    </Dialog>,
+    <Dialog.Root>
+      <Dialog.Trigger>Open</Dialog.Trigger>
+      <Dialog.Portal>
+        <Dialog.Content>
+          <Dialog.Title>Example</Dialog.Title>
+        </Dialog.Content>
+      </Dialog.Portal>
+    </Dialog.Root>,
   )
 
   expect(html).toContain('Open')
 })
+
+test('keeps the server and initial hydration markup stable for a default-open dialog', () => {
+  const html = renderToString(
+    <Dialog.Root defaultOpen>
+      <Dialog.Trigger>Open</Dialog.Trigger>
+      <Dialog.Portal>
+        <Dialog.Content>
+          <Dialog.Title>Example</Dialog.Title>
+          <Dialog.Description>Description</Dialog.Description>
+        </Dialog.Content>
+      </Dialog.Portal>
+    </Dialog.Root>,
+  )
+
+  expect(html).toContain('aria-expanded="true"')
+  expect(html).not.toContain('role="dialog"')
+})
+
+test('keeps the browser hydration document synchronized with React server output', () => {
+  const serverMarkup = renderToString(
+    <StrictMode>
+      <HydrationFixture />
+    </StrictMode>,
+  )
+  const hydrationDocument = readFileSync(new URL('../hydration.html', import.meta.url), 'utf8')
+
+  expect(hydrationDocument).toContain(`<div id="hydration-root">${serverMarkup}</div>`)
+})
