+    ;(container ?? document.body).append(node)
+    setPortalNode(node)
+
+    return () => {
+      node.remove()
+      setPortalNode(null)
+    }
+  }, [container, context.open])
+
+  if (!context.open || !portalNode) return null
+
+  return createPortal(
+    <PortalContext.Provider value={portalNode}>{children}</PortalContext.Provider>,
+    portalNode,
   )
 }
+
+export type DialogOverlayProps = HTMLAttributes<HTMLDivElement>
+
+export const DialogOverlay = forwardRef<HTMLDivElement, DialogOverlayProps>(function DialogOverlay(
+  { onPointerDown, ...props },
+  forwardedRef,
+) {
+  const context = useDialogContext('DialogOverlay')
+
+  return (
+    <div
+      {...props}
+      onPointerDown={(event) => {
+        onPointerDown?.(event)
+        if (
+          !event.defaultPrevented &&
+          event.target === event.currentTarget &&
+          getDialogLayerManager(event.currentTarget.ownerDocument).isTop(
+            context.contentRef.current,
+          )
+        ) {
+          context.requestOpenChange(false, 'pointer-outside', event.nativeEvent)
+        }
+      }}
+      ref={forwardedRef}
+    />
+  )
+})
+
+export type DialogContentProps = HTMLAttributes<HTMLDivElement> & {
+  initialFocusRef?: RefObject<HTMLElement | null>
+  onCloseAutoFocus?: (event: Event) => void
+  onEscapeKeyDown?: (event: KeyboardEvent) => void
+  onOpenAutoFocus?: (event: Event) => void
+}
+
+export const DialogContent = forwardRef<HTMLDivElement, DialogContentProps>(function DialogContent(
+  {
+    'aria-describedby': ariaDescribedBy,
+    'aria-label': ariaLabel,
+    'aria-labelledby': ariaLabelledBy,
+    initialFocusRef,
+    onCloseAutoFocus,
+    onEscapeKeyDown,
+    onKeyDown,
+    onOpenAutoFocus,
+    role = 'dialog',
+    tabIndex = -1,
+    ...props
+  },
+  forwardedRef,
+) {
+  const context = useDialogContext('DialogContent')
+  const portalNode = useContext(PortalContext)
+  const closeAutoFocusRef = useLatest(onCloseAutoFocus)
+  const escapeKeyDownRef = useLatest(onEscapeKeyDown)
+  const openAutoFocusRef = useLatest(onOpenAutoFocus)
+
+  useEffect(() => {
+    const currentContent = context.contentRef.current
+    if (!currentContent || !context.open) return
+    const content: HTMLDivElement = currentContent
+
+    const document = content.ownerDocument
+    const manager = getDialogLayerManager(document)
+    const previouslyFocused =
+      document.activeElement instanceof HTMLElement ? document.activeElement : null
+    let lastFocusedInside: HTMLElement | null = null
+    let active = true
+    const unregister = manager.register({ content, portal: portalNode ?? content })
+
+    const openEvent = new Event('dialog.openAutoFocus', { cancelable: true })
+    openAutoFocusRef.current?.(openEvent)
+    if (!openEvent.defaultPrevented) {
+      queueMicrotask(() => {
+        if (!active || !manager.isTop(content)) return
+        lastFocusedInside = focusFirst(content, initialFocusRef?.current)
+      })
+    }
+
+    function handleFocusIn(event: FocusEvent) {
+      if (!active || !manager.isTop(content)) return
+      const target = event.target
+      if (target instanceof HTMLElement && content.contains(target)) {
+        lastFocusedInside = target
+        return
+      }
+
+      lastFocusedInside = focusFirst(
+        content,
+        lastFocusedInside?.isConnected ? lastFocusedInside : initialFocusRef?.current,
+      )
+    }
+
+    document.addEventListener('focusin', handleFocusIn)
+
+    return () => {
+      active = false
+      document.removeEventListener('focusin', handleFocusIn)
+      unregister()
+
+      const closeEvent = new Event('dialog.closeAutoFocus', { cancelable: true })
+      closeAutoFocusRef.current?.(closeEvent)
+      if (!closeEvent.defaultPrevented) {
+        const restoreTarget = context.triggerRef.current?.isConnected
+          ? context.triggerRef.current
+          : previouslyFocused?.isConnected
+            ? previouslyFocused
+            : null
+        restoreTarget?.focus({ preventScroll: true })
+      }
+    }
+  }, [
+    context.contentRef,
+    context.open,
+    context.triggerRef,
+    initialFocusRef,
+    portalNode,
+    closeAutoFocusRef,
+    openAutoFocusRef,
+  ])
+
+  if (!context.open) return null
+
+  return (
+    <div
+      {...props}
+      aria-describedby={
+        ariaDescribedBy ?? context.descriptionLabelIds
+      }
+      aria-label={ariaLabel}
+      aria-labelledby={
+        ariaLabelledBy ?? (!ariaLabel ? context.titleLabelId : undefined)
+      }
+      aria-modal="true"
+      id={context.contentId}
+      onKeyDown={(event) => {
+        onKeyDown?.(event)
+
+        const content = context.contentRef.current
+        if (!content || !getDialogLayerManager(content.ownerDocument).isTop(content)) return
+
+        if (event.key === 'Escape') {
+          escapeKeyDownRef.current?.(event.nativeEvent)
+          event.stopPropagation()
+          if (!event.defaultPrevented && !event.nativeEvent.defaultPrevented) {
+            event.preventDefault()
+            context.requestOpenChange(false, 'escape-key', event.nativeEvent)
+          }
+          return
+        }
+
+        if (event.key !== 'Tab' || event.defaultPrevented) return
+
+        const tabbableElements = getTabbableElements(content)
+        if (tabbableElements.length === 0) {
+          event.preventDefault()
+          content.focus({ preventScroll: true })
+          return
+        }
+
+        const first = tabbableElements[0]
+        const last = tabbableElements[tabbableElements.length - 1]
+        if (event.shiftKey && document.activeElement === first) {
+          event.preventDefault()
+          last.focus({ preventScroll: true })
+        } else if (!event.shiftKey && document.activeElement === last) {
+          event.preventDefault()
+          first.focus({ preventScroll: true })
+        }
+      }}
+      ref={(node) => {
+        context.contentRef.current = node
+        setRef(forwardedRef, node)
+      }}
+      role={role}
+      tabIndex={tabIndex}
+    />
+  )
+})
+
+export type DialogTitleProps = HTMLAttributes<HTMLHeadingElement>
+
+export const DialogTitle = forwardRef<HTMLHeadingElement, DialogTitleProps>(function DialogTitle(
+  { id, ...props },
+  forwardedRef,
+) {
+  const context = useDialogContext('DialogTitle')
+  const resolvedId = id ?? context.titleId
+  useEffect(() => context.registerTitle(resolvedId), [context.registerTitle, resolvedId])
+  return <h2 {...props} id={resolvedId} ref={forwardedRef} />
+})
+
+export type DialogDescriptionProps = HTMLAttributes<HTMLParagraphElement>
+
+export const DialogDescription = forwardRef<HTMLParagraphElement, DialogDescriptionProps>(
+  function DialogDescription({ id, ...props }, forwardedRef) {
+    const context = useDialogContext('DialogDescription')
+    const resolvedId = id ?? context.descriptionId
+    useEffect(
+      () => context.registerDescription(resolvedId),
+      [context.registerDescription, resolvedId],
+    )
+    return <p {...props} id={resolvedId} ref={forwardedRef} />
+  },
+)
+
+export type DialogCloseProps = ButtonHTMLAttributes<HTMLButtonElement>
+
+export const DialogClose = forwardRef<HTMLButtonElement, DialogCloseProps>(function DialogClose(
+  { onClick, type = 'button', ...props },
+  forwardedRef,
+) {
+  const context = useDialogContext('DialogClose')
+
+  return (
+    <button
+      {...props}
+      onClick={(event) => {
+        onClick?.(event)
+        if (!event.defaultPrevented) {
+          context.requestOpenChange(false, 'close-button', event.nativeEvent)
+        }
+      }}
+      ref={forwardedRef}
+      type={type}
+    />
+  )
+})
+
+export const Dialog = {
+  Close: DialogClose,
+  Content: DialogContent,
+  Description: DialogDescription,
+  Overlay: DialogOverlay,
+  Portal: DialogPortal,
+  Root: DialogRoot,
+  Title: DialogTitle,
+  Trigger: DialogTrigger,
+}
