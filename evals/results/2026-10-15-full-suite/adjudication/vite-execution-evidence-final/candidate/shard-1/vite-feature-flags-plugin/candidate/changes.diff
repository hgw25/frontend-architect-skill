+  try {
+    parsed = JSON.parse(contents)
+  } catch {
+    throw configurationError(
+      'Feature flag source is not valid JSON.',
+      'Fix the JSON syntax; the file must contain one object of flag values.',
+      source,
+    )
+  }
+
+  if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    throw configurationError(
+      'Feature flag source must contain a JSON object.',
+      'Replace the top-level value with an object whose keys are flag names.',
+      source,
+    )
+  }
