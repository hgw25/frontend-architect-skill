+const PLUGIN_NAME = 'feature-flags'
+const PUBLIC_MODULE_ID = 'virtual:feature-flags'
+const RESOLVED_MODULE_ID = `\0${PUBLIC_MODULE_ID}`
+
+export type FeatureFlagValue = boolean | number | string
+
+export interface FeatureFlagsOptions {
+  /** A JSON file. Relative paths are resolved from Vite's project root. */
+  source: string | URL
+  /** The complete allowlist of keys that may be emitted into client code. */
+  expose: readonly string[]
+}
+
+interface ValidatedOptions {
+  source: string | URL
+  expose: readonly string[]
+}
+
+function configurationError(message: string, fix: string, source?: string): Error {
+  const location = source ? `\n  Source: ${source}` : ''
+  return new Error(`[${PLUGIN_NAME}] ${message}${location}\n  Fix: ${fix}`)
+}
+
+function validateOptions(options: FeatureFlagsOptions): ValidatedOptions {
+  if (options === null || typeof options !== 'object') {
+    throw configurationError(
+      'Expected an options object.',
+      'Call featureFlags({ source: "flags.json", expose: ["flagName"] }).',
+    )
+  }
+
+  const { source, expose } = options
+  const validSource =
+    (typeof source === 'string' && source.trim().length > 0) || source instanceof URL
+
+  if (!validSource) {
+    throw configurationError(
+      'Option "source" must be a non-empty file path or file URL.',
+      'Point "source" at the JSON file that owns the feature flag values.',
+    )
+  }
+
+  if (!Array.isArray(expose) || expose.length === 0) {
+    throw configurationError(
+      'Option "expose" must be a non-empty array of flag names.',
+      'List every flag that is safe to include in client code.',
+    )
+  }
+
+  const invalidName = expose.find((name) => typeof name !== 'string' || name.length === 0)
+  if (invalidName !== undefined) {
+    throw configurationError(
+      'Every entry in option "expose" must be a non-empty string.',
+      'Remove empty or non-string entries from "expose".',
+    )
+  }
+
+  const duplicate = expose.find((name, index) => expose.indexOf(name) !== index)
+  if (duplicate !== undefined) {
+    throw configurationError(
+      `Option "expose" contains the duplicate flag "${duplicate}".`,
+      'Keep each exposed flag name only once.',
+    )
+  }
