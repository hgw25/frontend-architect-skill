+  const serializedFlags = JSON.stringify(publicFlags)
+  return `export const flags = Object.freeze(JSON.parse(${JSON.stringify(serializedFlags)}));\n`
+}
+
+/**
+ * Publishes an explicit, client-safe subset of a JSON feature flag file through
+ * `virtual:feature-flags`.
+ */
+export function featureFlags(options: FeatureFlagsOptions): Plugin {
+  const validated = validateOptions(options)
