+      stopFallbackWatcher = () => {
+        server.watcher.off('change', markViteEvent)
+        unwatchFile(watchedSourcePath, forwardMissedEvent)
+      }
+    },
+
+    closeBundle() {
+      stopFallbackWatcher?.()
+      stopFallbackWatcher = undefined
+    },
+
+    resolveId(id) {
+      if (id === PUBLIC_MODULE_ID) return RESOLVED_MODULE_ID
+      return null
+    },
+
+    async load(id) {
