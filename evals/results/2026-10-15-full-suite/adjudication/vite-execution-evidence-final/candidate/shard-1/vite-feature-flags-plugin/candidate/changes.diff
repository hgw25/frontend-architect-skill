+  const publicFlags: Record<string, FeatureFlagValue> = Object.create(null)
+  for (const name of expose) {
+    const value = record[name]
+    if (!isFeatureFlagValue(value)) {
+      throw configurationError(
+        `Exposed flag "${name}" must be a string, number, or boolean.`,
+        'Change the value to a supported primitive or remove the flag from "expose".',
+        source,
+      )
+    }
+    publicFlags[name] = value
+  }
