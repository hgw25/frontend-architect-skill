+      }
+
+      const markViteEvent = (file: string) => {
+        if (normalizePath(file) !== normalizedSourcePath) return
+        try {
+          observedVersion = fileVersion(statSync(watchedSourcePath))
+        } catch {
+          observedVersion = undefined
+        }
+      }
+      const forwardMissedEvent = (current: Stats, previous: Stats) => {
+        const currentVersion = fileVersion(current)
+        if (currentVersion === fileVersion(previous) || currentVersion === observedVersion) return
+
+        observedVersion = currentVersion
+        server.watcher.emit('change', watchedSourcePath)
+      }
