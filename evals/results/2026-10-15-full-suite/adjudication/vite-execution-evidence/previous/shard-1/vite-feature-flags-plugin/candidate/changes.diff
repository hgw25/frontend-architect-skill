-import type { Plugin } from 'vite'
+import { watchFile, unwatchFile } from 'node:fs'
+import type { Stats } from 'node:fs'
+import { readFile } from 'node:fs/promises'
+import { isAbsolute, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import type { Plugin, ResolvedConfig } from 'vite'
+import { normalizePath } from 'vite'
+
+const PUBLIC_MODULE_ID = 'virtual:feature-flags'
+const RESOLVED_MODULE_ID = `\0${PUBLIC_MODULE_ID}`
+const PLUGIN_NAME = 'feature-flags'
+
+export type FeatureFlagValue = boolean | number | string
+
+export type FeatureFlags = Readonly<Record<string, FeatureFlagValue>>
+
+export interface FeatureFlagsOptions<Key extends string = string> {
+  /** A JSON file. Relative paths are resolved from Vite's configured root. */
+  readonly source: string | URL
+  /** The complete allowlist of keys that may be included in client output. */
+  readonly expose: readonly Key[]
+}
+
+/**
+ * Exposes an allowlisted projection of a JSON object as `virtual:feature-flags`.
+ *
+ * Values must be JSON strings, finite numbers, or booleans. The generated
+ * object is frozen so its runtime behavior agrees with the readonly type.
+ */
+export function featureFlags<const Key extends string>(
+  options: FeatureFlagsOptions<Key>,
+): Plugin {
+  assertOptions(options)
+
+  let sourceFile: string | undefined
+  let stopPolling: (() => void) | undefined
+
+  const resolveSourceFile = (config?: ResolvedConfig): string => {
+    sourceFile ??= normalizePath(
+      toSourceFile(options.source, config?.root ?? process.cwd()),
+    )
+    return sourceFile
+  }
 
-export function featureFlags(flags: Record<string, unknown>): Plugin {
   return {
-    name: 'feature-flags',
-    transform(code: string) {
-      return code.replaceAll('__FLAGS__', JSON.stringify(flags))
+    name: PLUGIN_NAME,
+
+    async configResolved(config) {
+      await readClientFlags(resolveSourceFile(config), options.expose)
+    },
+
+    configureServer(server) {
+      if (server.config.server.watch === null) return
+
+      const file = resolveSourceFile()
+      const handlePolledChange = (current: Stats, previous: Stats) => {
+        if (
+          current.mtimeMs !== previous.mtimeMs ||
+          current.size !== previous.size
+        ) {
+          server.watcher.emit('change', file)
+        }
+      }
+
+      server.watcher.add(file)
+      watchFile(file, { interval: 250, persistent: false }, handlePolledChange)
+      stopPolling = () => unwatchFile(file, handlePolledChange)
+    },
+
+    resolveId(id) {
+      if (id === PUBLIC_MODULE_ID) return RESOLVED_MODULE_ID
+      return null
+    },
+
+    async load(id) {
+      if (id !== RESOLVED_MODULE_ID) return null
+
+      const file = resolveSourceFile()
+      this.addWatchFile(file)
+
+      const flags = await readClientFlags(file, options.expose)
+      const serializedFlags = JSON.stringify(flags)
+
+      // Parsing a string avoids object-literal edge cases for keys such as
+      // "__proto__". Only the allowlisted projection reaches this source.
+      return {
+        code: [
+          `const flags = Object.freeze(JSON.parse(${JSON.stringify(serializedFlags)}));`,
+          'export { flags };',
+          '',
+        ].join('\n'),
+        map: null,
+      }
+    },
+
+    handleHotUpdate(context) {
+      if (normalizePath(context.file) !== resolveSourceFile()) return
+
+      const module = context.server.moduleGraph.getModuleById(RESOLVED_MODULE_ID)
+      if (!module) return []
+
+      context.server.moduleGraph.invalidateModule(module)
+      return [module]
+    },
+
+    closeBundle() {
+      stopPolling?.()
+      stopPolling = undefined
     },
   }
 }
+
+function assertOptions(
+  options: FeatureFlagsOptions<string>,
+): asserts options is FeatureFlagsOptions<string> {
+  if (typeof options !== 'object' || options === null) {
+    throw configurationError(
+      'INVALID_OPTIONS',
+      'Expected an options object with "source" and "expose" properties.',
+    )
+  }
+
+  if (
+    !(
+      (typeof options.source === 'string' && options.source.length > 0) ||
+      options.source instanceof URL
+    )
+  ) {
+    throw configurationError(
+      'INVALID_SOURCE',
+      'Set "source" to a non-empty path or file: URL for a JSON file.',
+    )
+  }
+
+  if (options.source instanceof URL && options.source.protocol !== 'file:') {
+    throw configurationError(
+      'INVALID_SOURCE_URL',
+      `Use a file: URL for "source"; received protocol "${options.source.protocol}".`,
+    )
+  }
+
+  if (!Array.isArray(options.expose)) {
+    throw configurationError(
+      'INVALID_EXPOSE',
+      'Set "expose" to an array of flag names that are safe for client code.',
+    )
+  }
+
+  const seen = new Set<string>()
+  for (const key of options.expose) {
+    if (typeof key !== 'string' || key.length === 0) {
+      throw configurationError(
+        'INVALID_EXPOSE',
+        'Every "expose" entry must be a non-empty string.',
+      )
+    }
+    if (seen.has(key)) {
+      throw configurationError(
+        'DUPLICATE_EXPOSE',
+        `Remove the duplicate "${key}" entry from "expose".`,
+      )
+    }
+    seen.add(key)
+  }
+}
+
+function toSourceFile(source: string | URL, root: string): string {
+  if (source instanceof URL) {
+    return fileURLToPath(source)
+  }
+
+  return isAbsolute(source) ? source : resolve(root, source)
+}
+
+async function readClientFlags(
+  sourceFile: string,
+  exposedKeys: readonly string[],
+): Promise<FeatureFlags> {
+  let contents: string
+  try {
+    contents = await readFile(sourceFile, 'utf8')
+  } catch (error) {
+    const reason = error instanceof Error ? error.message : String(error)
+    throw configurationError(
+      'SOURCE_READ_FAILED',
+      `Could not read ${sourceFile}. Check that "source" points to an accessible JSON file. ${reason}`,
+    )
+  }
+
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(contents)
+  } catch (error) {
+    const reason = error instanceof Error ? error.message : String(error)
+    throw configurationError(
+      'INVALID_JSON',
+      `Could not parse ${sourceFile} as JSON. Fix the JSON syntax. ${reason}`,
+    )
+  }
+
+  if (!isJsonObject(parsed)) {
+    throw configurationError(
+      'INVALID_FLAGS_OBJECT',
+      `Expected ${sourceFile} to contain one JSON object at the top level.`,
+    )
+  }
+
+  const clientFlags: Record<string, FeatureFlagValue> = Object.create(null) as Record<
+    string,
+    FeatureFlagValue
+  >
+
+  for (const key of exposedKeys) {
+    if (!Object.hasOwn(parsed, key)) {
+      throw configurationError(
+        'MISSING_FLAG',
+        `Flag "${key}" is listed in "expose" but is missing from ${sourceFile}. Add the flag or remove it from "expose".`,
+      )
+    }
+
+    const value = parsed[key]
+    if (!isFeatureFlagValue(value)) {
+      throw configurationError(
+        'INVALID_FLAG_VALUE',
+        `Flag "${key}" in ${sourceFile} must be a string, finite number, or boolean; received ${describeValue(value)}.`,
+      )
+    }
+    clientFlags[key] = value
+  }
+
+  return clientFlags
+}
+
+function isJsonObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function isFeatureFlagValue(value: unknown): value is FeatureFlagValue {
+  return (
+    typeof value === 'string' ||
+    typeof value === 'boolean' ||
+    (typeof value === 'number' && Number.isFinite(value))
+  )
+}
+
+function describeValue(value: unknown): string {
+  if (value === null) return 'null'
+  if (Array.isArray(value)) return 'an array'
+  return typeof value
+}
+
+function configurationError(code: string, message: string): Error {
+  const error = new Error(`[${PLUGIN_NAME}:${code}] ${message}`)
+  error.name = 'FeatureFlagsConfigurationError'
+  return error
+}
