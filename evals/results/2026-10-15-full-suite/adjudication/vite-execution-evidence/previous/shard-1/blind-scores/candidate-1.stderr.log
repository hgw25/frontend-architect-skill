new file mode 100644
index 0000000..8164ed5
--- /dev/null
+++ b/packages/plugin/tests/plugin.test.mjs
@@ -0,0 +1,65 @@
+import assert from 'node:assert/strict'
+import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import test from 'node:test'
+
+import { featureFlags } from '../dist/index.js'
+import { createServer } from 'vite'
+
+test('rejects invalid public options with actionable diagnostics', () => {
+  assert.throws(
+    () => featureFlags({ source: 'flags.json', expose: ['enabled', 'enabled'] }),
+    /DUPLICATE_EXPOSE.*Remove the duplicate "enabled"/,
+  )
+  assert.throws(
+    () => featureFlags({ source: new URL('https://example.com/flags.json'), expose: [] }),
+    /INVALID_SOURCE_URL.*file: URL/,
+  )
+})
+
+test('loads only allowlisted flags and preserves adversarial keys', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'feature-flags-plugin-'))
+  const source = join(root, 'flags.json')
+  const entryDirectory = join(root, 'src')
+  await mkdir(entryDirectory)
+  await writeFile(
+    source,
+    '{"enabled":false,"__proto__":"client-proto","constructor":"client-value","secret":"must-not-be-exposed"}',
+  )
+  await writeFile(
+    join(entryDirectory, 'entry.js'),
+    "export { flags } from 'virtual:feature-flags'\n",
+  )
+
+  const server = await createServer({
+    root,
+    configFile: false,
+    logLevel: 'silent',
+    server: { middlewareMode: true },
+    plugins: [
+      featureFlags({
+        source,
+        expose: ['enabled', '__proto__', 'constructor'],
+      }),
+    ],
+  })
+
+  try {
+    const loaded = await server.ssrLoadModule('/src/entry.js')
+    assert.equal(Object.isFrozen(loaded.flags), true)
+    assert.equal(Object.hasOwn(loaded.flags, '__proto__'), true)
+    assert.equal(loaded.flags.enabled, false)
+    assert.equal(loaded.flags.__proto__, 'client-proto')
+    assert.equal(loaded.flags.constructor, 'client-value')
+    assert.deepEqual(Object.keys(loaded.flags), [
+      'enabled',
+      '__proto__',
+      'constructor',
+    ])
+    assert.doesNotMatch(JSON.stringify(loaded.flags), /must-not-be-exposed/)
+  } finally {
+    await server.close()
+    await rm(root, { recursive: true, force: true })
+  }
+})


