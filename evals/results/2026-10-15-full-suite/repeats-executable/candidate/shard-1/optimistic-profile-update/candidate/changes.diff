+  )
+
+  await user.clear(screen.getByLabelText('Display name'))
+  await user.type(screen.getByLabelText('Display name'), 'Grace')
+  await user.click(screen.getByRole('button', { name: 'Save' }))
+  await user.clear(screen.getByLabelText('Display name'))
+  await user.type(screen.getByLabelText('Display name'), 'Lin')
+  await user.click(screen.getByRole('button', { name: 'Save' }))
+
+  await act(async () => {
+    requests[1]?.(
+      new Response(
+        JSON.stringify({ id: 'p1', displayName: 'Lin', version: 2 }),
+        { status: 200, headers: { 'content-type': 'application/json' } },
+      ),
+    )
+  })
+
+  await act(async () => {
+    requests[0]?.(
+      new Response(
+        JSON.stringify({ id: 'p1', displayName: 'Grace', version: 3 }),
+        { status: 200, headers: { 'content-type': 'application/json' } },
+      ),
+    )
+  })
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin')
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+
+  await user.clear(screen.getByLabelText('Display name'))
+  await user.type(screen.getByLabelText('Display name'), 'Katherine')
+  await user.click(screen.getByRole('button', { name: 'Save' }))
+
+  await act(async () => {
+    requests[2]?.(new Response(null, { status: 503 }))
+  })
+
+  expect(await screen.findByRole('alert')).toHaveTextContent(
+    'Save failed. Please retry.',
+  )
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent(
+    'Grace',
+  )
+})
+
+test('retries the failed submission and keeps later draft edits separate', async () => {
+  const fetchMock = vi
