--- /dev/null
+++ b/scripts/verify-package.mjs
@@ -0,0 +1,18 @@
+const publicModule = await import('../dist/index.js')
+
+const expectedExports = [
+  'Dialog',
+  'DialogClose',
+  'DialogContent',
+  'DialogDescription',
+  'DialogOverlay',
+  'DialogPortal',
+  'DialogRoot',
+  'DialogTitle',
+  'DialogTrigger',
+]
+
+const missingExports = expectedExports.filter((name) => !(name in publicModule))
+if (missingExports.length > 0) {
+  throw new Error(`Missing public runtime exports: ${missingExports.join(', ')}`)
+}
