+    if (initialFocus && content.contains(initialFocus)) initialFocus.focus({ preventScroll: true })
+    else focusFirstElement(content)
+
+    return unregister
+  }, [layerId, open, setOpen])
+
+  useEffect(() => {
+    if (!open || !contentRef.current || import.meta.env.PROD) return
+    const content = contentRef.current
+    const hasName = Boolean(ariaLabel || ariaLabelledBy || content.ownerDocument.getElementById(titleId))
+    if (!hasName) console.warn('Dialog.Content requires Dialog.Title or an accessible aria-label.')
+  }, [ariaLabel, ariaLabelledBy, open, titleId])
+
+  if (!open) return null
+
+  return (
+    <div
+      {...props}
+      aria-describedby={hasExplicitDescription ? ariaDescribedBy : descriptionId}
+      aria-label={ariaLabel}
+      aria-labelledby={ariaLabel ? ariaLabelledBy : (ariaLabelledBy ?? titleId)}
+      aria-modal="true"
+      data-state="open"
+      id={contentId}
+      ref={composedRef}
+      role="dialog"
+      tabIndex={-1}
+      onKeyDown={(event) => {
+        onKeyDown?.(event)
+        if (event.defaultPrevented || event.key !== 'Tab' || !isTopLayer(layerId)) return
+
+        const focusable = getFocusableElements(event.currentTarget)
+        if (focusable.length === 0) {
+          event.preventDefault()
+          event.currentTarget.focus({ preventScroll: true })
+          return
+        }
+
+        const first = focusable[0]
+        const last = focusable[focusable.length - 1]
+        const active = event.currentTarget.ownerDocument.activeElement
+        if (event.shiftKey && (active === first || active === event.currentTarget)) {
+          event.preventDefault()
+          last.focus({ preventScroll: true })
+        } else if (!event.shiftKey && active === last) {
+          event.preventDefault()
+          first.focus({ preventScroll: true })
+        }
+      }}
+    />
+  )
+})
+
+export type DialogTitleProps = Omit<HTMLAttributes<HTMLHeadingElement>, 'id'>
+
+export const DialogTitle = forwardRef<HTMLHeadingElement, DialogTitleProps>(function DialogTitle(
+  props,
+  forwardedRef,
+) {
+  const { titleId } = useDialogContext('Dialog.Title')
+  return <h2 {...props} id={titleId} ref={forwardedRef} />
+})
+
+export type DialogDescriptionProps = Omit<HTMLAttributes<HTMLParagraphElement>, 'id'>
+
+export const DialogDescription = forwardRef<HTMLParagraphElement, DialogDescriptionProps>(
+  function DialogDescription(props, forwardedRef) {
+    const { descriptionId } = useDialogContext('Dialog.Description')
+    return <p {...props} id={descriptionId} ref={forwardedRef} />
+  },
+)
+
+export type DialogCloseProps = ButtonHTMLAttributes<HTMLButtonElement>
+
+export const DialogClose = forwardRef<HTMLButtonElement, DialogCloseProps>(function DialogClose(
+  { onClick, type = 'button', ...props },
+  forwardedRef,
+) {
+  const { setOpen } = useDialogContext('Dialog.Close')
+  return (
+    <button
+      {...props}
+      ref={forwardedRef}
+      type={type}
+      onClick={(event) => {
+        onClick?.(event)
+        if (!event.defaultPrevented) setOpen(false)
+      }}
+    />
+  )
+})
+
+export const Dialog = {
+  Close: DialogClose,
+  Content: DialogContent,
+  Description: DialogDescription,
+  Overlay: DialogOverlay,
+  Portal: DialogPortal,
+  Root: DialogRoot,
+  Title: DialogTitle,
+  Trigger: DialogTrigger,
 }
