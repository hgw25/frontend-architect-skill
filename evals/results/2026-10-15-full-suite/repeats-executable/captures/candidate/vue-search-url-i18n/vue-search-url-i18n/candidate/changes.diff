@@ -0,0 +1,94 @@
+export const supportedLocales = ['en-US', 'fr-FR'] as const
+
+export type SupportedLocale = (typeof supportedLocales)[number]
+
+type Messages = {
+  title: string
+  searchLabel: string
+  searchButton: string
+  localeLabel: string
+  localeNames: Record<SupportedLocale, string>
+  resultCount: Record<'one' | 'other', string>
+  searchFailed: string
+  paginationLabel: string
+  previousPage: string
+  nextPage: string
+  currentPage: string
+}
+
+const messages: Record<SupportedLocale, Messages> = {
+  'en-US': {
+    title: 'Product search',
+    searchLabel: 'Search',
+    searchButton: 'Search',
+    localeLabel: 'Language',
+    localeNames: {
+      'en-US': 'English (United States)',
+      'fr-FR': 'French (France)',
+    },
+    resultCount: {
+      one: '{count} result',
+      other: '{count} results',
+    },
+    searchFailed: 'Search failed. Please try again.',
+    paginationLabel: 'Search results pages',
+    previousPage: 'Previous',
+    nextPage: 'Next',
+    currentPage: 'Page {page}',
+  },
+  'fr-FR': {
+    title: 'Recherche de produits',
+    searchLabel: 'Rechercher',
+    searchButton: 'Rechercher',
+    localeLabel: 'Langue',
+    localeNames: {
+      'en-US': 'Anglais (États-Unis)',
+      'fr-FR': 'Français (France)',
+    },
+    resultCount: {
+      one: '{count} résultat',
+      other: '{count} résultats',
+    },
+    searchFailed: 'La recherche a échoué. Veuillez réessayer.',
+    paginationLabel: 'Pages de résultats de recherche',
+    previousPage: 'Précédente',
+    nextPage: 'Suivante',
+    currentPage: 'Page {page}',
+  },
+}
+
+const currencies: Record<SupportedLocale, string> = {
+  'en-US': 'USD',
+  'fr-FR': 'EUR',
+}
+
+export function resolveLocale(value: string | null): SupportedLocale {
+  return supportedLocales.includes(value as SupportedLocale)
+    ? (value as SupportedLocale)
+    : 'en-US'
+}
+
+export function getMessages(locale: SupportedLocale): Messages {
+  return messages[locale]
+}
+
+export function formatResultCount(count: number, locale: SupportedLocale): string {
+  const pluralCategory = new Intl.PluralRules(locale).select(count)
+  const message = messages[locale].resultCount[pluralCategory === 'one' ? 'one' : 'other']
+
+  return message.replace('{count}', new Intl.NumberFormat(locale).format(count))
+}
+
+export function formatCurrency(value: number, locale: SupportedLocale): string {
+  return new Intl.NumberFormat(locale, {
+    style: 'currency',
+    currency: currencies[locale],
+  }).format(value)
+}
+
+export function formatCurrentPage(page: number, locale: SupportedLocale): string {
+  return messages[locale].currentPage.replace(
+    '{page}',
+    new Intl.NumberFormat(locale).format(page),
+  )
+}
