 /** Submit a schema-driven form. See README.md for the public contract. */
 export async function processForm(fields, values, send) {
-  const errors = {};
-  for (const field of fields.filter(field => !field.disabled)) {
-    if (field.required && !values[field.name]) errors[field.name] = 'Required';
+  const enabledFields = fields.filter(field => !field.disabled);
+  const errorEntries = [];
+
+  for (const field of enabledFields) {
+    const value = getFieldValue(values, field.name);
+    const isEmpty = value === undefined || value === null || value === '';
+
+    if (field.required && isEmpty) {
+      errorEntries.push([field.name, 'Required']);
+      continue;
+    }
+
+    if (field.validate) {
+      const error = await field.validate(value, values);
+      if (error !== undefined) errorEntries.push([field.name, error]);
+    }
   }
-  for (const field of fields.filter(field => field.validate)) {
-    const error = await field.validate(values[field.name], values);
-    if (error) errors[field.name] = 'Invalid';
-  }
-  if (Object.keys(errors).length) return { errors };
-  return send(Object.fromEntries(fields.map(field => [field.name, values[field.name]])));
+
+  if (errorEntries.length) return { errors: Object.fromEntries(errorEntries) };
+
+  const payload = Object.fromEntries(
+    enabledFields.map(field => [field.name, getFieldValue(values, field.name)]),
+  );
+  return send(payload);
+}
+
+function getFieldValue(values, name) {
+  return Object.hasOwn(values, name) ? values[name] : undefined;
 }
