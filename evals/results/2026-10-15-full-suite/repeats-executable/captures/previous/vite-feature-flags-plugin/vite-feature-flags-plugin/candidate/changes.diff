+      // Explicit registration also covers a source outside Vite's project root.
+      server.watcher.add(sourceFile)
+    },
+
+    resolveId(id) {
+      if (id === PUBLIC_MODULE_ID) {
+        return { id: RESOLVED_MODULE_ID, moduleSideEffects: false }
+      }
+    },
+
+    async load(id) {
+      if (id === RESOLVED_MODULE_ID) {
