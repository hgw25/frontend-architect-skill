diff --git a/tests/plugin-lifecycle.test.mjs b/tests/plugin-lifecycle.test.mjs
new file mode 100644
index 0000000..bd8d055
--- /dev/null
+++ b/tests/plugin-lifecycle.test.mjs
@@ -0,0 +1,70 @@
+import assert from 'node:assert/strict'
+import { mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import test from 'node:test'
+
+import { featureFlags } from '../packages/plugin/dist/index.js'
+import { createServer } from 'vite'
+
+test('serves only allowlisted flags and refreshes after virtual-module invalidation', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'feature-flags-lifecycle-'))
+  const source = join(root, 'flags.json')
+  await writeFile(
+    source,
+    JSON.stringify({ checkoutV2: true, SERVER_TOKEN: 'must-not-ship' }),
+  )
+  await writeFile(
+    join(root, 'entry.js'),
+    "export { flags } from 'virtual:feature-flags'",
+  )
+
+  const plugin = featureFlags({ source, expose: ['checkoutV2'] })
+  const server = await createServer({
+    root,
+    configFile: false,
+    logLevel: 'silent',
+    server: { hmr: false, middlewareMode: true },
+    plugins: [plugin],
+  })
+
+  try {
+    const initial = await server.ssrLoadModule('/entry.js')
+    assert.deepEqual(initial.flags, { checkoutV2: true })
+    assert.doesNotMatch(JSON.stringify(initial.flags), /must-not-ship/)
+
+    await writeFile(
+      source,
+      JSON.stringify({ checkoutV2: false, SERVER_TOKEN: 'must-not-ship' }),
+    )
+    plugin.handleHotUpdate({ file: source, modules: [], server })
+
+    const refreshed = await server.ssrLoadModule('/entry.js')
+    assert.deepEqual(refreshed.flags, { checkoutV2: false })
+  } finally {
+    await server.close()
+    await rm(root, { recursive: true, force: true })
+  }
+})
+
+test('generated source maps contain only the allowlisted snapshot', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'feature-flags-map-'))
+  const source = join(root, 'flags.json')
+  await writeFile(
+    source,
+    JSON.stringify({ publicFlag: 'enabled', SERVER_TOKEN: 'must-not-ship' }),
+  )
+
+  const plugin = featureFlags({ source, expose: ['publicFlag'] })
+  try {
+    const resolved = plugin.resolveId('virtual:feature-flags')
+    assert.equal(typeof resolved, 'object')
+    const loaded = await plugin.load(resolved.id)
+    const artifact = JSON.stringify(loaded)
+
+    assert.match(artifact, /publicFlag/)
+    assert.doesNotMatch(artifact, /must-not-ship/)
+  } finally {
+    await rm(root, { recursive: true, force: true })
+  }
+})
