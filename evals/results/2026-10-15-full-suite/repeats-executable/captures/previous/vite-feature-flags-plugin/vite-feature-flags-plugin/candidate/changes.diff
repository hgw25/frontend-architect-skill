+      context.server.moduleGraph.invalidateModule(virtualModule)
+      return [...new Set([...context.modules, virtualModule])]
     },
   }
 }
+
+function validateOptions(options: FeatureFlagsOptions): {
+  source: string | URL
+  expose: readonly string[]
+} {
+  if (typeof options !== 'object' || options === null) {
+    throw configurationError(
+      'Expected an options object with "source" and "expose" fields.',
+    )
+  }
+
+  const { source, expose } = options
+  if (
+    !(
+      (typeof source === 'string' && source.trim().length > 0) ||
+      source instanceof URL
+    )
+  ) {
+    throw configurationError(
+      'Option "source" must be a non-empty file path or a file: URL.',
+    )
+  }
+
+  if (!Array.isArray(expose)) {
+    throw configurationError(
+      'Option "expose" must be an array of feature flag names.',
+    )
+  }
+
+  const exposedNames = expose.map((name, index) => {
+    if (typeof name !== 'string' || name.length === 0) {
+      throw configurationError(
+        `Option "expose" contains an invalid name at index ${index}; use a non-empty string.`,
+      )
+    }
+    return name
+  })
+
+  const duplicate = exposedNames.find(
+    (name, index) => exposedNames.indexOf(name) !== index,
+  )
+  if (duplicate !== undefined) {
+    throw configurationError(
+      `Option "expose" contains duplicate flag "${duplicate}"; list each flag once.`,
+    )
+  }
+
+  return { source, expose: Object.freeze(exposedNames) }
+}
+
+function resolveSource(source: string | URL, root: string): string {
+  if (source instanceof URL) {
+    if (source.protocol !== 'file:') {
+      throw configurationError(
+        `Option "source" must use the file: protocol; received "${source.protocol}".`,
+      )
+    }
+    return fileURLToPath(source)
+  }
+
+  return isAbsolute(source) ? source : resolve(root, source)
+}
+
+async function readAndGenerateModule(
+  sourceFile: string,
+  exposedNames: readonly string[],
+): Promise<GeneratedModule> {
+  let contents: string
+  try {
+    contents = await readFile(sourceFile, 'utf8')
+  } catch (error) {
+    const reason = error instanceof Error ? error.message : String(error)
+    throw configurationError(
+      `Could not read "${sourceFile}" from option "source": ${reason}. Check that the file exists and is readable.`,
+    )
+  }
+
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(contents)
+  } catch (error) {
+    const reason = error instanceof Error ? error.message : String(error)
+    throw configurationError(
+      `Invalid JSON in "${sourceFile}": ${reason}. Fix the file syntax and try again.`,
+    )
+  }
+
+  if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
+    throw configurationError(
+      `Expected "${sourceFile}" to contain a JSON object keyed by flag name.`,
+    )
+  }
+
+  const sourceFlags = parsed as Record<string, unknown>
+  const exposedFlags: Record<string, FeatureFlagValue> = Object.create(null)
+
+  for (const name of exposedNames) {
+    if (!Object.hasOwn(sourceFlags, name)) {
+      throw configurationError(
+        `Option "expose" references missing flag "${name}" in "${sourceFile}". Add the flag to the file or remove it from "expose".`,
+      )
+    }
+
+    const value = sourceFlags[name]
+    if (!isFeatureFlagValue(value)) {
+      throw configurationError(
+        `Flag "${name}" in "${sourceFile}" must be a boolean, finite number, or string; received ${describeValue(value)}.`,
+      )
+    }
+    exposedFlags[name] = value
+  }
+
+  const serializedFlags = JSON.stringify(exposedFlags)
+  const code = [
+    `const value = JSON.parse(${JSON.stringify(serializedFlags)});`,
+    'export const flags = Object.freeze(value);',
+  ].join('\n')
+
+  return {
+    code,
+    map: {
+      version: 3,
+      file: PUBLIC_MODULE_ID,
+      sources: [PUBLIC_MODULE_ID],
+      sourcesContent: [code],
+      names: [],
+      mappings: 'AAAA;AACA',
+    },
+  }
+}
+
+function isFeatureFlagValue(value: unknown): value is FeatureFlagValue {
+  return (
+    typeof value === 'boolean' ||
+    typeof value === 'string' ||
+    (typeof value === 'number' && Number.isFinite(value))
+  )
+}
+
+function describeValue(value: unknown): string {
+  if (value === null) return 'null'
+  if (Array.isArray(value)) return 'an array'
+  return typeof value === 'object' ? 'an object' : typeof value
+}
+
+function configurationError(message: string): Error {
+  return new Error(`[feature-flags] ${message}`)
+}
