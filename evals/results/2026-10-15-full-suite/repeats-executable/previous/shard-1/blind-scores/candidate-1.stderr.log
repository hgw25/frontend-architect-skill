+
+  for (const name of exposedNames) {
+    if (!Object.hasOwn(sourceFlags, name)) {
+      throw configurationError(
+        `Option "expose" references missing flag "${name}" in "${sourceFile}". Add the flag to the file or remove it from "expose".`,
+      )
+    }
+
+    const value = sourceFlags[name]
+    if (!isFeatureFlagValue(value)) {
+      throw configurationError(
+        `Flag "${name}" in "${sourceFile}" must be a boolean, finite number, or string; received ${describeValue(value)}.`,
+      )
+    }
+    exposedFlags[name] = value
+  }
+
+  const serializedFlags = JSON.stringify(exposedFlags)
+  const code = [
+    `const value = JSON.parse(${JSON.stringify(serializedFlags)});`,
+    'export const flags = Object.freeze(value);',
+  ].join('\n')
+
+  return {
+    code,
+    map: {
+      version: 3,
+      file: PUBLIC_MODULE_ID,
+      sources: [PUBLIC_MODULE_ID],
+      sourcesContent: [code],
+      names: [],
+      mappings: 'AAAA;AACA',
+    },
+  }
+}
+
+function isFeatureFlagValue(value: unknown): value is FeatureFlagValue {
+  return (
+    typeof value === 'boolean' ||
+    typeof value === 'string' ||
+    (typeof value === 'number' && Number.isFinite(value))
+  )
+}
+
+function describeValue(value: unknown): string {
+  if (value === null) return 'null'
+  if (Array.isArray(value)) return 'an array'
+  return typeof value === 'object' ? 'an object' : typeof value
+}
+
+function configurationError(message: string): Error {
+  return new Error(`[feature-flags] ${message}`)
+}
