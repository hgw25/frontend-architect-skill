diff --git a/src/dialog/focus-management.ts b/src/dialog/focus-management.ts
new file mode 100644
index 0000000..6fddfce
--- /dev/null
+++ b/src/dialog/focus-management.ts
@@ -0,0 +1,238 @@
+type DialogLayer = {
+  content: HTMLElement
+  initialFocus: HTMLElement | null
+  onDismiss: () => void
+  onEscapeKeyDown?: (event: KeyboardEvent) => void
+  restoreFocus: HTMLElement | null
+}
+
+type SiblingSnapshot = {
+  ariaHidden: string | null
+  element: HTMLElement
+  inert: boolean
+}
+
+type DocumentState = {
+  bodyOverflow: string
+  document: Document
+  layers: DialogLayer[]
+  lastFocused: HTMLElement | null
+  pendingRestore: Array<HTMLElement | null>
+  restoreScheduled: boolean
+  siblingSnapshots: SiblingSnapshot[]
+}
+
+const states = new WeakMap<Document, DocumentState>()
+
+const tabbableSelector = [
+  'a[href]',
+  'area[href]',
+  'button:not([disabled])',
+  'input:not([disabled]):not([type="hidden"])',
+  'select:not([disabled])',
+  'textarea:not([disabled])',
+  'iframe',
+  'audio[controls]',
+  'video[controls]',
+  '[contenteditable="true"]',
+  '[tabindex]:not([tabindex="-1"])',
+].join(',')
+
+function isVisible(element: HTMLElement) {
+  const style = element.ownerDocument.defaultView?.getComputedStyle(element)
+
+  return (
+    element.getClientRects().length > 0 &&
+    style?.visibility !== 'hidden' &&
+    style?.display !== 'none'
+  )
+}
+
+function getTabbableElements(container: HTMLElement) {
+  return Array.from(container.querySelectorAll<HTMLElement>(tabbableSelector)).filter(
+    (element) => element.tabIndex >= 0 && isVisible(element),
+  )
+}
+
+function focusWithoutScrolling(element: HTMLElement) {
+  element.focus({ preventScroll: true })
+}
+
+function getTopLayer(state: DocumentState | undefined) {
+  return state?.layers.at(-1)
+}
+
+function restoreSiblings(state: DocumentState) {
+  for (const snapshot of state.siblingSnapshots) {
+    snapshot.element.inert = snapshot.inert
+    if (snapshot.ariaHidden === null) {
+      snapshot.element.removeAttribute('aria-hidden')
+    } else {
+      snapshot.element.setAttribute('aria-hidden', snapshot.ariaHidden)
+    }
+  }
+  state.siblingSnapshots = []
+}
+
+function syncModalEnvironment(state: DocumentState) {
+  restoreSiblings(state)
+
+  const topLayer = getTopLayer(state)
+  if (!topLayer) {
+    state.document.body.style.overflow = state.bodyOverflow
+    return
+  }
+
+  state.document.body.style.overflow = 'hidden'
+  const portalHost = topLayer.content.closest<HTMLElement>('[data-dialog-portal]')
+  const boundary = portalHost?.parentElement
+
+  if (!portalHost || !boundary) return
+
+  for (const sibling of Array.from(boundary.children)) {
+    if (!(sibling instanceof HTMLElement) || sibling === portalHost) continue
+
+    state.siblingSnapshots.push({
+      ariaHidden: sibling.getAttribute('aria-hidden'),
+      element: sibling,
+      inert: sibling.inert,
+    })
+    sibling.inert = true
+    sibling.setAttribute('aria-hidden', 'true')
+  }
+}
+
+function focusInside(layer: DialogLayer, preferred?: HTMLElement | null) {
+  if (preferred?.isConnected && layer.content.contains(preferred)) {
+    focusWithoutScrolling(preferred)
+    return
+  }
+
+  const firstTabbable = getTabbableElements(layer.content)[0]
+  focusWithoutScrolling(firstTabbable ?? layer.content)
+}
+
+function handleKeyDown(state: DocumentState, event: KeyboardEvent) {
+  const topLayer = getTopLayer(state)
+  if (!topLayer) return
+
+  if (event.key === 'Escape') {
+    topLayer.onEscapeKeyDown?.(event)
+    if (event.defaultPrevented) return
+
+    event.preventDefault()
+    topLayer.onDismiss()
+    return
+  }
+
+  if (event.key !== 'Tab') return
+
+  const tabbable = getTabbableElements(topLayer.content)
+  if (tabbable.length === 0) {
+    event.preventDefault()
+    focusWithoutScrolling(topLayer.content)
+    return
+  }
+
+  const activeElement = state.document.activeElement
+  const first = tabbable[0]
+  const last = tabbable[tabbable.length - 1]
+  const focusIsInside = topLayer.content.contains(activeElement)
+  const activeTabbableIndex = tabbable.indexOf(activeElement as HTMLElement)
+
+  if (event.shiftKey && (!focusIsInside || activeTabbableIndex <= 0)) {
+    event.preventDefault()
+    focusWithoutScrolling(last)
+  } else if (
+    !event.shiftKey &&
+    (!focusIsInside || activeTabbableIndex === -1 || activeElement === last)
+  ) {
+    event.preventDefault()
+    focusWithoutScrolling(first)
+  }
+}
+
+function handleFocusIn(state: DocumentState, event: FocusEvent) {
+  const topLayer = getTopLayer(state)
+  const target = event.target
+  if (!topLayer || !(target instanceof HTMLElement)) return
+
+  if (topLayer.content.contains(target)) {
+    state.lastFocused = target
+    return
+  }
+
+  focusInside(topLayer, state.lastFocused)
+}
+
+function createDocumentState(document: Document): DocumentState {
+  const state: DocumentState = {
+    bodyOverflow: document.body.style.overflow,
+    document,
+    lastFocused: null,
+    layers: [],
+    pendingRestore: [],
+    restoreScheduled: false,
+    siblingSnapshots: [],
+  }
+
+  document.addEventListener('keydown', (event) => handleKeyDown(state, event))
+  document.addEventListener('focusin', (event) => handleFocusIn(state, event))
+  states.set(document, state)
+  return state
+}
+
+function scheduleFocusRestoration(state: DocumentState) {
+  if (state.restoreScheduled) return
+  state.restoreScheduled = true
+
+  queueMicrotask(() => {
+    state.restoreScheduled = false
+    const topLayer = getTopLayer(state)
+    const candidate = state.pendingRestore
+      .splice(0)
+      .reverse()
+      .find(
+        (element): element is HTMLElement =>
+          element !== null &&
+          element.isConnected &&
+          (!topLayer || topLayer.content.contains(element)),
+      )
+
+    if (candidate) {
+      focusWithoutScrolling(candidate)
+    } else if (topLayer && !topLayer.content.contains(state.document.activeElement)) {
+      focusInside(topLayer)
+    }
+  })
+}
+
+export function activateDialogLayer(layer: DialogLayer) {
+  const document = layer.content.ownerDocument
+  const state = states.get(document) ?? createDocumentState(document)
+
+  if (state.layers.length === 0) {
+    state.bodyOverflow = document.body.style.overflow
+  }
+  state.layers.push(layer)
+  state.lastFocused = null
+  syncModalEnvironment(state)
+  focusInside(layer, layer.initialFocus)
+
+  return () => {
+    const index = state.layers.indexOf(layer)
+    if (index === -1) return
+
+    state.layers.splice(index, 1)
+    state.pendingRestore.push(layer.restoreFocus)
+    state.lastFocused = null
+    syncModalEnvironment(state)
+    scheduleFocusRestoration(state)
+  }
+}
+
+export function isTopDialogLayer(content: HTMLElement | null) {
+  if (!content) return false
+  const state = states.get(content.ownerDocument)
+  return getTopLayer(state)?.content === content
+}
