+
+function parseSearchState(url: URL): SearchState {
+  const pageValue = Number(url.searchParams.get('page'))
+  const localeValue = url.searchParams.get('locale')
+
+  return {
+    query: url.searchParams.get('q') ?? '',
+    page: Number.isSafeInteger(pageValue) && pageValue > 0 ? pageValue : 1,
+    locale: isLocale(localeValue) ? localeValue : 'en-US',
+  }
+}
+
+function serializeSearchState(state: SearchState): string {
+  const params = new URLSearchParams({
+    q: state.query,
+    page: String(state.page),
+    locale: state.locale,
+  })
+  return `${window.location.pathname}?${params.toString()}${window.location.hash}`
+}
+
+function isSearchResult(value: unknown): value is SearchResult {
+  if (!value || typeof value !== 'object') return false
+
+  const result = value as Partial<SearchResult>
+  return (
+    typeof result.id === 'string' &&
+    typeof result.name === 'string' &&
+    typeof result.price === 'number' &&
+    Number.isFinite(result.price)
+  )
