+function applyNavigation(next: SearchState, load: boolean) {
+  state.value = next
+  draftQuery.value = next.query
+  setDocumentLanguage(next.locale)
+  if (load) void loadResults(next)
+}
+
+function pushNavigation(next: SearchState, load: boolean) {
+  window.history.pushState(null, '', serializeSearchState(next))
+  applyNavigation(next, load)
+}
+
+function submitSearch() {
+  pushNavigation(
+    { query: draftQuery.value, page: 1, locale: state.value.locale },
+    true,
+  )
+}
+
+function goToPage(page: number) {
+  if (page < 1 || page === state.value.page) return
+  pushNavigation({ ...state.value, page }, true)
+}
+
+function changeLocale(event: Event) {
+  const locale = (event.target as HTMLSelectElement).value
+  if (!isLocale(locale) || locale === state.value.locale) return
+  pushNavigation({ ...state.value, locale }, false)
+}
+
+function restoreFromHistory() {
+  const next = parseSearchState(new URL(window.location.href))
+  const searchChanged =
+    next.query !== state.value.query || next.page !== state.value.page
+  applyNavigation(next, searchChanged)
+}
+
+onMounted(() => {
+  setDocumentLanguage(state.value.locale)
+  window.addEventListener('popstate', restoreFromHistory)
+  void loadResults(state.value)
+})
+
+onBeforeUnmount(() => {
