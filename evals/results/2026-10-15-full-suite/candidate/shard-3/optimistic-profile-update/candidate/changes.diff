-import { type FormEvent, useState } from 'react'
+import { type FormEvent, useReducer, useRef, useState } from 'react'
 
 import { type Profile, updateProfile } from './api'
 
+type PendingSave = {
+  requestId: number
+  displayName: string
+}
+
+type SaveState = {
+  confirmedProfile: Profile
+  pendingSave: PendingSave | null
+  failedDisplayName: string | null
+  latestSuccessfulRequestId: number
+}
+
+type SaveAction =
+  | { type: 'submitted'; save: PendingSave }
+  | { type: 'succeeded'; requestId: number; profile: Profile }
+  | { type: 'failed'; save: PendingSave }
+
+function saveReducer(state: SaveState, action: SaveAction): SaveState {
+  if (action.type === 'submitted') {
+    return {
+      ...state,
+      pendingSave: action.save,
+      failedDisplayName: null,
+    }
+  }
+
+  if (action.type === 'succeeded') {
+    if (action.requestId < state.latestSuccessfulRequestId) return state
+
+    const confirmedProfile =
+      action.profile.version >= state.confirmedProfile.version
+        ? action.profile
+        : state.confirmedProfile
+
+    return {
+      ...state,
+      confirmedProfile,
+      pendingSave:
+        state.pendingSave?.requestId === action.requestId
+          ? null
+          : state.pendingSave,
+      latestSuccessfulRequestId: action.requestId,
+    }
+  }
+
+  if (state.pendingSave?.requestId !== action.save.requestId) return state
+
+  return {
+    ...state,
+    pendingSave: null,
+    failedDisplayName: action.save.displayName,
+  }
+}
