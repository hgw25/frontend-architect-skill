+    requests[1]?.(
+      new Response(
+        JSON.stringify({ id: 'p1', displayName: 'Lin', version: 3 }),
+        { status: 200, headers: { 'content-type': 'application/json' } },
+      ),
+    )
+  })
+  await act(async () => {
+    requests[0]?.(
+      new Response(
+        JSON.stringify({ id: 'p1', displayName: 'Grace', version: 2 }),
+        { status: 200, headers: { 'content-type': 'application/json' } },
+      ),
