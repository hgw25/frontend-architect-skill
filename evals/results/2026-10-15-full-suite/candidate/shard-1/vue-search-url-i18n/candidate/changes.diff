@@ -0,0 +1,89 @@
+export const supportedLocales = ['en-US', 'fr-FR'] as const
+
+export type SupportedLocale = (typeof supportedLocales)[number]
+
+type MessageCatalog = {
+  title: string
+  searchLabel: string
+  searchAction: string
+  localeLabel: string
+  searchFailed: string
+  loading: string
+  pagination: string
+  previousPage: string
+  nextPage: string
+  page: string
+  resultCount: {
+    one: string
+    other: string
+  }
+  currency: string
+}
+
+const catalogs: Record<SupportedLocale, MessageCatalog> = {
+  'en-US': {
+    title: 'Product search',
+    searchLabel: 'Search',
+    searchAction: 'Search',
+    localeLabel: 'Language',
+    searchFailed: 'Search failed',
+    loading: 'Loading results',
+    pagination: 'Search result pages',
+    previousPage: 'Previous',
+    nextPage: 'Next',
+    page: 'Page {page}',
+    resultCount: {
+      one: '{count} result',
+      other: '{count} results',
+    },
+    currency: 'USD',
+  },
+  'fr-FR': {
+    title: 'Recherche de produits',
+    searchLabel: 'Rechercher',
+    searchAction: 'Rechercher',
+    localeLabel: 'Langue',
+    searchFailed: 'La recherche a échoué',
+    loading: 'Chargement des résultats',
+    pagination: 'Pages de résultats de recherche',
+    previousPage: 'Précédent',
+    nextPage: 'Suivant',
+    page: 'Page {page}',
+    resultCount: {
+      one: '{count} résultat',
+      other: '{count} résultats',
+    },
+    currency: 'EUR',
+  },
+}
+
+export function isSupportedLocale(value: string | null): value is SupportedLocale {
+  return value !== null && supportedLocales.some((locale) => locale === value)
+}
+
+export function createI18n(locale: SupportedLocale) {
+  const messages = catalogs[locale]
+  const pluralRules = new Intl.PluralRules(locale)
+  const numberFormatter = new Intl.NumberFormat(locale)
+  const currencyFormatter = new Intl.NumberFormat(locale, {
+    style: 'currency',
+    currency: messages.currency,
+  })
+
+  return {
+    messages,
+    formatResultCount(count: number) {
+      const plural = pluralRules.select(count) === 'one' ? 'one' : 'other'
+      return messages.resultCount[plural].replace(
+        '{count}',
+        numberFormatter.format(count),
+      )
+    },
+    formatPage(page: number) {
+      return messages.page.replace('{page}', numberFormatter.format(page))
+    },
+    formatPrice(price: number) {
+      return currencyFormatter.format(price)
+    },
+  }
+}
