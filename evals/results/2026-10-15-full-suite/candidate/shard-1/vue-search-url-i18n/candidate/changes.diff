+
+test('keeps stale failures and cleanup from replacing the current request state', async () => {
+  const first = deferredResponse()
+  const second = deferredResponse()
+  vi.stubGlobal('fetch', vi.fn().mockReturnValueOnce(first.promise).mockReturnValueOnce(second.promise))
+
+  const wrapper = mount(SearchPage)
+  await wrapper.get('input[name="query"]').setValue('new')
+  await wrapper.get('form').trigger('submit')
+
+  second.resolve(response('Newest'))
+  await flushPromises()
+  first.resolve(new Response(null, { status: 500 }))
+  await flushPromises()
+
+  expect(wrapper.find('[role="alert"]').exists()).toBe(false)
+  expect(wrapper.get('section').attributes('aria-busy')).toBe('false')
+  expect(wrapper.text()).toContain('Newest')
+})
+
+test('localizes singular messages and writes locale changes to the URL', async () => {
+  history.replaceState(null, '', '/search?q=tea&page=1&locale=en-US')
+  vi.stubGlobal('fetch', vi.fn(() => Promise.resolve(response('Tea', 1, 1.5))))
+  const wrapper = mount(SearchPage)
+  await flushPromises()
+
+  expect(wrapper.get('main').attributes('lang')).toBe('en-US')
+  expect(document.documentElement.lang).toBe('en-US')
+  expect(wrapper.text()).toContain('1 result')
+  expect(wrapper.text()).toContain('$1.50')
+
+  await wrapper.get('select[name="locale"]').setValue('fr-FR')
+
+  expect(location.search).toContain('locale=fr-FR')
+  expect(wrapper.get('main').attributes('lang')).toBe('fr-FR')
+  expect(document.documentElement.lang).toBe('fr-FR')
+  expect(wrapper.text()).toContain('1 résultat')
+  expect(wrapper.text()).toContain('1,50 €')
+})
