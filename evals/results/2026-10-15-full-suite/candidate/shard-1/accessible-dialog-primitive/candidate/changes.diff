--- /dev/null
+++ b/src/dialog-focus.ts
@@ -0,0 +1,73 @@
+import type { KeyboardEvent as ReactKeyboardEvent } from 'react'
+
+const TABBABLE_SELECTOR = [
+  'a[href]',
+  'area[href]',
+  'button:not([disabled])',
+  'input:not([disabled]):not([type="hidden"])',
+  'select:not([disabled])',
+  'textarea:not([disabled])',
+  'iframe',
+  'audio[controls]',
+  'video[controls]',
+  '[contenteditable]:not([contenteditable="false"])',
+  '[tabindex]:not([tabindex="-1"])',
+].join(',')
+
+function isTabbable(element: HTMLElement) {
+  const style = window.getComputedStyle(element)
+
+  return (
+    !element.hidden &&
+    style.display !== 'none' &&
+    style.visibility !== 'hidden' &&
+    element.getClientRects().length > 0 &&
+    element.tabIndex >= 0
+  )
+}
+
+export function getTabbableElements(container: HTMLElement) {
+  return Array.from(container.querySelectorAll<HTMLElement>(TABBABLE_SELECTOR)).filter(
+    isTabbable,
+  )
+}
+
+export function focusInitialElement(
+  container: HTMLElement,
+  requestedElement?: HTMLElement | null,
+) {
+  const candidate =
+    (requestedElement && container.contains(requestedElement) ? requestedElement : null) ??
+    container.querySelector<HTMLElement>('[autofocus]') ??
+    getTabbableElements(container)[0] ??
+    container
+
+  candidate.focus({ preventScroll: true })
+  return candidate
+}
+
+export function keepTabFocusInside(
+  event: ReactKeyboardEvent,
+  container: HTMLElement,
+) {
+  if (event.key !== 'Tab') return
+
+  const tabbableElements = getTabbableElements(container)
+  if (tabbableElements.length === 0) {
+    event.preventDefault()
+    container.focus({ preventScroll: true })
+    return
+  }
+
+  const first = tabbableElements[0]
+  const last = tabbableElements[tabbableElements.length - 1]
+  const activeElement = document.activeElement
+
+  if (event.shiftKey && (activeElement === first || activeElement === container)) {
+    event.preventDefault()
+    last.focus({ preventScroll: true })
+  } else if (!event.shiftKey && activeElement === last) {
+    event.preventDefault()
+    first.focus({ preventScroll: true })
+  }
+}
diff --git a/src/dialog-layer.ts b/src/dialog-layer.ts
new file mode 100644
index 0000000..4f54a46
--- /dev/null
+++ b/src/dialog-layer.ts
@@ -0,0 +1,71 @@
+type Layer = {
+  element: HTMLElement
+}
+
+type IsolatedElement = {
+  ariaHidden: string | null
+  element: HTMLElement
+  inert: boolean
+}
+
+const layers: Layer[] = []
+let isolatedElements: IsolatedElement[] = []
+
+function restoreIsolation() {
+  for (const { ariaHidden, element, inert } of isolatedElements) {
+    element.inert = inert
+    if (ariaHidden === null) element.removeAttribute('aria-hidden')
+    else element.setAttribute('aria-hidden', ariaHidden)
+  }
+
+  isolatedElements = []
+}
+
+function isolateElement(element: HTMLElement) {
+  isolatedElements.push({
+    ariaHidden: element.getAttribute('aria-hidden'),
+    element,
+    inert: element.inert,
+  })
+  element.inert = true
+  element.setAttribute('aria-hidden', 'true')
+}
+
+function isolateOutsideOf(element: HTMLElement) {
+  let branch: HTMLElement | null = element
+
+  while (branch?.parentElement) {
+    const parent: HTMLElement = branch.parentElement
+    for (const sibling of parent.children) {
+      if (sibling !== branch && sibling instanceof HTMLElement) isolateElement(sibling)
+    }
+
+    if (parent === document.body) break
+    branch = parent
+  }
+}
+
+export function refreshLayerIsolation() {
+  restoreIsolation()
+
+  const topLayer = layers.at(-1)
+  if (topLayer?.element.isConnected) isolateOutsideOf(topLayer.element)
+}
+
+export function addDialogLayer(element: HTMLElement) {
+  layers.push({ element })
+}
+
+export function removeDialogLayer(element: HTMLElement) {
+  const index = layers.findIndex((layer) => layer.element === element)
+  if (index !== -1) layers.splice(index, 1)
+  refreshLayerIsolation()
+}
+
+export function isTopDialogLayer(element: HTMLElement | null) {
+  return Boolean(element && layers.at(-1)?.element === element)
+}
+
+export function getTopDialogLayer() {
+  return layers.at(-1)?.element ?? null
+}
