@@ -0,0 +1,94 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createSearch } from './src/search.js';
+
+function deferred() {
+  let resolve;
+  let reject;
+  const promise = new Promise((accept, fail) => { resolve = accept; reject = fail; });
+  return { promise, resolve, reject };
+}
+
+test('a blank submit does not supersede a pending request', async () => {
+  const pending = deferred();
+  const queries = [];
+  const search = createSearch(query => { queries.push(query); return pending.promise; });
+  search.setDraft(' Ada ');
+  const submission = search.submit();
+  search.setDraft(' \n\t ');
+  const beforeBlank = search.getState();
+  await search.submit();
+  assert.deepEqual(queries, ['Ada']);
+  assert.deepEqual(search.getState(), beforeBlank);
+
+  pending.resolve([{ user_id: '1', display_name: 'Ada' }]);
+  await submission;
+  assert.deepEqual(search.getState(), {
+    draft: ' \n\t ', submitted: 'Ada', status: 'success',
+    items: [{ id: '1', label: 'Ada' }], error: null,
+  });
+});
+
+test('retry can supersede a pending attempt without submitting draft edits', async () => {
+  const requests = [];
+  const search = createSearch(query => {
+    const request = { query, ...deferred() };
+    requests.push(request);
+    return request.promise;
+  });
+  search.setDraft('Ada');
+  const first = search.submit();
+  search.setDraft('Bob');
+  const retry = search.retry();
+  assert.deepEqual(requests.map(request => request.query), ['Ada', 'Ada']);
+
+  requests[1].reject(Error('retry offline'));
+  await retry;
+  const failed = search.getState();
+  assert.equal(failed.draft, 'Bob');
+  assert.equal(failed.submitted, 'Ada');
+  assert.equal(failed.status, 'error');
+  assert.equal(failed.error, 'retry offline');
+  requests[0].resolve([{ user_id: 'old', display_name: 'Obsolete' }]);
+  await first;
+  assert.deepEqual(search.getState(), failed);
+});
+
+test('synchronous failures and primitive rejections settle as public error state', async () => {
+  const cases = [
+    { failure: Error('offline'), expected: 'offline' },
+    { failure: null, expected: 'null' },
+    { failure: undefined, expected: 'undefined' },
+    { failure: 0, expected: '0' },
+  ];
+  for (const { failure, expected } of cases) {
+    for (const synchronous of [true, false]) {
+      const search = createSearch(() => {
+        if (synchronous) throw failure;
+        return Promise.reject(failure);
+      });
+      search.setDraft('query');
+      await assert.doesNotReject(search.submit());
+      assert.deepEqual(search.getState(), {
+        draft: 'query', submitted: 'query', status: 'error', items: [], error: expected,
+      });
+    }
+  }
+});
+
+test('disposal of an idle instance prevents its first request and freezes snapshots', async () => {
+  let calls = 0;
+  const search = createSearch(() => { calls += 1; return Promise.resolve([]); });
+  search.setDraft('unsubmitted');
+  const frozen = search.getState();
+  search.dispose();
+  search.dispose();
+  search.setDraft('changed');
+  await search.submit();
+  await search.retry();
+  const snapshot = search.getState();
+  snapshot.draft = 'mutated';
+  snapshot.items.push({ id: 'x', label: 'Injected' });
+  assert.equal(calls, 0);
+  assert.deepEqual(search.getState(), frozen);
+});
