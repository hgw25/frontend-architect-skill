+// @vitest-environment jsdom
+
+import '@testing-library/jest-dom/vitest'
+import { act, cleanup, render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { afterEach, expect, test, vi } from 'vitest'
+
+import { ProfileForm } from './ProfileForm'
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+})
+
+function profileResponse(displayName: string, version = 2) {
+  return new Response(JSON.stringify({ id: 'p1', displayName, version }), {
+    status: 200,
+    headers: { 'content-type': 'application/json' },
+  })
+}
+
+function deferredRequests() {
+  const requests: Array<{
+    resolve: (response: Response) => void
+    reject: (error: Error) => void
+  }> = []
+  const fetch = vi.fn(
+    () =>
+      new Promise<Response>((resolve, reject) => {
+        requests.push({ resolve, reject })
+      }),
+  )
+  vi.stubGlobal('fetch', fetch)
+  return { requests, fetch }
+}
+
+function renderProfile() {
+  render(<ProfileForm profile={{ id: 'p1', displayName: 'Ada', version: 1 }} />)
+  const user = userEvent.setup()
+  const input = screen.getByLabelText('Display name')
+  return {
+    user,
+    input,
+    async submit(name: string) {
+      await user.clear(input)
+      await user.type(input, name)
+      await user.click(screen.getByRole('button', { name: 'Save' }))
+    },
+  }
+}
+
+test('editing alone does not publish or save; success displays the returned name and preserves a newer draft', async () => {
+  const { requests, fetch } = deferredRequests()
+  const { user, input, submit } = renderProfile()
+
+  await user.clear(input)
+  await user.type(input, 'Grace')
+  expect(fetch).not.toHaveBeenCalled()
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Ada')
+
+  await submit('Grace')
+  expect(fetch).toHaveBeenCalledWith('/api/profile', {
+    method: 'PATCH',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ displayName: 'Grace' }),
+  })
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Grace')
+  await user.clear(input)
+  await user.type(input, 'Lin')
+  await act(async () => requests[0].resolve(profileResponse('Grace Hopper')))
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Grace Hopper')
+  expect(input).toHaveValue('Lin')
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+})
+
+test.each([
+  ['HTTP rejection with an otherwise valid body', () => new Response(JSON.stringify({ id: 'p1', displayName: 'Grace', version: 2 }), { status: 503 })],
+  ['invalid JSON', () => new Response('{invalid', { status: 200 })],
+  ['null body', () => new Response('null', { status: 200 })],
+  ['missing id', () => new Response(JSON.stringify({ displayName: 'Grace', version: 2 }), { status: 200 })],
+  ['invalid name', () => new Response(JSON.stringify({ id: 'p1', displayName: 42, version: 2 }), { status: 200 })],
+  ['invalid version', () => new Response(JSON.stringify({ id: 'p1', displayName: 'Grace', version: '2' }), { status: 200 })],
+] as const)('recovers from %s and retries the retained draft', async (_case, failureResponse) => {
+  const fetch = vi.fn()
+    .mockResolvedValueOnce(failureResponse())
+    .mockResolvedValueOnce(profileResponse('Grace'))
+  vi.stubGlobal('fetch', fetch)
+  const { input, submit, user } = renderProfile()
+
+  await submit('Grace')
+  expect(await screen.findByRole('alert')).toHaveTextContent('Save failed. Please retry.')
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Ada')
+  expect(input).toHaveValue('Grace')
+
+  await user.click(screen.getByRole('button', { name: 'Save' }))
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Grace')
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+  expect(fetch).toHaveBeenCalledTimes(2)
+})
+
+test.each(['success', 'failure'] as const)('a stale %s cannot replace a newer accepted save', async (result) => {
+  const { requests } = deferredRequests()
+  const { submit } = renderProfile()
+  await submit('Grace')
+  await submit('Lin')
+  // Deliberately non-monotonic versions: no ordering guarantee is documented.
+  await act(async () => requests[1].resolve(profileResponse('Lin', 2)))
+  await act(async () => {
+    if (result === 'success') requests[0].resolve(profileResponse('Grace', 100))
+    else requests[0].reject(new Error('older request failed'))
+  })
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin')
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+
+  await submit('Katherine')
+  await act(async () => requests[2].reject(new Error('newest request failed')))
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin')
+  expect(screen.getByRole('alert')).toHaveTextContent('Save failed. Please retry.')
+})
+
+test('an older acknowledgement arriving after the latest failure advances the fallback without losing the draft', async () => {
+  const { requests } = deferredRequests()
+  const { input, submit } = renderProfile()
+  await submit('Grace')
+  await submit('Lin')
+  await act(async () => requests[1].reject(new Error('network unavailable')))
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Ada')
+  await act(async () => requests[0].resolve(profileResponse('Grace')))
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Grace')
+  expect(screen.getByRole('alert')).toHaveTextContent('Save failed. Please retry.')
+  expect(input).toHaveValue('Lin')
+})
+
+test('a stale failure leaves the newest optimistic name visible', async () => {
+  const { requests } = deferredRequests()
+  const { submit } = renderProfile()
+  await submit('Grace')
+  await submit('Lin')
+  await act(async () => requests[0].reject(new Error('older request failed')))
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin')
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+  await act(async () => requests[1].resolve(profileResponse('Lin')))
+})
+
+test('settlement after unmount cannot publish into a replacement form', async () => {
+  const { requests } = deferredRequests()
+  const { submit } = renderProfile()
+  await submit('Grace')
+  cleanup()
+  render(<ProfileForm profile={{ id: 'p2', displayName: 'Lin', version: 1 }} />)
+  await act(async () => requests[0].resolve(profileResponse('Grace')))
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin')
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+})
