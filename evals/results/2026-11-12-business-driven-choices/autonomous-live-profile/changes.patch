+import { type FormEvent, useReducer, useRef, useState } from 'react'
 
 import { type Profile, updateProfile } from './api'
 
+type Submission = {
+  id: number
+  displayName: string
+  status: 'pending' | 'confirmed' | 'failed'
+}
+
+type SaveState = {
+  confirmed: { submissionId: number; profile: Profile }
+  latest: Submission | null
+}
+
+type SaveEvent =
+  | { type: 'submitted'; id: number; displayName: string }
+  | { type: 'confirmed'; id: number; profile: Profile }
+  | { type: 'failed'; id: number }
+
+function reduceSave(state: SaveState, event: SaveEvent): SaveState {
+  if (event.type === 'submitted') {
+    return {
+      ...state,
+      latest: { id: event.id, displayName: event.displayName, status: 'pending' },
+    }
+  }
+
+  if (event.type === 'confirmed') {
+    return {
+      // Submission order protects newer accepted intent; version is opaque here.
+      confirmed:
+        event.id > state.confirmed.submissionId
+          ? { submissionId: event.id, profile: event.profile }
+          : state.confirmed,
+      latest:
+        state.latest?.id === event.id
+          ? { ...state.latest, status: 'confirmed' }
+          : state.latest,
+    }
+  }
+
+  return state.latest?.id === event.id
+    ? { ...state, latest: { ...state.latest, status: 'failed' } }
+    : state
+}
