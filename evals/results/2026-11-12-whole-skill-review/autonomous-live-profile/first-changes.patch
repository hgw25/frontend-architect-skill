@@ -0,0 +1,217 @@
+// @vitest-environment jsdom
+
+import '@testing-library/jest-dom/vitest'
+import { act, render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { afterEach, expect, test, vi } from 'vitest'
+
+import { ProfileForm } from './ProfileForm'
+
+const initialProfile = { id: 'p1', displayName: 'Ada', version: 1 }
+
+afterEach(() => vi.unstubAllGlobals())
+
+function controlledRequests() {
+  const requests: Array<{
+    resolve: (response: Response) => void
+    reject: (error: Error) => void
+  }> = []
+  const fetch = vi.fn(() => new Promise<Response>((resolve, reject) => {
+    requests.push({ resolve, reject })
+  }))
+  vi.stubGlobal('fetch', fetch)
+  return { fetch, requests }
+}
+
+function profileResponse(displayName: string, version: number) {
+  return new Response(JSON.stringify({ id: 'p1', displayName, version }))
+}
+
+async function saveName(user: ReturnType<typeof userEvent.setup>, name: string) {
+  await user.clear(screen.getByLabelText('Display name'))
+  await user.type(screen.getByLabelText('Display name'), name)
+  await user.click(screen.getByRole('button', { name: 'Save' }))
+}
+
+test('editing a draft neither saves nor changes the current profile', async () => {
+  const { fetch } = controlledRequests()
+  const user = userEvent.setup()
+  render(<ProfileForm profile={initialProfile} />)
+
+  await user.clear(screen.getByLabelText('Display name'))
+  await user.type(screen.getByLabelText('Display name'), 'Grace')
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Ada')
+  expect(fetch).not.toHaveBeenCalled()
+})
+
+test('accepts the returned name without overwriting a draft edited during save', async () => {
+  const { fetch, requests } = controlledRequests()
+  const user = userEvent.setup()
+  render(<ProfileForm profile={initialProfile} />)
+
+  await saveName(user, 'Grace')
+  expect(screen.getByRole('status')).toHaveTextContent('Saving')
+  await user.clear(screen.getByLabelText('Display name'))
+  await user.type(screen.getByLabelText('Display name'), 'Unsubmitted name')
+  await act(async () => requests[0].resolve(profileResponse('Grace Hopper', 2)))
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Grace Hopper')
+  expect(screen.getByLabelText('Display name')).toHaveValue('Unsubmitted name')
+  expect(screen.queryByRole('status')).not.toBeInTheDocument()
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+  expect(fetch.mock.calls[0]).toEqual(['/api/profile', {
+    method: 'PATCH',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ displayName: 'Grace' }),
+  }])
+})
+
+test.each(['network', 'HTTP', 'JSON'] as const)(
+  'recovers from a %s failure and permits an explicit retry with the retained draft',
+  async (failure) => {
+    const { fetch, requests } = controlledRequests()
+    const user = userEvent.setup()
+    render(<ProfileForm profile={initialProfile} />)
+
+    await saveName(user, 'Grace')
+    await act(async () => {
+      if (failure === 'network') requests[0].reject(new Error('offline'))
+      if (failure === 'HTTP') requests[0].resolve(new Response('{}', { status: 500 }))
+      if (failure === 'JSON') requests[0].resolve(new Response('not JSON'))
+    })
+
+    expect(screen.getByRole('alert')).toHaveTextContent('Save failed. Please retry.')
+    expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Ada')
+    expect(screen.getByLabelText('Display name')).toHaveValue('Grace')
+    expect(screen.queryByRole('status')).not.toBeInTheDocument()
+    expect(fetch).toHaveBeenCalledTimes(1)
+
+    await user.click(screen.getByRole('button', { name: 'Save' }))
+    expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+    expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Grace')
+    await act(async () => requests[1].resolve(profileResponse('Grace', 2)))
+
+    expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+    expect(screen.queryByRole('status')).not.toBeInTheDocument()
+    expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Grace')
+    expect(fetch).toHaveBeenCalledTimes(2)
+  },
+)
+
+test('an older rejection cannot clear pending state or replace a newer success', async () => {
+  const { requests } = controlledRequests()
+  const user = userEvent.setup()
+  render(<ProfileForm profile={initialProfile} />)
+
+  await saveName(user, 'Grace')
+  await saveName(user, 'Lin')
+  await act(async () => requests[0].reject(new Error('older failure')))
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin')
+  expect(screen.getByRole('status')).toHaveTextContent('Saving')
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+  await act(async () => requests[1].resolve(profileResponse('Lin', 2)))
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin')
+  expect(screen.queryByRole('status')).not.toBeInTheDocument()
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+})
+
+test('a late older rejection cannot undo the latest completed save', async () => {
+  const { requests } = controlledRequests()
+  const user = userEvent.setup()
+  render(<ProfileForm profile={initialProfile} />)
+
+  await saveName(user, 'Grace')
+  await saveName(user, 'Lin')
+  await act(async () => requests[1].resolve(profileResponse('Lin', 2)))
+  await act(async () => requests[0].reject(new Error('older failure')))
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin')
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+  expect(screen.queryByRole('status')).not.toBeInTheDocument()
+})
+
+test('late success advances the fallback after a newer failure without erasing its alert', async () => {
+  const { requests } = controlledRequests()
+  const user = userEvent.setup()
+  render(<ProfileForm profile={initialProfile} />)
+
+  await saveName(user, 'Grace')
+  await saveName(user, 'Lin')
+  await act(async () => requests[1].reject(new Error('latest failure')))
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Ada')
+  await act(async () => requests[0].resolve(profileResponse('Grace', 2)))
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Grace')
+  expect(screen.getByRole('alert')).toHaveTextContent('Save failed. Please retry.')
+  expect(screen.getByLabelText('Display name')).toHaveValue('Lin')
+})
+
+test('late lower-version responses never regress the confirmed fallback', async () => {
+  const { requests } = controlledRequests()
+  const user = userEvent.setup()
+  render(<ProfileForm profile={initialProfile} />)
+
+  await saveName(user, 'Grace')
+  await saveName(user, 'Lin')
+  await act(async () => requests[1].resolve(profileResponse('Lin accepted', 3)))
+  await act(async () => requests[0].resolve(profileResponse('Grace accepted', 2)))
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin accepted')
+  await saveName(user, 'Margaret')
+  await act(async () => requests[2].reject(new Error('latest failure')))
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin accepted')
+  expect(screen.getByRole('alert')).toHaveTextContent('Save failed. Please retry.')
+})
+
+test('server revision orders fallback independently of local submission order', async () => {
+  const { requests } = controlledRequests()
+  const user = userEvent.setup()
+  render(<ProfileForm profile={initialProfile} />)
+
+  await saveName(user, 'Grace')
+  await saveName(user, 'Lin')
+  await act(async () => requests[1].resolve(profileResponse('Lin', 2)))
+  await act(async () => requests[0].resolve(profileResponse('Grace', 3)))
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin')
+  await saveName(user, 'Margaret')
+  await act(async () => requests[2].reject(new Error('latest failure')))
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Grace')
+})
+
+test.each(['accepted', 'rejected'] as const)(
+  'changing profile identity isolates an old %s completion',
+  async (completion) => {
+    const { requests } = controlledRequests()
+    const user = userEvent.setup()
+    const view = render(<ProfileForm profile={initialProfile} />)
+
+    await saveName(user, 'Grace')
+    view.rerender(<ProfileForm profile={{ id: 'p2', displayName: 'Second profile', version: 1 }} />)
+    await user.type(screen.getByLabelText('Display name'), ' draft')
+    await act(async () => {
+      if (completion === 'accepted') requests[0].resolve(profileResponse('Grace', 99))
+      else requests[0].reject(new Error('old profile failure'))
+    })
+
+    expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Second profile')
+    expect(screen.getByLabelText('Display name')).toHaveValue('Second profile draft')
+    expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+    expect(screen.queryByRole('status')).not.toBeInTheDocument()
+  },
+)
+
+test('Enter submits the native form and settles to the server result', async () => {
+  const { requests } = controlledRequests()
+  const user = userEvent.setup()
+  render(<ProfileForm profile={initialProfile} />)
+
+  await user.clear(screen.getByLabelText('Display name'))
+  await user.type(screen.getByLabelText('Display name'), 'Grace{Enter}')
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Grace')
+  await act(async () => requests[0].resolve(profileResponse('Grace Hopper', 2)))
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Grace Hopper')
+  expect(screen.queryByRole('status')).not.toBeInTheDocument()
+})
