@@ -0,0 +1,58 @@
+import { afterEach, expect, test, vi } from 'vitest'
+
+import { updateProfile } from './api'
+
+afterEach(() => vi.unstubAllGlobals())
+
+test('PATCHes the name snapshot and returns the validated server profile', async () => {
+  const profile = { id: 'p1', displayName: 'Grace Hopper', version: 2 }
+  const fetch = vi.fn().mockResolvedValue(new Response(JSON.stringify(profile)))
+  vi.stubGlobal('fetch', fetch)
+
+  await expect(updateProfile('Grace')).resolves.toEqual(profile)
+  expect(fetch).toHaveBeenCalledExactlyOnceWith('/api/profile', {
+    method: 'PATCH',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ displayName: 'Grace' }),
+  })
+})
+
+test('rejects HTTP errors even when the body looks like a valid profile', async () => {
+  vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response(
+    JSON.stringify({ id: 'p1', displayName: 'Grace', version: 2 }),
+    { status: 503 },
+  )))
+
+  await expect(updateProfile('Grace')).rejects.toThrow('Profile update failed (503)')
+})
+
+test.each([
+  ['null', null],
+  ['array', []],
+  ['missing ID', { displayName: 'Grace', version: 2 }],
+  ['non-string ID', { id: 1, displayName: 'Grace', version: 2 }],
+  ['non-string name', { id: 'p1', displayName: 42, version: 2 }],
+  ['missing version', { id: 'p1', displayName: 'Grace' }],
+  ['non-numeric version', { id: 'p1', displayName: 'Grace', version: '2' }],
+])('rejects a successful response with %s', async (_description, body) => {
+  vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response(JSON.stringify(body))))
+
+  await expect(updateProfile('Grace')).rejects.toThrow('Invalid profile response')
+})
+
+test('rejects non-finite numeric JSON versions', async () => {
+  vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response(
+    '{"id":"p1","displayName":"Grace","version":1e400}',
+  )))
+
+  await expect(updateProfile('Grace')).rejects.toThrow('Invalid profile response')
+})
+
+test('propagates malformed JSON and transport failures as rejections', async () => {
+  vi.stubGlobal('fetch', vi.fn()
+    .mockResolvedValueOnce(new Response('invalid JSON'))
+    .mockRejectedValueOnce(new Error('offline')))
+
+  await expect(updateProfile('Grace')).rejects.toThrow()
+  await expect(updateProfile('Grace')).rejects.toThrow('offline')
+})
