diff --git a/src/profileSaveState.ts b/src/profileSaveState.ts
new file mode 100644
index 0000000..7884e0c
--- /dev/null
+++ b/src/profileSaveState.ts
@@ -0,0 +1,62 @@
+import { type Profile } from './api'
+
+type SaveIntent =
+  | { requestId: number; status: 'pending'; displayName: string }
+  | { requestId: number; status: 'succeeded'; profile: Profile }
+  | { requestId: number; status: 'failed' }
+
+export type ProfileSaveState = {
+  confirmed: Profile
+  latest: SaveIntent | null
+}
+
+export type ProfileSaveAction =
+  | { type: 'submitted'; requestId: number; displayName: string }
+  | { type: 'accepted'; requestId: number; profile: Profile }
+  | { type: 'rejected'; requestId: number }
+
+export function createProfileSaveState(profile: Profile): ProfileSaveState {
+  return { confirmed: profile, latest: null }
+}
+
+export function profileSaveReducer(
+  state: ProfileSaveState,
+  action: ProfileSaveAction,
+): ProfileSaveState {
+  switch (action.type) {
+    case 'submitted':
+      return {
+        ...state,
+        latest: {
+          requestId: action.requestId,
+          status: 'pending',
+          displayName: action.displayName,
+        },
+      }
+    case 'accepted':
+      return {
+        // Server revisions order confirmations, not client submission IDs.
+        confirmed: action.profile.version > state.confirmed.version
+          ? action.profile
+          : state.confirmed,
+        latest: action.requestId === state.latest?.requestId
+          ? { requestId: action.requestId, status: 'succeeded', profile: action.profile }
+          : state.latest,
+      }
+    case 'rejected':
+      return action.requestId === state.latest?.requestId
+        ? { ...state, latest: { requestId: action.requestId, status: 'failed' } }
+        : state
+  }
+}
+
+export function getVisibleName(state: ProfileSaveState): string {
+  switch (state.latest?.status) {
+    case 'pending':
+      return state.latest.displayName
+    case 'succeeded':
+      return state.latest.profile.displayName
+    default:
+      return state.confirmed.displayName
+  }
+}
