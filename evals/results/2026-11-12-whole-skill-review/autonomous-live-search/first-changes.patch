+      const users = await fetchUsers(query);
+      if (disposed || requestId !== latestRequestId) return;
+
+      state = {
+        ...state,
+        items: users.map(({ user_id, display_name }) => ({ id: user_id, label: display_name })),
+        status: 'success',
+      };
     } catch (error) {
-      state.error = error.message; state.status = 'error';
-    } finally {
-      if (state.status === 'loading') state.status = 'idle';
+      if (disposed || requestId !== latestRequestId) return;
+
+      state = {
+        ...state,
+        error: error instanceof Error ? error.message : String(error),
+        status: 'error',
+      };
     }
   }
+
   return {
-    setDraft(value) { state.draft = value; },
-    submit,
-    retry: submit,
+    setDraft(value) {
+      if (!disposed) state = { ...state, draft: value };
+    },
+    submit() { return runSearch(state.draft.trim()); },
+    retry() { return runSearch(state.submitted); },
     getState() { return structuredClone(state); },
-    dispose() {},
+    dispose() { disposed = true; },
   };
 }
