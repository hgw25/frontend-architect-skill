@@ -0,0 +1,114 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createSearch } from '../src/search.js';
+
+function deferredSearch() {
+  const requests = [];
+  const search = createSearch(query => new Promise((resolve, reject) => {
+    requests.push({ query, resolve, reject });
+  }));
+  return { search, requests };
+}
+
+test('blank submission does not supersede pending work or change the retry target', async () => {
+  const { search, requests } = deferredSearch();
+  search.setDraft(' Ada ');
+  const pending = search.submit();
+  search.setDraft('   ');
+  const beforeBlank = search.getState();
+
+  assert.equal(await search.submit(), undefined);
+  assert.equal(requests.length, 1);
+  assert.deepEqual(search.getState(), beforeBlank);
+
+  const ada = { user_id: '1', display_name: 'Ada' };
+  requests[0].resolve([ada]);
+  await pending;
+  assert.equal(search.getState().status, 'success');
+
+  const retry = search.retry();
+  assert.equal(requests[1].query, 'Ada');
+  assert.deepEqual(search.getState(), {
+    draft: '   ', submitted: 'Ada', status: 'loading',
+    items: [{ id: '1', label: 'Ada' }], error: null,
+  });
+  requests[1].resolve([]);
+  await retry;
+  assert.deepEqual(search.getState().items, []);
+});
+
+test('synchronous transport failures become public errors and fulfill the command', async t => {
+  const cases = [
+    [new Error('unavailable'), 'unavailable'],
+    ['offline', 'offline'],
+    [null, 'null'],
+    [undefined, 'undefined'],
+    [17, '17'],
+  ];
+
+  for (const [failure, message] of cases) {
+    await t.test(message, async () => {
+      const calls = [];
+      const search = createSearch((...args) => {
+        calls.push(args);
+        throw failure;
+      });
+      search.setDraft(' Ada ');
+      assert.equal(await search.submit(), undefined);
+      assert.deepEqual(calls, [['Ada']]);
+      assert.deepEqual(search.getState(), {
+        draft: ' Ada ', submitted: 'Ada', status: 'error', items: [], error: message,
+      });
+    });
+  }
+});
+
+test('retry supersedes an in-flight request while preserving an unsent draft', async () => {
+  const { search, requests } = deferredSearch();
+  search.setDraft('submitted');
+  const first = search.submit();
+  search.setDraft('unsent');
+  const retry = search.retry();
+  assert.deepEqual(requests.map(request => request.query), ['submitted', 'submitted']);
+
+  requests[0].reject(new Error('superseded failure'));
+  await first;
+  assert.deepEqual(search.getState(), {
+    draft: 'unsent', submitted: 'submitted', status: 'loading', items: [], error: null,
+  });
+
+  requests[1].resolve([{ user_id: '2', display_name: 'Current' }]);
+  await retry;
+  assert.deepEqual(search.getState(), {
+    draft: 'unsent', submitted: 'submitted', status: 'success',
+    items: [{ id: '2', label: 'Current' }], error: null,
+  });
+});
+
+test('transport aliases and snapshots cannot mutate retained results after disposal', async () => {
+  const users = [{ user_id: '1', display_name: 'Ada' }];
+  let calls = 0;
+  const search = createSearch(async () => {
+    calls += 1;
+    return users;
+  });
+  search.setDraft('Ada');
+  await search.submit();
+  search.dispose();
+  const frozen = search.getState();
+
+  users[0].display_name = 'Changed DTO';
+  users.push({ user_id: '2', display_name: 'Other' });
+  const snapshot = search.getState();
+  snapshot.items[0].label = 'Changed snapshot';
+  snapshot.items.push({ id: '3', label: 'Injected' });
+  snapshot.submitted = 'Changed query';
+  search.setDraft('Bob');
+  await search.submit();
+  await search.retry();
+  search.dispose();
+
+  assert.equal(calls, 1);
+  assert.deepEqual(search.getState(), frozen);
+  assert.deepEqual(frozen.items, [{ id: '1', label: 'Ada' }]);
+});
