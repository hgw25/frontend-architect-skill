+
+async function getFileSignature(sourcePath: string): Promise<FileSignature> {
+  try {
+    const metadata = await stat(sourcePath)
+    return {
+      mtimeMs: metadata.mtimeMs,
+      size: metadata.size,
+    }
+  } catch (error) {
+    throw createDiagnostic(
+      'SOURCE_NOT_FOUND',
+      `Unable to read feature flags from ${sourcePath}.`,
+      ['Create the JSON file or update the `source` option to point at the correct file.'],
+      error,
+    )
+  }
+}
+
+function isSameSignature(left: FileSignature, right: FileSignature) {
+  return left.mtimeMs === right.mtimeMs && left.size === right.size
+}
+
+async function readSourceFile(sourcePath: string) {
+  try {
+    return await readFile(sourcePath, 'utf8')
+  } catch (error) {
+    throw createDiagnostic(
