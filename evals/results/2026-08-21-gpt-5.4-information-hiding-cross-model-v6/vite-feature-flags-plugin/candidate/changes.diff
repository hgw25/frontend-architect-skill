+      ['Fix the JSON syntax and keep the top-level shape as a flat object of primitive flag values.'],
+      error,
+    )
+  }
+}
+
+function pickExposedFlags(
+  parsedFlags: Record<string, unknown>,
+  exposedKeys: readonly string[],
+  sourcePath: string,
+): Record<string, FeatureFlagValue> {
+  const missingKeys: string[] = []
+  const invalidKeys: string[] = []
+  const publicFlags: Record<string, FeatureFlagValue> = {}
+
+  for (const key of exposedKeys) {
+    if (!(key in parsedFlags)) {
+      missingKeys.push(key)
+      continue
+    }
+
+    const value = parsedFlags[key]
+    if (!isFeatureFlagValue(value)) {
+      invalidKeys.push(key)
+      continue
+    }
+
+    publicFlags[key] = value
+  }
+
+  if (missingKeys.length > 0) {
+    throw createDiagnostic(
+      'MISSING_EXPOSED_FLAG',
+      `The configured public flags are missing from ${sourcePath}: ${missingKeys.join(', ')}.`,
+      ['Add the missing keys to the source JSON or remove them from the `expose` list in your Vite config.'],
+    )
+  }
+
+  if (invalidKeys.length > 0) {
+    throw createDiagnostic(
+      'INVALID_FLAG_VALUE',
+      `The configured public flags in ${sourcePath} must be primitive JSON values: ${invalidKeys.join(', ')}.`,
+      ['Replace each invalid value with a boolean, number, string, or null before exposing it to the client bundle.'],
+    )
+  }
+
+  return publicFlags
+}
+
+function isFeatureFlagValue(value: unknown): value is FeatureFlagValue {
+  return value === null || ['boolean', 'number', 'string'].includes(typeof value)
+}
+
+function renderVirtualModule(flags: Record<string, FeatureFlagValue>) {
+  const serializedFlags = JSON.stringify(flags, null, 2)
+  return [
+    `const flags = Object.freeze(${serializedFlags});`,
+    '',
+    'export { flags };',
+    'export default flags;',
+  ].join('\n')
+}
+
+function createSourceMap(sourcePath: string) {
+  return {
+    version: 3,
+    sources: [sourcePath],
+    sourcesContent: [],
+    names: [],
+    mappings: '',
+  }
+}
+
+function collectImporters(moduleNode: ModuleNode, affected: Set<ModuleNode>) {
+  for (const importer of moduleNode.importers) {
+    if (affected.has(importer)) {
+      continue
+    }
+
+    affected.add(importer)
+    collectImporters(importer, affected)
+  }
+}
+
+function createDiagnostic(
+  code: string,
+  message: string,
+  remediation: string[],
+  cause?: unknown,
+) {
+  const details = remediation.map((step) => `- ${step}`).join('\n')
+  const error = new Error(
+    `[${PLUGIN_NAME}:${code}] ${message}\n${details}`,
+    cause ? { cause } : undefined,
+  )
+
+  return error
+}
