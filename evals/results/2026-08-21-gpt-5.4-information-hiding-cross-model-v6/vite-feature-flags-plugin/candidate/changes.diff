+
+function resolveSourcePath(source: string | URL, configRoot: string) {
+  if (source instanceof URL) {
+    if (source.protocol !== 'file:') {
+      throw createDiagnostic(
+        'UNSUPPORTED_SOURCE_URL',
+        `Expected a file URL for \`source\`, received ${source.href}.`,
+        ['Use a file URL such as `new URL("./flags.json", import.meta.url)` or pass an absolute/relative file path.'],
+      )
+    }
