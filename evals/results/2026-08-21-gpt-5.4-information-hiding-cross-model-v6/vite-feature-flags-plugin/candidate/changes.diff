+
+function parseFlagDocument(sourceText: string, sourcePath: string): Record<string, unknown> {
+  try {
+    const parsed = JSON.parse(sourceText) as unknown
+    if (!parsed || Array.isArray(parsed) || typeof parsed !== 'object') {
+      throw new TypeError('Expected the JSON document root to be an object.')
+    }
