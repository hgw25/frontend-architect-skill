-import type { Plugin } from 'vite'
+import { watch } from 'node:fs'
+import { readFile, stat } from 'node:fs/promises'
+import { resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import type { HmrContext, ModuleNode, Plugin, ResolvedConfig } from 'vite'
+import { normalizePath } from 'vite'
+
+export type FeatureFlagValue = boolean | number | string | null
+
+export interface FeatureFlagsSchema {}
+
+type KnownFeatureFlagName = Extract<keyof FeatureFlagsSchema, string>
+type FeatureFlagNameList = [KnownFeatureFlagName] extends [never]
+  ? readonly string[]
+  : readonly KnownFeatureFlagName[]
+
+type ValidatedFeatureFlagsSchema = {
+  readonly [Key in keyof FeatureFlagsSchema]: FeatureFlagsSchema[Key] extends FeatureFlagValue
+    ? FeatureFlagsSchema[Key]
+    : never
+}
+
+export type FeatureFlags = Readonly<
+  [KnownFeatureFlagName] extends [never]
+    ? Record<string, FeatureFlagValue>
+    : ValidatedFeatureFlagsSchema
+>
+
+export interface FeatureFlagsOptions {
+  source: string | URL
+  expose: FeatureFlagNameList
+}
+
+interface FileSignature {
+  mtimeMs: number
+  size: number
+}
+
+interface LoadedFlags {
+  sourcePath: string
+  flags: Record<string, FeatureFlagValue>
+}
+
+interface CacheEntry extends LoadedFlags {
+  signature: FileSignature
+}
+
+const PLUGIN_NAME = 'feature-flags'
+const VIRTUAL_MODULE_ID = 'virtual:feature-flags'
+const RESOLVED_VIRTUAL_MODULE_ID = `\0${VIRTUAL_MODULE_ID}`
+
+export function featureFlags(options: FeatureFlagsOptions): Plugin {
+  let config: ResolvedConfig | undefined
+  let resolvedSourcePath: string | undefined
+  let cache: CacheEntry | undefined
+  let stopWatchingSource: (() => void) | undefined
+
+  const clearCache = () => {
+    cache = undefined
+  }
+
+  const getConfigRoot = () => config?.root ?? process.cwd()
+
+  const ensureSourcePath = () => {
+    if (resolvedSourcePath) {
+      return resolvedSourcePath
+    }
+
+    resolvedSourcePath = resolveSourcePath(options.source, getConfigRoot())
+    return resolvedSourcePath
+  }
+
+  const readPublicFlags = async (): Promise<LoadedFlags> => {
+    const sourcePath = ensureSourcePath()
+    const signature = await getFileSignature(sourcePath)
+
+    if (cache && isSameSignature(cache.signature, signature)) {
+      return cache
+    }
+
+    const fileContents = await readSourceFile(sourcePath)
+    const parsed = parseFlagDocument(fileContents, sourcePath)
+    const flags = pickExposedFlags(parsed, options.expose, sourcePath)
+
+    cache = {
+      sourcePath,
+      flags,
+      signature,
+    }
+
+    return cache
+  }
