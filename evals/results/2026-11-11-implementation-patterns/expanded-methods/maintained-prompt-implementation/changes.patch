new file mode 100644
index 0000000..bcb2fb3
--- /dev/null
+++ b/src/export-selection.mjs
@@ -0,0 +1,13 @@
+export async function exportSelection(rows, write) {
+  if (rows.length === 0) return { kind: 'empty' };
+
+  const blockedIds = rows
+    .filter((row) => row.status !== 'ready')
+    .map((row) => row.id);
+  if (blockedIds.length) return { kind: 'blocked', ids: blockedIds };
+
+  // Capture the selected intent before awaiting transport acceptance.
+  const ids = rows.map((row) => row.id);
+  await write({ schema: 1, document_ids: ids });
+  return { kind: 'sent', ids };
+}
