--- /dev/null
+++ b/test/export-regression.test.mjs
@@ -0,0 +1,70 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { exportSelection } from '../src/export-selection.mjs';
+import { handleToolbarExport } from '../src/toolbar.mjs';
+import { handleKeyboardExport } from '../src/keyboard.mjs';
+
+const exporters = {
+  shared: exportSelection,
+  toolbar: handleToolbarExport,
+  keyboard: handleKeyboardExport,
+};
+
+for (const [name, exportRows] of Object.entries(exporters)) {
+  test(name + ': every blocked ID is reported in selection order', async () => {
+    const rows = Object.freeze([
+      Object.freeze({ id: 'c', status: 'pending' }),
+      Object.freeze({ id: 'a', status: 'ready' }),
+      Object.freeze({ id: 'b', status: 'failed' }),
+    ]);
+    const outcome = await exportRows(rows, () => assert.fail('Unexpected write'));
+    assert.deepEqual(outcome, { kind: 'blocked', ids: ['c', 'b'] });
+  });
+
+  test(name + ': frozen ready selection remains exportable', async () => {
+    const rows = Object.freeze([
+      Object.freeze({ id: 'b', status: 'ready' }),
+      Object.freeze({ id: 'a', status: 'ready' }),
+    ]);
+    const calls = [];
+    const outcome = await exportRows(rows, (body) => { calls.push(body); });
+    assert.deepEqual(calls, [{ schema: 1, document_ids: ['b', 'a'] }]);
+    assert.deepEqual(outcome, { kind: 'sent', ids: ['b', 'a'] });
+  });
+
+  test(name + ': pending export retains the whole selection until acceptance', async () => {
+    let accept;
+    const acceptance = new Promise((resolve) => { accept = resolve; });
+    const rows = [{ id: 'a', status: 'ready' }, { id: 'b', status: 'ready' }];
+    const calls = [];
+    let settled = false;
+    const pending = exportRows(rows, (body) => {
+      calls.push(body);
+      return acceptance;
+    }).then((outcome) => {
+      settled = true;
+      return outcome;
+    });
+
+    rows[0].id = 'changed';
+    rows[1].status = 'pending';
+    rows.reverse();
+    rows.splice(0, rows.length, { id: 'new', status: 'ready' });
+    await Promise.resolve();
+    assert.equal(settled, false);
+    assert.deepEqual(calls, [{ schema: 1, document_ids: ['a', 'b'] }]);
+
+    accept();
+    assert.deepEqual(await pending, { kind: 'sent', ids: ['a', 'b'] });
+    assert.equal(settled, true);
+    assert.equal(calls.length, 1);
+  });
+
+  test(name + ': synchronous transport errors reject unchanged', async () => {
+    const failure = new Error('Transport rejected the request');
+    const pending = exportRows([{ id: 'a', status: 'ready' }], () => {
+      throw failure;
+    });
+    await assert.rejects(pending, (error) => error === failure);
+  });
+}
