-if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
-  for (const row of [...body.rows].slice(0, 8)) row.animate({ opacity: [0, 1] }, { duration: 240 });
+
+function animateVisibleRows() {
+  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+
+  const gridBounds = grid.getBoundingClientRect();
+  const visibleTop = Math.max(gridBounds.top, 0);
+  const visibleBottom = Math.min(gridBounds.bottom, document.documentElement.clientHeight);
+
+  if (visibleBottom <= visibleTop) return;
+
+  for (const row of body.rows) {
+    const rowBounds = row.getBoundingClientRect();
+    if (rowBounds.bottom <= visibleTop || rowBounds.top >= visibleBottom) continue;
+
+    row.animate(
+      { opacity: [0, 1] },
+      { duration: 240, easing: 'ease-out' },
+    );
+  }
 }
