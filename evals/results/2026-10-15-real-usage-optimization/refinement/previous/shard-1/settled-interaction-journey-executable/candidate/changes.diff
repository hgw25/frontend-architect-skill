   row.insertCell().textContent = 'Record ' + index;
 }
-if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
-  for (const row of [...body.rows].slice(0, 8)) row.animate({ opacity: [0, 1] }, { duration: 240 });
+
+function animateVisibleRows() {
+  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+
+  const gridRect = grid.getBoundingClientRect();
+  const visibleTop = Math.max(gridRect.top, 0);
+  const visibleBottom = Math.min(gridRect.bottom, window.innerHeight);
+
+  if (visibleBottom <= visibleTop) return;
+
+  for (const row of body.rows) {
+    const rowRect = row.getBoundingClientRect();
+
+    if (rowRect.bottom <= visibleTop) continue;
+    if (rowRect.top >= visibleBottom) break;
+
+    row.animate(
+      { opacity: [0, 1] },
+      { duration: 240, easing: 'ease-out' },
+    );
+  }
 }
