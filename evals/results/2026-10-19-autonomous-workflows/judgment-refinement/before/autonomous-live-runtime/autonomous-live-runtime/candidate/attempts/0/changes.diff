+import { readFile } from 'node:fs/promises';
+
 import * as platform from './platform.mjs';
-import {readFile} from 'node:fs/promises';
-let cached;
-export function createApp(services=platform){return async(req,res)=>{
- const u=new URL(req.url,'http://localhost');
