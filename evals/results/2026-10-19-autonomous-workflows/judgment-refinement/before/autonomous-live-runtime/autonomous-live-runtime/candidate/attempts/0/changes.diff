+  font: inherit;
+  font-size: .86rem;
+  font-weight: 750;
+  letter-spacing: .08em;
+  cursor: pointer;
+  transition: background-color .18s ease, color .18s ease, transform .18s ease;
+}
+
+form button:hover:not(:disabled) { color: var(--accent); background: transparent; }
+form button:active:not(:disabled) { transform: translateY(1px); }
+form button:disabled { cursor: not-allowed; opacity: .48; }
+
+form button:focus-visible, a:focus-visible {
+  outline: 3px solid #df8e49;
+  outline-offset: 3px;
+}
+
+.permission-note { margin: .75rem 0 0; line-height: 1.5; }
+.purchase-status { min-height: 1.3rem; margin: .8rem 0 0; color: var(--accent); font-weight: 650; line-height: 1.5; }
+
+.assurances {
+  margin: 1.4rem 0 0;
+  padding: 1.2rem 0 0;
+  border-top: 1px solid var(--line);
+  display: flex;
+  flex-wrap: wrap;
+  gap: .6rem 1.4rem;
+  list-style: none;
+}
+
+.assurances span { color: var(--accent); font-weight: 800; }
+
+.result-page {
+  width: min(38rem, calc(100% - 2rem));
+  margin: 15vh auto 0;
+  padding: clamp(2rem, 8vw, 5rem);
+  background: var(--paper);
+  box-shadow: 0 24px 70px rgba(38,43,39,.1);
+}
+
+.result-page h1 { max-width: none; font-size: clamp(2.5rem, 7vw, 4.5rem); }
+.result-page p[role="status"] { color: var(--muted); line-height: 1.6; }
+.text-link { color: var(--accent); font-weight: 700; text-underline-offset: .25em; }
+
+@media (max-width: 760px) {
+  .site-header { min-height: 64px; }
+  .account-label { display: none; }
+  .product-page { padding-block-start: 1rem; }
+  .product-layout { grid-template-columns: 1fr; }
+  .product-visual { min-height: 22rem; }
+  .mug { width: 9rem; height: 12rem; }
+  .mug::after { right: -3.8rem; top: 3rem; width: 4.2rem; height: 5.2rem; border-width: 1.2rem; }
+  .product-details { padding: 2.4rem 1.5rem 3rem; }
+  h1 { font-size: clamp(2.7rem, 15vw, 4rem); }
+  .assurances { display: grid; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
+}
+
+@media (forced-colors: active) {
+  .product-layout, .result-page { border: 1px solid CanvasText; }
+  form button { forced-color-adjust: none; }
+}
