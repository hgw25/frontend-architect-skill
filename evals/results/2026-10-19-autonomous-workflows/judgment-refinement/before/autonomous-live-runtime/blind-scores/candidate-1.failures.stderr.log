+  --ink: #17201d;
+  --muted: #66706c;
+  --paper: #fbfaf6;
+  --line: #d8d4c9;
+  --accent: #154e3c;
+  --accent-light: #dbe8df;
+}
+
+* { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  min-width: 320px;
+  min-height: 100vh;
+  background:
+    radial-gradient(circle at 12% 5%, rgba(255,255,255,.95), transparent 34rem),
+    #f3f0e9;
+}
+
+a { color: inherit; }
+
+.site-header {
+  min-height: 76px;
+  padding: 0 clamp(1.25rem, 4vw, 4.5rem);
+  border-bottom: 1px solid rgba(23,32,29,.12);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  gap: .7rem;
+  color: var(--ink);
+  font-size: .82rem;
+  font-weight: 750;
+  letter-spacing: .12em;
+  text-decoration: none;
+  text-transform: uppercase;
+}
+
+.brand-mark {
+  width: 2rem;
+  height: 2rem;
+  border: 1px solid currentColor;
+  display: grid;
+  place-items: center;
+  font-family: Georgia, serif;
+  font-size: 1rem;
+}
+
+.account-label, .breadcrumb, .quote-note, .permission-note, .purchase-status, .assurances {
+  color: var(--muted);
+  font-size: .82rem;
+}
+
+.account-label { letter-spacing: .06em; }
+
+.product-page { padding: 1.4rem clamp(1.25rem, 4vw, 4.5rem) 4rem; }
+
+.breadcrumb {
+  display: flex;
+  gap: .55rem;
+  align-items: center;
+  margin: 0 auto 1.4rem;
+  max-width: 1240px;
+}
+
+.breadcrumb a { text-underline-offset: .2em; }
+
+.product-layout {
+  max-width: 1240px;
+  margin: 0 auto;
+  display: grid;
+  grid-template-columns: minmax(0, 1.12fr) minmax(22rem, .88fr);
+  min-height: min(660px, calc(100vh - 150px));
+  background: var(--paper);
+  box-shadow: 0 24px 70px rgba(38,43,39,.1);
+}
+
+.product-visual {
+  position: relative;
+  margin: 0;
+  min-height: 34rem;
+  overflow: hidden;
+  display: grid;
+  place-items: center;
+  background:
+    linear-gradient(135deg, transparent 48%, rgba(255,255,255,.18) 48%),
+    #d4d8d0;
+}
+
+.product-visual::before {
+  content: "";
+  position: absolute;
+  width: min(30rem, 75%);
+  aspect-ratio: 1;
+  border: 1px solid rgba(21,78,60,.16);
+  border-radius: 50%;
+}
+
+.mug {
+  position: relative;
+  z-index: 1;
+  width: clamp(11rem, 24vw, 18rem);
+  height: clamp(14rem, 30vw, 22rem);
+  border-radius: 1.25rem 1.25rem 4rem 4rem;
+  display: grid;
+  place-items: center;
+  color: #e5e7df;
+  background: linear-gradient(120deg, #33413d, #18231f 65%, #48534f);
+  box-shadow: inset 16px 0 28px rgba(255,255,255,.08), 0 30px 40px rgba(35,47,42,.23);
+  transform: rotate(-5deg);
+}
+
+.mug::before {
+  content: "";
+  position: absolute;
+  inset: -1rem -.2rem auto;
+  height: 2.1rem;
+  border-radius: 50%;
+  background: #59645f;
+  border: .4rem solid #26332e;
+}
+
+.mug::after {
+  content: "";
+  position: absolute;
+  right: -5.4rem;
+  top: 4.4rem;
+  width: 5.7rem;
+  height: 7.6rem;
+  border: 1.8rem solid #293630;
+  border-left-width: 1rem;
+  border-radius: 0 55% 55% 0;
+}
+
+.mug span { font: 600 2rem/1 Georgia, serif; letter-spacing: .12em; }
+
+.product-visual figcaption {
+  position: absolute;
+  inset: auto auto 1.5rem 1.7rem;
+  color: #4f5a55;
+  font-size: .72rem;
+  letter-spacing: .14em;
+  text-transform: uppercase;
+}
+
+.product-details {
+  padding: clamp(2.5rem, 6vw, 5.5rem) clamp(2rem, 5vw, 4.8rem);
+  align-self: center;
+}
+
+.eyebrow, .quote-label {
+  margin: 0 0 1rem;
+  color: var(--accent);
+  font-size: .7rem;
+  font-weight: 800;
+  letter-spacing: .16em;
+  text-transform: uppercase;
+}
+
+h1 {
+  max-width: 10ch;
+  margin: 0;
+  font: 500 clamp(2.8rem, 5vw, 5.2rem)/.95 Georgia, "Times New Roman", serif;
+  letter-spacing: -.045em;
+}
+
+.description {
+  max-width: 34rem;
+  margin-top: 1.6rem;
+  color: #58615e;
+  font-size: 1rem;
+  line-height: 1.7;
+}
+
+.description p { margin: 0 0 .75rem; }
+.description strong { color: var(--ink); font-weight: 650; }
+
+.divider { height: 1px; margin: 2rem 0; background: var(--line); }
+.quote-label { margin-bottom: .5rem; }
+
+.price {
+  margin: 0;
+  font: 500 clamp(2.4rem, 4vw, 3.7rem)/1 Georgia, "Times New Roman", serif;
+  letter-spacing: -.035em;
+}
+
+.quote-note { margin: .6rem 0 1.6rem; line-height: 1.45; }
+
+form button {
+  width: 100%;
+  min-height: 3.65rem;
+  padding: 0 1.25rem;
+  border: 1px solid var(--accent);
+  border-radius: 0;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  color: #fff;
+  background: var(--accent);
+  font: inherit;
+  font-size: .86rem;
+  font-weight: 750;
+  letter-spacing: .08em;
+  cursor: pointer;
+  transition: background-color .18s ease, color .18s ease, transform .18s ease;
+}
+
+form button:hover:not(:disabled) { color: var(--accent); background: transparent; }
+form button:active:not(:disabled) { transform: translateY(1px); }
+form button:disabled { cursor: not-allowed; opacity: .48; }
+
+form button:focus-visible, a:focus-visible {
+  outline: 3px solid #df8e49;
+  outline-offset: 3px;
+}
+
+.permission-note { margin: .75rem 0 0; line-height: 1.5; }
+.purchase-status { min-height: 1.3rem; margin: .8rem 0 0; color: var(--accent); font-weight: 650; line-height: 1.5; }
+
+.assurances {
+  margin: 1.4rem 0 0;
+  padding: 1.2rem 0 0;
+  border-top: 1px solid var(--line);
+  display: flex;
+  flex-wrap: wrap;
+  gap: .6rem 1.4rem;
+  list-style: none;
+}
+
+.assurances span { color: var(--accent); font-weight: 800; }
+
+.result-page {
+  width: min(38rem, calc(100% - 2rem));
+  margin: 15vh auto 0;
+  padding: clamp(2rem, 8vw, 5rem);
+  background: var(--paper);
+  box-shadow: 0 24px 70px rgba(38,43,39,.1);
+}
+
+.result-page h1 { max-width: none; font-size: clamp(2.5rem, 7vw, 4.5rem); }
+.result-page p[role="status"] { color: var(--muted); line-height: 1.6; }
+.text-link { color: var(--accent); font-weight: 700; text-underline-offset: .25em; }
+
+@media (max-width: 760px) {
+  .site-header { min-height: 64px; }
+  .account-label { display: none; }
+  .product-page { padding-block-start: 1rem; }
+  .product-layout { grid-template-columns: 1fr; }
+  .product-visual { min-height: 22rem; }
+  .mug { width: 9rem; height: 12rem; }
+  .mug::after { right: -3.8rem; top: 3rem; width: 4.2rem; height: 5.2rem; border-width: 1.2rem; }
+  .product-details { padding: 2.4rem 1.5rem 3rem; }
+  h1 { font-size: clamp(2.7rem, 15vw, 4rem); }
+  .assurances { display: grid; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
+}
+
+@media (forced-colors: active) {
+  .product-layout, .result-page { border: 1px solid CanvasText; }
+  form button { forced-color-adjust: none; }
+}
