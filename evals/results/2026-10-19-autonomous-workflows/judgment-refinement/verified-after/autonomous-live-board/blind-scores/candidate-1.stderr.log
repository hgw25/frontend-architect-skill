+  dragPointerId = null;
+}
+
+function updateVisibility() {
+  toggle.textContent = visible ? 'Hide board' : 'Show board';
+  if (visible) {
+    renderBoard();
+    return;
+  }
+  cancelAnimations();
+  list?.remove();
+  list = null;
+}
+
+toggle.addEventListener('click', () => {
