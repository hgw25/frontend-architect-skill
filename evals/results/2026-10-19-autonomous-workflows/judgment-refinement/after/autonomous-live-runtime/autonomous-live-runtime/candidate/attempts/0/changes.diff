+@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700&display=swap');
+
+:root {
+  color-scheme: light;
+  --ink: #17231d;
+  --muted: #657168;
+  --paper: #f3f0e8;
+  --card: #fffdf8;
+  --line: #d9d7ce;
+  --accent: #daff6a;
+  --accent-strong: #bde548;
+  --forest: #1f352a;
+  font-family: 'DM Sans', system-ui, sans-serif;
+  color: var(--ink);
+  background: var(--paper);
+}
+
+* { box-sizing: border-box; }
+
+body {
+  min-width: 320px;
+  min-height: 100vh;
+  margin: 0;
+  background:
+    radial-gradient(circle at 8% 3%, rgba(218, 255, 106, .38), transparent 25rem),
+    linear-gradient(135deg, #f8f6f0 0%, var(--paper) 62%, #e8e9df 100%);
+}
+
+button, a { font: inherit; }
+
+.product-page {
+  width: min(1160px, calc(100% - 40px));
+  margin-inline: auto;
+  padding-block: 34px 52px;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 11px;
+  margin-block-end: 30px;
+  color: var(--ink);
+  font-family: Manrope, sans-serif;
+  font-weight: 700;
+  letter-spacing: -.02em;
+  text-decoration: none;
+}
+
+.brand-mark {
+  display: grid;
+  width: 34px;
+  aspect-ratio: 1;
+  place-items: center;
+  border-radius: 10px 3px 10px 3px;
+  color: var(--accent);
+  background: var(--forest);
+}
+
+.product-card {
+  display: grid;
+  grid-template-columns: minmax(0, 1.04fr) minmax(340px, .96fr);
+  min-height: 610px;
+  overflow: hidden;
+  border: 1px solid rgba(23, 35, 29, .12);
+  border-radius: 28px;
+  background: var(--card);
+  box-shadow: 0 24px 70px rgba(36, 45, 39, .10);
+}
+
+.product-visual {
+  position: relative;
+  display: grid;
+  min-height: 520px;
+  place-items: center;
+  overflow: hidden;
+  background:
+    linear-gradient(125deg, rgba(255,255,255,.9), rgba(255,255,255,0) 45%),
+    repeating-linear-gradient(90deg, transparent 0 52px, rgba(31,53,42,.035) 53px 54px),
+    #dce2dc;
+}
+
+.product-visual::after {
+  position: absolute;
+  inset: auto 10% 13%;
+  height: 12%;
+  border-radius: 50%;
+  background: rgba(23, 35, 29, .15);
+  filter: blur(18px);
+  content: '';
+}
+
+.mug {
+  position: relative;
+  z-index: 1;
+  width: clamp(190px, 26vw, 285px);
+  height: clamp(250px, 35vw, 365px);
+  border-radius: 24px 24px 56px 56px;
+  background:
+    linear-gradient(90deg, #8b9591 0%, #e7ebe8 18%, #aeb7b2 47%, #f8faf8 68%, #7b8580 100%);
+  box-shadow: inset -16px 0 32px rgba(26, 37, 32, .16), 0 25px 32px rgba(35, 47, 40, .22);
+}
+
+.mug::before {
+  position: absolute;
+  inset: -8px 0 auto;
+  height: 34px;
+  border: 8px solid #727d78;
+  border-radius: 50%;
+  background: #24332b;
+  content: '';
+}
+
+.mug-handle {
+  position: absolute;
+  z-index: -1;
+  top: 82px;
+  right: -95px;
+  width: 125px;
+  height: 180px;
+  border: 28px solid #929c97;
+  border-left-width: 18px;
+  border-radius: 50%;
+}
+
+.mug-shine {
+  position: absolute;
+  inset: 45px auto 42px 20%;
+  width: 13%;
+  border-radius: 50%;
+  background: linear-gradient(rgba(255,255,255,.72), rgba(255,255,255,.08));
+  filter: blur(2px);
+}
+
+.material-label {
+  position: absolute;
+  inset: auto auto 28px 30px;
+  z-index: 2;
+  padding: 8px 12px;
+  border: 1px solid rgba(23, 35, 29, .25);
+  border-radius: 999px;
+  font-size: .7rem;
+  font-weight: 700;
+  letter-spacing: .14em;
+}
+
+.product-details {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  padding: clamp(38px, 6vw, 76px);
+}
+
+.eyebrow {
+  margin: 0 0 12px;
+  color: #526157;
+  font-size: .75rem;
+  font-weight: 700;
+  letter-spacing: .14em;
+  text-transform: uppercase;
+}
+
+h1 {
+  margin: 0;
+  font-family: Manrope, sans-serif;
+  font-size: clamp(2.6rem, 5vw, 4.7rem);
+  line-height: .98;
+  letter-spacing: -.065em;
+}
+
+.sku {
+  margin: 14px 0 26px;
+  color: var(--muted);
+  font-size: .84rem;
+}
+
+.description {
+  max-width: 48ch;
+  color: #4c5850;
+  font-size: 1rem;
+  line-height: 1.65;
+}
+
+.description p { margin-block: 0 12px; }
+
+.quote-panel {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 20px;
+  margin-block: 28px 20px;
+  padding-block-start: 24px;
+  border-top: 1px solid var(--line);
+}
+
+.quote-label {
+  display: block;
+  margin-block-end: 3px;
+  color: var(--muted);
+  font-size: .82rem;
+}
+
+.price {
+  margin: 0;
+  font-family: Manrope, sans-serif;
+  font-size: clamp(2rem, 3.5vw, 3rem);
+  font-weight: 700;
+  letter-spacing: -.055em;
+}
+
+.availability {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  padding-block-end: 8px;
+  color: #46614f;
+  font-size: .78rem;
+  font-weight: 600;
+}
+
+.availability span {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: #4f9f68;
+  box-shadow: 0 0 0 4px rgba(79,159,104,.12);
+}
+
+.buy-button {
+  display: flex;
+  width: 100%;
+  min-height: 56px;
+  align-items: center;
+  justify-content: space-between;
+  gap: 20px;
+  padding: 15px 20px;
+  border: 0;
+  border-radius: 12px;
+  color: #101b15;
+  background: var(--accent);
+  font-weight: 700;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 160ms ease, transform 160ms ease;
+}
+
+.buy-button:hover:not(:disabled) { background: var(--accent-strong); transform: translateY(-1px); }
+.buy-button:focus-visible { outline: 3px solid var(--forest); outline-offset: 3px; }
+.buy-button:disabled { color: #747a76; background: #e4e5df; cursor: not-allowed; }
+
+.permission-note, .purchase-status, .assurance {
+  margin: 12px 0 0;
+  color: var(--muted);
+  font-size: .78rem;
+  line-height: 1.45;
+}
+
+.purchase-status:not(:empty) {
+  padding: 10px 12px;
+  border-left: 3px solid var(--forest);
+  color: var(--ink);
+  background: #f0f2e8;
+}
+
+.assurance { text-align: center; }
+
+.result-page {
+  display: grid;
+  min-height: 100vh;
+  padding: 24px;
+  place-items: center;
+}
+
+.result-card {
+  width: min(520px, 100%);
+  padding: clamp(36px, 7vw, 64px);
+  border: 1px solid var(--line);
+  border-radius: 28px;
+  background: var(--card);
+  box-shadow: 0 24px 70px rgba(36,45,39,.10);
+}
+
+.result-card h1 { font-size: clamp(2.4rem, 7vw, 4.2rem); }
+.result-card p[role='status'] { margin-block: 20px 28px; color: var(--muted); line-height: 1.6; }
+.success-mark { display: grid; width: 54px; height: 54px; margin-block-end: 26px; place-items: center; border-radius: 50%; background: var(--accent); font-size: 1.5rem; font-weight: 700; }
+
+@media (max-width: 760px) {
+  .product-page { width: min(100% - 24px, 560px); padding-block: 20px 32px; }
+  .brand { margin-block-end: 18px; }
+  .product-card { grid-template-columns: 1fr; border-radius: 20px; }
+  .product-visual { min-height: 390px; }
+  .product-details { padding: 34px 26px 38px; }
+  .mug { width: 180px; height: 240px; }
+  .mug-handle { top: 62px; right: -70px; width: 95px; height: 135px; border-width: 22px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
+}
+
+@media (forced-colors: active) {
+  .buy-button { border: 1px solid ButtonText; }
+  .product-card { border: 1px solid CanvasText; }
+}
