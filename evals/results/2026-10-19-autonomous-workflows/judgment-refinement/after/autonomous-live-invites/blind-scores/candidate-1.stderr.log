-*{box-sizing:border-box}body{font:16px system-ui,sans-serif;background:#f5f6f8;color:#20242b;margin:0}main{max-width:780px;margin:40px auto;padding:24px;background:white;border-radius:12px}h1{margin-top:0}label{display:block;margin:12px 0}input,textarea,button{font:inherit;padding:8px}textarea{width:100%;min-height:70px}button{margin:4px;cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #476bd2;outline-offset:2px}ol{padding:0;list-style:none}li{padding:12px;border-bottom:1px solid #d8dce2;display:flex;gap:6px;align-items:center}li span{flex:1;overflow-wrap:anywhere}[role=alert]{color:#a61f1f}.overview{border:1px solid #ddd;padding:12px}
+:root {
+  color-scheme: light;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  color: #1c2430;
+  background: #f3f5f8;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  min-width: 320px;
+}
+
+main {
+  width: min(780px, calc(100% - 32px));
+  margin: 40px auto;
+  padding: clamp(20px, 4vw, 36px);
+  background: #fff;
+  border: 1px solid #e2e6ec;
+  border-radius: 16px;
+  box-shadow: 0 16px 40px rgb(26 38 58 / 8%);
+}
+
+h1,
+h2 {
+  letter-spacing: -0.02em;
+}
+
+h1 {
+  margin: 0 0 24px;
+}
+
+h2 {
+  margin: 28px 0 12px;
+  font-size: 1.15rem;
+}
+
+label {
+  display: grid;
+  gap: 8px;
+  margin: 16px 0;
+  font-weight: 650;
+}
+
+input,
+textarea,
+button {
+  font: inherit;
+}
+
+input,
+textarea {
+  width: 100%;
+  padding: 10px 12px;
+  color: inherit;
+  background: #fff;
+  border: 1px solid #aeb7c4;
+  border-radius: 8px;
+}
+
+textarea {
+  min-height: 88px;
+  resize: vertical;
+}
+
+button {
+  min-height: 42px;
+  padding: 8px 13px;
+  color: #fff;
+  background: #315ec9;
+  border: 1px solid #315ec9;
+  border-radius: 8px;
+  cursor: pointer;
+}
+
+button:hover:not(:disabled) {
+  background: #244da9;
+}
+
+button:disabled {
+  cursor: not-allowed;
+  opacity: 0.48;
+}
+
+button:focus-visible,
+input:focus-visible,
+textarea:focus-visible {
+  outline: 3px solid #86a7ff;
+  outline-offset: 2px;
+}
+
+.feedback {
+  min-height: 24px;
+  margin: 10px 0;
+}
+
+.feedback[hidden] {
+  display: none;
+}
+
+.error {
+  color: #a01818;
+}
+
+.overview {
+  margin-top: 28px;
+  padding: 18px;
+  background: #f7f9fc;
+  border: 1px solid #dce2ea;
+  border-radius: 12px;
+}
+
+.overview h2 {
+  margin-top: 0;
+}
+
+ol {
+  margin: 0;
+  padding: 0;
+  overflow: hidden;
+  list-style: none;
+  border: 1px solid #dce2ea;
+  border-radius: 12px;
+}
+
+li {
+  display: flex;
+  gap: 16px;
+  align-items: center;
+  padding: 14px;
+  border-bottom: 1px solid #e5e9ef;
+}
+
+li:last-child {
+  border-bottom: 0;
+}
+
+.invite-details {
+  display: grid;
+  flex: 1;
+  gap: 3px;
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+.invite-details small {
+  color: #657083;
+  text-transform: capitalize;
+}
+
+.row-actions {
+  display: flex;
+  gap: 8px;
+}
+
+.row-actions button,
+.overview button {
+  color: #25324a;
+  background: #fff;
+  border-color: #aeb7c4;
+}
+
+.row-actions button:hover:not(:disabled),
+.overview button:hover:not(:disabled) {
+  background: #eef2f8;
+}
+
+@media (max-width: 600px) {
+  main {
+    width: 100%;
+    margin: 0;
+    border: 0;
+    border-radius: 0;
+    box-shadow: none;
+  }
+
+  li {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .row-actions button {
+    flex: 1;
+  }
+}
+
+@media (forced-colors: active) {
+  main,
+  .overview,
+  ol {
+    border: 1px solid CanvasText;
+  }
+}
diff --git a/tests/invites.additional.spec.mjs b/tests/invites.additional.spec.mjs
new file mode 100644
index 0000000..735e510
--- /dev/null
+++ b/tests/invites.additional.spec.mjs
@@ -0,0 +1,89 @@
+import { expect, test } from '@playwright/test';
+
+const invitationRows = page =>
+  page.getByRole('list', { name: 'Invitations' }).locator('[data-invite-id]');
+
+test('an accepted invitation survives a failed overview refresh', async ({ page }) => {
+  await page.route('**/api/invitations', route => route.fulfill({
+    json: {
+      invitation: { id: 'new-2', email: 'grace@example.test', state: 'pending' },
+      receipt: { id: 'receipt-2', acceptedAt: 1730000000000 },
+    },
+  }));
+  await page.route('**/api/overview', route => route.fulfill({ status: 503 }));
+
+  await page.goto('/');
+  await page.getByRole('textbox', { name: 'Email', exact: true }).fill('grace@example.test');
+  await page.getByRole('button', { name: 'Send invitation', exact: true }).click();
+
+  await expect(page.getByRole('status')).toContainText('grace@example.test');
+  await expect(page.locator('[data-invite-id="new-2"]')).toContainText('grace@example.test');
+  await expect(page.getByRole('alert')).toContainText('Overview is temporarily unavailable');
+  await expect(page.getByRole('button', { name: 'Refresh overview' })).toBeEnabled();
+});
+
+test('send completion preserves edits made while the request is pending', async ({ page }) => {
+  let finishRequest;
+  const requestCanFinish = new Promise(resolve => {
+    finishRequest = resolve;
+  });
+
+  await page.route('**/api/invitations', async route => {
+    const { email } = route.request().postDataJSON();
+    await requestCanFinish;
+    await route.fulfill({
+      json: {
+        invitation: { id: 'new-3', email, state: 'pending' },
+        receipt: { id: 'receipt-3', acceptedAt: 1730000000000 },
+      },
+    });
+  });
+  await page.route('**/api/overview', route => route.fulfill({ json: { pending: 5 } }));
+
+  await page.goto('/');
+  const email = page.getByRole('textbox', { name: 'Email', exact: true });
+  const note = page.getByRole('textbox', { name: 'Team note', exact: true });
+  await email.fill('ada@example.test');
+  await page.getByRole('button', { name: 'Send invitation', exact: true }).click();
+  await email.fill('next@example.test');
+  await note.fill('Ask about timezone');
+  finishRequest();
+
+  await expect(page.getByRole('status')).toContainText('ada@example.test');
+  await expect(email).toHaveValue('next@example.test');
+  await expect(note).toHaveValue('Ask about timezone');
+  await expect(note).toBeFocused();
+});
+
+test('repeated keyboard moves keep focus on the same invitation action', async ({ page }) => {
+  await page.goto('/');
+  const moveLater = page
+    .locator('[data-invite-id="mia"]')
+    .getByRole('button', { name: 'Move later', exact: true });
+
+  await moveLater.focus();
+  await page.keyboard.press('Enter');
+  await expect(moveLater).toBeFocused();
+  await page.keyboard.press('Enter');
+
+  await expect(moveLater).toBeFocused();
+  expect(await invitationRows(page).evaluateAll(nodes => nodes.map(node => node.dataset.inviteId)))
+    .toEqual(['tom', 'zoe', 'mia', 'lee']);
+});
+
+test('a rejected send keeps drafts and offers a retry', async ({ page }) => {
+  await page.route('**/api/invitations', route => route.fulfill({ status: 500 }));
+  await page.goto('/');
+
+  const email = page.getByRole('textbox', { name: 'Email', exact: true });
+  const note = page.getByRole('textbox', { name: 'Team note', exact: true });
+  await email.fill('retry@example.test');
+  await note.fill('Keep this note');
+  await page.getByRole('button', { name: 'Send invitation', exact: true }).click();
+
+  await expect(page.getByRole('alert')).toContainText('could not be sent');
+  await expect(email).toHaveValue('retry@example.test');
+  await expect(note).toHaveValue('Keep this note');
+  await expect(page.getByRole('button', { name: 'Send invitation', exact: true })).toBeEnabled();
+  await expect(invitationRows(page)).toHaveCount(4);
+});


