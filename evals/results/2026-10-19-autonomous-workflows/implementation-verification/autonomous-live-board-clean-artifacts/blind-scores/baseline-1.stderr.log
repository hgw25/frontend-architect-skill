+  if (failure) {
+    if (desiredRevision > revision) {
+      void persistLatest();
+    } else {
+      failedRevision = revision;
+      showSaveError(failure);
+    }
+    return;
+  }
+
+  if (desiredRevision > revision) {
+    void persistLatest();
+  } else {
+    showSaved();
+  }
+}
