-body{font:16px system-ui;margin:1rem}ol{list-style:none;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}li{border:1px solid #777;padding:1rem;background:#fafafa}button{margin:.2rem;min-height:2rem}p{overflow-wrap:anywhere}
+body {
+  margin: 1rem;
+  font: 16px system-ui, sans-serif;
+}
+
+button {
+  min-height: 2rem;
+  margin: 0.2rem;
+}
+
+.save-status {
+  display: inline-block;
+  min-width: 5rem;
+  margin: 0 0.75rem;
+}
+
+.save-error {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  color: #9b1c1c;
+}
+
+ol {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 1rem;
+  padding: 0;
+  list-style: none;
+}
+
+li {
+  position: relative;
+  padding: 1rem;
+  border: 1px solid #777;
+  background: #fafafa;
+}
+
+li.dragging {
+  opacity: 0.65;
+}
+
+li.drop-target {
+  outline: 3px solid #3568d4;
+  outline-offset: 2px;
+}
+
+.card-actions {
+  display: flex;
+  flex-wrap: wrap;
+}
+
+.drag-handle {
+  cursor: grab;
+  touch-action: none;
+}
+
+.drag-handle:active {
+  cursor: grabbing;
+}
+
+p {
+  overflow-wrap: anywhere;
+}
+
+@media (max-width: 760px) {
+  ol {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  li {
+    animation: none;
+  }
+}


