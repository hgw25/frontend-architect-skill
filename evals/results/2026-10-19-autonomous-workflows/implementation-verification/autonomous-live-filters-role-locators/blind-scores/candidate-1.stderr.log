-:root{font:16px system-ui;color:#17212b;background:#f5f7fa}body{margin:0}main{padding:1rem;max-width:64rem;margin:auto}nav{display:flex;gap:1rem}form{display:flex;gap:1rem;padding:1rem;background:white}label{display:flex;flex-direction:column}input,select,button{font:inherit;padding:.5rem}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #1266be;outline-offset:2px}li{padding:.4rem}
+:root {
+  font: 16px system-ui;
+  color: #17212b;
+  background: #f5f7fa;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+}
+
+main {
+  max-width: 64rem;
+  margin: auto;
+  padding: 1rem;
+  overflow-wrap: anywhere;
+}
+
+nav {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 1rem;
+}
+
+form {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
+  align-items: end;
+  gap: 1rem;
+  padding: 1rem;
+  background: white;
+}
+
+label {
+  display: flex;
+  min-width: 0;
+  flex-direction: column;
+  gap: .25rem;
+}
+
+input,
+select,
+button {
+  min-width: 0;
+  max-width: 100%;
+  padding: .5rem;
+  font: inherit;
+}
+
+button:focus-visible,
+input:focus-visible,
+select:focus-visible,
+a:focus-visible {
+  outline: 3px solid #1266be;
+  outline-offset: 2px;
+}
+
+.filter-message:empty {
+  display: none;
+}
+
+.filter-message:not(:empty) {
+  padding: .75rem;
+  border-inline-start: .25rem solid #b42318;
+  background: #fff0ee;
+}
+
+li {
+  padding: .4rem;
+}
diff --git a/tests/filter-contracts.node.mjs b/tests/filter-contracts.node.mjs
new file mode 100644
index 0000000..24f9597
--- /dev/null
+++ b/tests/filter-contracts.node.mjs
@@ -0,0 +1,53 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  defaultOrderFilters,
+  productFiltersFromUrl,
+  urlWithProductFilters,
+  urlWithOrderFilters,
+  validateOrderFilters,
+} from '../src/filters.mjs';
+
+test('product URL distinguishes its default status from explicit all statuses', () => {
+  const initial = new URL('http://example.test/?page=products&utm=keep');
+  assert.deepEqual(productFiltersFromUrl(initial), {
+    q: '', category: '', status: 'published',
+  });
+
+  const updated = urlWithProductFilters(initial, {
+    q: 'Tea', category: 'food', status: '',
+  });
+  assert.equal(updated.searchParams.get('utm'), 'keep');
+  assert.equal(updated.searchParams.get('p_q'), 'Tea');
+  assert.equal(updated.searchParams.get('p_category'), 'food');
+  assert.equal(updated.searchParams.get('p_status'), '');
+  assert.equal(productFiltersFromUrl(updated).status, '');
+});
+
+test('order defaults and validation follow the fixed project calendar', () => {
+  assert.deepEqual(defaultOrderFilters(), {
+    q: '', status: '', from: '2026-09-20', to: '2026-10-19',
+  });
+  assert.match(
+    validateOrderFilters({ q: '', status: '', from: '2026-10-20', to: '2026-10-19' }),
+    /before/i,
+  );
+  assert.match(
+    validateOrderFilters({ q: '', status: '', from: '', to: '2026-10-19' }),
+    /date/i,
+  );
+  assert.equal(
+    validateOrderFilters({ q: '', status: '', from: '2026-10-19', to: '2026-10-19' }),
+    null,
+  );
+});
+
+test('order URL updates retain parameters outside the order contract', () => {
+  const updated = urlWithOrderFilters(
+    new URL('http://example.test/?page=orders&utm=keep'),
+    { q: 'Alice', status: 'paid', from: '2026-10-01', to: '2026-10-19' },
+  );
+  assert.equal(updated.searchParams.get('utm'), 'keep');
+  assert.equal(updated.searchParams.get('o_q'), 'Alice');
+  assert.equal(updated.searchParams.get('o_status'), 'paid');
+});


