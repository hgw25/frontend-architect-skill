+  async function submit() {
+    if (disposed) return;
+
+    const query = state.draft.trim();
+    if (!query) return;
+
+    state.submitted = query;
+    await run(query);
+  }
+
+  async function retry() {
+    if (disposed || !state.submitted) return;
+    await run(state.submitted);
