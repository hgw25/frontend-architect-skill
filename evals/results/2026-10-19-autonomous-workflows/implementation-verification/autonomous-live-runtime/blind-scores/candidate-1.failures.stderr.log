+:root {
+  color-scheme: light;
+  --ink: #17201c;
+  --muted: #66706a;
+  --line: #dce2de;
+  --paper: #f6f7f3;
+  --card: #ffffff;
+  --forest: #183d2f;
+  --forest-light: #dce9df;
+  --cream: #eee8d7;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  font-synthesis: none;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  min-width: 18rem;
+  color: var(--ink);
+  background:
+    radial-gradient(circle at 15% 10%, #fff 0, transparent 28rem),
+    var(--paper);
+}
+
+button,
+input {
+  font: inherit;
+}
+
+.product-shell {
+  width: min(74rem, calc(100% - 2rem));
+  min-height: 100vh;
+  margin-inline: auto;
+  padding-block: clamp(1.25rem, 4vw, 3rem) 1.5rem;
+}
+
+.brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.65rem;
+  margin-block-end: clamp(1.5rem, 5vw, 3.75rem);
+  color: var(--ink);
+  font-size: 0.8rem;
+  font-weight: 750;
+  letter-spacing: 0.12em;
+  text-decoration: none;
+  text-transform: uppercase;
+}
+
+.brand-mark {
+  display: grid;
+  width: 2rem;
+  aspect-ratio: 1;
+  place-items: center;
+  border-radius: 50%;
+  color: white;
+  background: var(--forest);
+  font-family: Georgia, serif;
+  font-size: 1rem;
+  letter-spacing: 0;
+}
+
+.product-card {
+  display: grid;
+  grid-template-columns: minmax(18rem, 1.05fr) minmax(20rem, 0.95fr);
+  overflow: hidden;
+  border: 1px solid var(--line);
+  border-radius: 1.5rem;
+  background: var(--card);
+  box-shadow: 0 1.5rem 4rem rgb(36 54 45 / 8%);
+}
+
+.product-visual {
+  position: relative;
+  display: grid;
+  min-height: 35rem;
+  padding: clamp(1.5rem, 4vw, 3rem);
+  overflow: hidden;
+  place-items: center;
+  background:
+    linear-gradient(140deg, rgb(255 255 255 / 48%), transparent 40%),
+    var(--cream);
+}
+
+.product-visual::after {
+  position: absolute;
+  right: -4rem;
+  bottom: -5rem;
+  width: 19rem;
+  aspect-ratio: 1;
+  border: 1px solid rgb(23 32 28 / 10%);
+  border-radius: 50%;
+  content: "";
+}
+
+.visual-label,
+.visual-caption {
+  position: absolute;
+  z-index: 1;
+  margin: 0;
+  color: #5d6056;
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0.17em;
+  text-transform: uppercase;
+}
+
+.visual-label {
+  inset-block-start: 2rem;
+  inset-inline-start: 2rem;
+}
+
+.visual-caption {
+  inset-block-end: 2rem;
+  inset-inline-start: 2rem;
+}
+
+.mug {
+  position: relative;
+  width: min(14rem, 55%);
+  height: 16rem;
+  border-radius: 1rem 1rem 3.1rem 3.1rem;
+  background: linear-gradient(90deg, #173e32, #2f6855 70%, #173e32);
+  box-shadow: inset -1rem 0 1.5rem rgb(0 0 0 / 18%), 0 2rem 2.5rem rgb(48 62 48 / 24%);
+  transform: rotate(-4deg);
+}
+
+.mug::before {
+  position: absolute;
+  inset: -0.45rem -0.15rem auto;
+  height: 1.1rem;
+  border-radius: 50%;
+  background: #aeb5ae;
+  box-shadow: inset 0 0.3rem 0 #dce1dc;
+  content: "";
+}
+
+.mug::after {
+  position: absolute;
+  z-index: -1;
+  inset-block-start: 3.1rem;
+  inset-inline-end: -4.2rem;
+  width: 5.1rem;
+  height: 7rem;
+  border: 1.4rem solid #255442;
+  border-inline-start-width: 0.8rem;
+  border-radius: 0 3.5rem 3.5rem 0;
+  content: "";
+}
+
+.mug span {
+  position: absolute;
+  inset: 42% auto auto 50%;
+  width: 3.25rem;
+  height: 1px;
+  background: rgb(255 255 255 / 65%);
+  transform: translateX(-50%);
+}
+
+.product-details {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  padding: clamp(2rem, 6vw, 5rem);
+}
+
+.eyebrow {
+  margin: 0 0 1rem;
+  color: #567263;
+  font-size: 0.72rem;
+  font-weight: 750;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+}
+
+h1 {
+  margin: 0;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: clamp(2.65rem, 6vw, 4.8rem);
+  font-weight: 400;
+  letter-spacing: -0.045em;
+  line-height: 0.97;
+}
+
+.description {
+  max-width: 32rem;
+  margin-block: 1.5rem 2.5rem;
+  color: var(--muted);
+  font-size: 1rem;
+  line-height: 1.7;
+}
+
+.description p {
+  margin: 0 0 0.75rem;
+}
+
+.quote-block {
+  padding-block: 1.25rem;
+  border-block: 1px solid var(--line);
+}
+
+.quote-label {
+  color: var(--muted);
+  font-size: 0.78rem;
+}
+
+.price {
+  margin: 0.25rem 0 0;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: clamp(2rem, 5vw, 3rem);
+  font-variant-numeric: tabular-nums;
+}
+
+form {
+  margin-block-start: 1.5rem;
+}
+
+.buy-button {
+  display: flex;
+  width: 100%;
+  min-height: 3.5rem;
+  align-items: center;
+  justify-content: space-between;
+  padding-inline: 1.35rem;
+  border: 1px solid var(--forest);
+  border-radius: 0.4rem;
+  color: white;
+  background: var(--forest);
+  font-weight: 720;
+  cursor: pointer;
+  transition: background-color 160ms ease, transform 160ms ease;
+}
+
+.buy-button:hover:not(:disabled) {
+  background: #245642;
+}
+
+.buy-button:active:not(:disabled) {
+  transform: translateY(1px);
+}
+
+.buy-button:focus-visible,
+.text-link:focus-visible,
+.brand:focus-visible {
+  outline: 3px solid #bc6c25;
+  outline-offset: 3px;
+}
+
+.buy-button:disabled {
+  border-color: #a7ada9;
+  color: #5e6661;
+  background: #dfe2df;
+  cursor: not-allowed;
+}
+
+.permission-note,
+.purchase-status {
+  margin: 0.75rem 0 0;
+  color: var(--muted);
+  font-size: 0.76rem;
+  line-height: 1.5;
+}
+
+.purchase-status {
+  min-height: 1.2rem;
+  font-weight: 700;
+}
+
+.purchase-status[data-kind="success"] {
+  color: #267147;
+}
+
+.purchase-status[data-kind="error"] {
+  color: #a33c2d;
+}
+
+footer {
+  padding-block-start: 1rem;
+  color: #7b837e;
+  font-size: 0.7rem;
+  text-align: center;
+}
+
+.message-page {
+  display: grid;
+  min-height: 100vh;
+  padding: 1.5rem;
+  place-items: center;
+}
+
+.notice-card {
+  width: min(32rem, 100%);
+  padding: clamp(2rem, 7vw, 4rem);
+  border: 1px solid var(--line);
+  border-radius: 1.25rem;
+  background: var(--card);
+  box-shadow: 0 1.5rem 4rem rgb(36 54 45 / 8%);
+}
+
+.notice-card h1 {
+  font-size: clamp(2.25rem, 8vw, 4rem);
+}
+
+.notice-card p[role="status"] {
+  margin-block: 1.5rem;
+  color: var(--muted);
+  line-height: 1.6;
+}
+
+.text-link {
+  color: var(--forest);
+  font-weight: 700;
+}
+
+@media (max-width: 45rem) {
+  .product-card {
+    grid-template-columns: 1fr;
+  }
+
+  .product-visual {
+    min-height: 22rem;
+  }
+
+  .mug {
+    width: 8.5rem;
+    height: 10rem;
+  }
+
+  .mug::after {
+    inset-block-start: 2rem;
+    inset-inline-end: -2.8rem;
+    width: 3.4rem;
+    height: 4.7rem;
+    border-width: 0.9rem;
+  }
+
+  .product-details {
+    padding: 2rem 1.5rem 2.5rem;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    scroll-behavior: auto !important;
+    transition-duration: 0.01ms !important;
+  }
+}
