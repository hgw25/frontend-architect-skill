+const form = document.querySelector('form[action="/api/buy"]');
+const status = document.querySelector('[role="status"]');
+
+form?.addEventListener('submit', async event => {
+  event.preventDefault();
+  const button = form.querySelector('button[type="submit"]');
+  button.disabled = true;
+  status.textContent = 'Submitting purchase…';
+
+  try {
+    const response = await fetch(form.action, {
+      method: 'POST',
+      body: new URLSearchParams(new FormData(form)),
+      headers: { accept: 'application/json' },
+    });
+    const result = await response.json().catch(() => ({}));
+    status.textContent = response.ok ? 'Purchase accepted' : result.error || 'Purchase failed';
+  } catch {
+    status.textContent = 'Purchase failed. Please try again.';
+  } finally {
+    button.disabled = false;
+  }
+});
diff --git a/src/style.css b/src/style.css
new file mode 100644
index 0000000..5984ca8
--- /dev/null
+++ b/src/style.css
@@ -0,0 +1,133 @@
+:root {
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  color: #17211b;
+  background: #f2f4ef;
+  font-synthesis: none;
+}
+
+* { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  min-width: 320px;
+}
+
+.product-shell {
+  min-height: 100vh;
+  display: grid;
+  place-items: center;
+  padding: 48px 24px;
+}
+
+.product-card {
+  width: min(920px, 100%);
+  display: grid;
+  grid-template-columns: minmax(280px, .9fr) minmax(320px, 1.1fr);
+  overflow: hidden;
+  border: 1px solid #d9ddd4;
+  border-radius: 28px;
+  background: #fff;
+  box-shadow: 0 28px 70px rgb(42 54 46 / 12%);
+}
+
+.product-visual {
+  min-height: 510px;
+  padding: 34px;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  color: #eef4ec;
+  background: linear-gradient(145deg, #263c31, #637665);
+}
+
+.product-mark {
+  align-self: center;
+  margin: auto;
+  display: grid;
+  place-items: center;
+  width: 190px;
+  aspect-ratio: 1;
+  border: 1px solid rgb(255 255 255 / 38%);
+  border-radius: 50%;
+  font: 300 76px/1 Georgia, serif;
+  box-shadow: inset 0 0 0 18px rgb(255 255 255 / 5%);
+}
+
+.visual-caption,
+.eyebrow {
+  text-transform: uppercase;
+  letter-spacing: .14em;
+  font-size: 12px;
+  font-weight: 700;
+}
+
+.product-copy {
+  align-self: center;
+  padding: 64px clamp(32px, 7vw, 76px);
+}
+
+.eyebrow { color: #718074; }
+
+h1 {
+  margin: 14px 0 10px;
+  font: 500 clamp(38px, 5vw, 58px)/1.05 Georgia, serif;
+  letter-spacing: -.03em;
+}
+
+.price {
+  margin: 0 0 32px;
+  color: #355844;
+  font-size: 26px;
+  font-weight: 750;
+}
+
+.description {
+  min-height: 64px;
+  margin-bottom: 30px;
+  color: #56615a;
+  font-size: 16px;
+  line-height: 1.7;
+}
+
+.description p:first-child { margin-top: 0; }
+
+button {
+  width: 100%;
+  min-height: 52px;
+  border: 0;
+  border-radius: 13px;
+  color: #fff;
+  background: #193f2b;
+  font: inherit;
+  font-weight: 750;
+  cursor: pointer;
+  transition: transform 150ms ease, background 150ms ease;
+}
+
+button:hover:not(:disabled) { background: #285a3e; }
+button:active:not(:disabled) { transform: translateY(1px); }
+button:focus-visible { outline: 3px solid #91b89f; outline-offset: 3px; }
+button:disabled { cursor: not-allowed; opacity: .45; }
+
+.note,
+.status {
+  margin: 14px 0 0;
+  min-height: 24px;
+  color: #657069;
+  font-size: 14px;
+  line-height: 1.5;
+}
+
+.status { color: #285a3e; font-weight: 650; }
+
+@media (max-width: 720px) {
+  .product-shell { padding: 20px 14px; place-items: start center; }
+  .product-card { grid-template-columns: 1fr; border-radius: 20px; }
+  .product-visual { min-height: 220px; }
+  .product-mark { width: 120px; font-size: 48px; }
+  .product-copy { padding: 38px 28px 32px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  button { transition: none; }
+}
