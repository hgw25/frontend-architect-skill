+  font-synthesis: none;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  min-width: 18rem;
+  color: var(--ink);
+  background:
+    radial-gradient(circle at 15% 10%, #fff 0, transparent 28rem),
+    var(--paper);
+}
+
+button,
+input {
+  font: inherit;
+}
+
+.product-shell {
+  width: min(74rem, calc(100% - 2rem));
+  min-height: 100vh;
