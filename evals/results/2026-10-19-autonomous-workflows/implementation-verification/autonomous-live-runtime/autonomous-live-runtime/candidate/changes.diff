+h1 {
+  margin: 0;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: clamp(2.65rem, 6vw, 4.8rem);
+  font-weight: 400;
+  letter-spacing: -0.045em;
+  line-height: 0.97;
+}
+
+.description {
+  max-width: 32rem;
+  margin-block: 1.5rem 2.5rem;
+  color: var(--muted);
+  font-size: 1rem;
+  line-height: 1.7;
+}
+
+.description p {
+  margin: 0 0 0.75rem;
+}
+
+.quote-block {
+  padding-block: 1.25rem;
+  border-block: 1px solid var(--line);
+}
+
+.quote-label {
+  color: var(--muted);
+  font-size: 0.78rem;
+}
+
+.price {
+  margin: 0.25rem 0 0;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: clamp(2rem, 5vw, 3rem);
+  font-variant-numeric: tabular-nums;
+}
+
+form {
+  margin-block-start: 1.5rem;
+}
+
+.buy-button {
+  display: flex;
+  width: 100%;
+  min-height: 3.5rem;
+  align-items: center;
+  justify-content: space-between;
+  padding-inline: 1.35rem;
+  border: 1px solid var(--forest);
+  border-radius: 0.4rem;
+  color: white;
+  background: var(--forest);
+  font-weight: 720;
+  cursor: pointer;
+  transition: background-color 160ms ease, transform 160ms ease;
+}
+
+.buy-button:hover:not(:disabled) {
+  background: #245642;
+}
+
+.buy-button:active:not(:disabled) {
+  transform: translateY(1px);
+}
+
+.buy-button:focus-visible,
+.text-link:focus-visible,
+.brand:focus-visible {
+  outline: 3px solid #bc6c25;
+  outline-offset: 3px;
+}
+
+.buy-button:disabled {
+  border-color: #a7ada9;
+  color: #5e6661;
+  background: #dfe2df;
+  cursor: not-allowed;
+}
+
+.permission-note,
+.purchase-status {
+  margin: 0.75rem 0 0;
+  color: var(--muted);
+  font-size: 0.76rem;
+  line-height: 1.5;
+}
+
+.purchase-status {
+  min-height: 1.2rem;
+  font-weight: 700;
+}
+
+.purchase-status[data-kind="success"] {
+  color: #267147;
+}
+
+.purchase-status[data-kind="error"] {
+  color: #a33c2d;
+}
+
+footer {
+  padding-block-start: 1rem;
+  color: #7b837e;
+  font-size: 0.7rem;
+  text-align: center;
+}
+
+.message-page {
+  display: grid;
+  min-height: 100vh;
+  padding: 1.5rem;
+  place-items: center;
+}
+
+.notice-card {
+  width: min(32rem, 100%);
+  padding: clamp(2rem, 7vw, 4rem);
+  border: 1px solid var(--line);
+  border-radius: 1.25rem;
+  background: var(--card);
+  box-shadow: 0 1.5rem 4rem rgb(36 54 45 / 8%);
+}
+
+.notice-card h1 {
+  font-size: clamp(2.25rem, 8vw, 4rem);
+}
+
+.notice-card p[role="status"] {
+  margin-block: 1.5rem;
+  color: var(--muted);
+  line-height: 1.6;
+}
+
+.text-link {
+  color: var(--forest);
+  font-weight: 700;
+}
+
+@media (max-width: 45rem) {
+  .product-card {
+    grid-template-columns: 1fr;
+  }
+
+  .product-visual {
+    min-height: 22rem;
+  }
+
+  .mug {
+    width: 8.5rem;
+    height: 10rem;
+  }
+
+  .mug::after {
+    inset-block-start: 2rem;
+    inset-inline-end: -2.8rem;
+    width: 3.4rem;
+    height: 4.7rem;
+    border-width: 0.9rem;
+  }
+
+  .product-details {
+    padding: 2rem 1.5rem 2.5rem;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    scroll-behavior: auto !important;
+    transition-duration: 0.01ms !important;
+  }
+}
