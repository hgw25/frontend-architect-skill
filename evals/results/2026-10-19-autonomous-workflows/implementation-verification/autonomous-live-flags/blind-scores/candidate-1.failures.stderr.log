+  error: unknown,
+): Error {
+  const code = getErrorCode(error)
+  const suffix = code ? ` (${code})` : ''
+  return new Error(
+    `[feature-flags] Could not ${operation} feature flag source "${sourcePath}"${suffix}.`,
+  )
