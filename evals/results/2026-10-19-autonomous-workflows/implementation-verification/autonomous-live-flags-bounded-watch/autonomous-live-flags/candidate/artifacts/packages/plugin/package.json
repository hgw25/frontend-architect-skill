{
  "name": "@frontend-architect-eval/feature-flags",
  "version": "0.0.0",
  "description": "Vite virtual module for exposing an explicit allowlist of JSON feature flags",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./virtual": {
      "types": "./dist/virtual.d.ts",
      "import": "./dist/empty.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  }
}
