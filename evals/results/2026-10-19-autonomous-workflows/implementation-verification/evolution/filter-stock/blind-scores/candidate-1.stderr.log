+++ b/test/product-stock-query.test.mjs
@@ -0,0 +1,19 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { queryProducts } from '../src/query.mjs';
+
+const publishedProducts = { q: '', category: '', status: 'published' };
+
+test('product query composes stock membership with existing filters', async () => {
+  const inStock = await queryProducts({ ...publishedProducts, stock: 'in' });
+  const outOfStock = await queryProducts({ ...publishedProducts, stock: 'out' });
+  const foodInStock = await queryProducts({
+    ...publishedProducts,
+    category: 'food',
+    stock: 'in',
+  });
+
+  assert.deepEqual(inStock.rows.map(product => product.id), ['p1']);
+  assert.deepEqual(outOfStock.rows.map(product => product.id), ['p2', 'p4']);
+  assert.deepEqual(foodInStock.rows, []);
+});
diff --git a/test/product-stock-state.test.mjs b/test/product-stock-state.test.mjs
new file mode 100644
index 0000000..2e82669
--- /dev/null
+++ b/test/product-stock-state.test.mjs
@@ -0,0 +1,21 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  PRODUCT_KEYS,
+  productDefaults,
+  parseProductFilters,
+  serializeProductFilters,
+} from '../src/filter-state.mjs';
+
+test('product stock defaults to all and is an owned URL field', () => {
+  assert.equal(productDefaults.stock, '');
+  assert.ok(PRODUCT_KEYS.includes('p_stock'));
+  assert.equal(serializeProductFilters(productDefaults).get('p_stock'), null);
+});
+
+test('product stock URL state accepts known values and rejects unknown values', () => {
+  assert.equal(parseProductFilters(new URLSearchParams('p_stock=in')).stock, 'in');
+  assert.equal(parseProductFilters(new URLSearchParams('p_stock=out')).stock, 'out');
+  assert.equal(parseProductFilters(new URLSearchParams('p_stock=unknown')).stock, '');
+  assert.equal(serializeProductFilters({ ...productDefaults, stock: 'in' }).get('p_stock'), 'in');
+});


