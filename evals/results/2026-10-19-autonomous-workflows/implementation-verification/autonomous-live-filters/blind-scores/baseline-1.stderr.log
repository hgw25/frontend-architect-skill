+
+form {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: end;
+  gap: 1rem;
+  padding: 1rem;
+  background: white;
+  border-radius: 0.375rem;
+}
+
+label {
+  display: flex;
+  flex: 1 1 10rem;
+  min-width: 0;
+  flex-direction: column;
+  gap: 0.25rem;
+}
+
+input,
+select,
+button {
+  max-width: 100%;
+  min-height: 2.75rem;
+  padding: 0.5rem;
+  font: inherit;
+}
+
+input,
+select {
+  width: 100%;
+}
+
+button:focus-visible,
+input:focus-visible,
+select:focus-visible,
+a:focus-visible {
+  outline: 3px solid #1266be;
+  outline-offset: 2px;
+}
+
+.actions {
+  display: flex;
+  flex: 0 1 auto;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+}
+
+.field-error {
+  flex-basis: 100%;
+  margin: 0;
+  color: #a31515;
+}
+
+.feedback [role='alert'] {
+  padding: 0.75rem;
+  color: #7a1010;
+  background: #fff0f0;
+  border: 1px solid #c63a3a;
+}
+
+li {
+  padding: 0.4rem;
+  overflow-wrap: anywhere;
+}
+
+@media (max-width: 32rem) {
+  label,
+  .actions {
+    flex-basis: 100%;
+  }
+
+  .actions button {
+    flex: 1 1 8rem;
+  }
+}
