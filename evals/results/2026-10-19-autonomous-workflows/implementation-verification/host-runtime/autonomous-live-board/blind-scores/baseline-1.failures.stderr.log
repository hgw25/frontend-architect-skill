-body{font:16px system-ui;margin:1rem}ol{list-style:none;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}li{border:1px solid #777;padding:1rem;background:#fafafa}button{margin:.2rem;min-height:2rem}p{overflow-wrap:anywhere}
+:root {
+  color-scheme: light dark;
+  font: 16px/1.45 system-ui, sans-serif;
+}
+
+body {
+  margin: 1rem;
+}
+
+.board-controls {
+  align-items: center;
+  display: flex;
+  gap: 0.75rem;
+  margin-bottom: 1rem;
+}
+
+.save-state {
+  align-items: center;
+  display: flex;
+  min-height: 2.4rem;
+}
+
+.save-state p {
+  margin: 0;
+}
+
+.save-state button {
+  margin-left: 0.5rem;
+}
+
+ol {
+  display: grid;
+  gap: 1rem;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+li {
+  background: Canvas;
+  border: 1px solid GrayText;
+  border-radius: 0.35rem;
+  padding: 1rem;
+  position: relative;
+  will-change: transform;
+}
+
+li.drag-target {
+  outline: 3px solid Highlight;
+  outline-offset: 2px;
+}
+
+li.is-dragging {
+  opacity: 0.55;
+}
+
+h2 {
+  font-size: 1.1rem;
+  margin: 0 0 0.5rem;
+}
+
+li > p {
+  overflow-wrap: anywhere;
+}
+
+.card-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.4rem;
+}
+
+button {
+  min-height: 2rem;
+}
+
+.drag-handle {
+  cursor: grab;
+  touch-action: none;
+}
+
+.drag-handle:active {
+  cursor: grabbing;
+}
+
+@media (max-width: 760px) {
+  ol {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  li {
+    will-change: auto;
+  }
+}


