+const supportedLocales = ['en-US', 'fr-FR'] as const
+type SupportedLocale = (typeof supportedLocales)[number]
+
+type SearchState = {
+  query: string
+  page: number
+  locale: SupportedLocale
+}
+
+const messages = {
+  'en-US': {
+    title: 'Product search',
+    searchLabel: 'Search',
+    searchButton: 'Search',
+    localeLabel: 'Language',
+    error: 'Search failed',
+    results: {
+      one: '{count} result',
+      other: '{count} results',
+    },
+  },
+  'fr-FR': {
+    title: 'Recherche de produits',
+    searchLabel: 'Recherche',
+    searchButton: 'Rechercher',
+    localeLabel: 'Langue',
+    error: 'La recherche a échoué',
+    results: {
+      one: '{count} résultat',
+      other: '{count} résultats',
+    },
+  },
+} satisfies Record<
+  SupportedLocale,
+  {
+    title: string
+    searchLabel: string
+    searchButton: string
+    localeLabel: string
+    error: string
+    results: Partial<Record<Intl.LDMLPluralRule, string>> & { other: string }
+  }
+>
+
+function isSupportedLocale(value: string | null): value is SupportedLocale {
+  return supportedLocales.includes((value ?? '') as SupportedLocale)
+}
+
+function parsePage(value: string | null) {
+  const parsed = Number.parseInt(value ?? '', 10)
+  return Number.isFinite(parsed) && parsed > 0 ? parsed : 1
+}
+
+function readUrlState(): SearchState {
+  const params = new URLSearchParams(window.location.search)
+  const localeParam = params.get('locale')
+  return {
+    query: params.get('q') ?? '',
+    page: parsePage(params.get('page')),
+    locale: isSupportedLocale(localeParam) ? localeParam : 'en-US',
+  }
+}
+
+function writeUrlState(state: SearchState, mode: 'push' | 'replace' = 'push') {
+  const params = new URLSearchParams()
+  if (state.query) {
+    params.set('q', state.query)
+  }
+  params.set('page', String(state.page))
+  params.set('locale', state.locale)
+
+  const url = `${window.location.pathname}?${params.toString()}`
+  const method = mode === 'replace' ? history.replaceState : history.pushState
+  method.call(history, null, '', url)
+}
+
+function formatMessage(template: string, values: Record<string, string | number>) {
+  return Object.entries(values).reduce(
+    (message, [key, value]) => message.replace(`{${key}}`, String(value)),
+    template,
+  )
+}
+
+function createCurrencyFormatter(localeValue: SupportedLocale) {
+  return new Intl.NumberFormat(localeValue, {
+    style: 'currency',
+    currency: localeValue === 'fr-FR' ? 'EUR' : 'USD',
+  })
+}
+
+function createPluralRules(localeValue: SupportedLocale) {
+  return new Intl.PluralRules(localeValue)
+}
+
+const initialState = readUrlState()
+const query = ref(initialState.query)
+const page = ref(initialState.page)
+const locale = ref<SupportedLocale>(initialState.locale)
 const results = ref<SearchResult[]>([])
 const total = ref(0)
 const error = ref('')
+let requestId = 0
+let activeController: AbortController | null = null
+
+const copy = computed(() => messages[locale.value])
+const pluralRules = computed(() => createPluralRules(locale.value))
+const currencyFormatter = computed(() => createCurrencyFormatter(locale.value))
+const totalLabel = computed(() => {
+  const rule = pluralRules.value.select(total.value)
+  const template = (copy.value.results as Partial<Record<Intl.LDMLPluralRule, string>> & {
+    other: string
+  })[rule] ?? copy.value.results.other
+  return formatMessage(template, {
+    count: total.value,
+  })
+})
+
+function applyState(nextState: SearchState) {
+  query.value = nextState.query
+  page.value = nextState.page
+  locale.value = nextState.locale
+}
+
+function syncDocumentLanguage() {
+  document.documentElement.lang = locale.value
+}
 
 async function search() {
