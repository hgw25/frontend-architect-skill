 /** Existing form submission entry point. */
 export async function processForm(fields, values, send) {
-  const eligible = fields.filter(field => !field.disabled);
+  const snapshot = Object.fromEntries(
+    Reflect.ownKeys(values).map(key => [key, values[key]]),
+  );
+  const eligible = fields.filter(field =>
+    !field.disabled && (!field.enabledWhen || field.enabledWhen(snapshot) === true));
   const errors = {};
   for (const field of eligible) {
-    const value = Object.hasOwn(values, field.name) ? values[field.name] : undefined;
+    const value = Object.hasOwn(snapshot, field.name) ? snapshot[field.name] : undefined;
     let error;
     if (field.required && (value === undefined || value === null || value === '')) {
       error = 'Required';
     } else if (field.validate) {
-      error = await field.validate(value, values);
+      error = await field.validate(value, snapshot);
     }
     if (error) Object.defineProperty(errors, field.name, { value: error, enumerable: true });
   }
   if (Object.keys(errors).length) return { errors };
   return send(Object.fromEntries(eligible.map(field => [field.name,
-    Object.hasOwn(values, field.name) ? values[field.name] : undefined])));
+    Object.hasOwn(snapshot, field.name) ? snapshot[field.name] : undefined])));
 }
diff --git a/test/conditional-fields-contract.test.js b/test/conditional-fields-contract.test.js
new file mode 100644
index 0000000..711758c
--- /dev/null
+++ b/test/conditional-fields-contract.test.js
@@ -0,0 +1,31 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { processForm } from '../src/process-form.js';
+
+test('a conditional field participates only when its predicate returns true', async () => {
+  const fields = [{ name: 'conditional', enabledWhen: () => 1, required: true }];
+
+  assert.deepEqual(await processForm(fields, { conditional: '' }, payload => payload), {});
+});
+
+test('the submission snapshot retains non-enumerable own field values', async () => {
+  const values = {};
+  Object.defineProperty(values, 'token', { value: 'captured', enumerable: false });
+  let predicateSnapshot;
+
+  const result = await processForm([
+    {
+      name: 'token',
+      enabledWhen(snapshot) {
+        predicateSnapshot = snapshot;
+        return true;
+      },
+      validate(value, snapshot) {
+        assert.equal(value, 'captured');
+        assert.equal(snapshot, predicateSnapshot);
+      },
+    },
+  ], values, payload => payload);
+
+  assert.deepEqual(result, { token: 'captured' });
+});
