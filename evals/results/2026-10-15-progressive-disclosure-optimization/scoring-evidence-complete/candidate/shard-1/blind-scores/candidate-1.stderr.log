gth === 0) return { kind: 'empty' };\n\n  const blockedIds = rows\n    .filter((row) => row.status !== 'ready')\n    .map((row) => row.id);\n\n  if (blockedIds.length > 0) return { kind: 'blocked', ids: blockedIds };\n  return { kind: 'ready', ids: rows.map((row) => row.id) };\n}\n\nfunction createExportRequest(ids) {\n  return { schema: 1, document_ids: ids };\n}\n\nexport async function exportSelection(rows, write) {\n  const decision = decideSelectionExport(rows);\n  if (decision.kind !== 'ready') return decision;\n\n  await write(createExportRequest(decision.ids));\n  return { kind: 'sent', ids: decision.ids };\n}\n"}, {"command": "/bin/zsh -lc 'git diff --check'", "exit_code": 0, "kind": "executed check", "output_tail": ""}, {"command": "/bin/zsh -lc 'node --test test/export.test.mjs'", "exit_code": 0, "kind": "executed check", "output_tail": "TAP version 13\n# Subtest: toolbar: empty does not write\nok 1 - toolbar: empty does not write\n  ---\n  duration_ms: 0.867625\n  type: 'test'\n  ...\n# Subtest: toolbar: ineligible selection is all-or-nothing\nok 2 - toolbar: ineligible selection is all-or-nothing\n  ---\n  duration_ms: 0.134125\n  type: 'test'\n  ...\n# Subtest: toolbar: ready selection writes the owned protocol once in selection order\nok 3 - toolbar: ready selection writes the owned protocol once in selection order\n  ---\n  duration_ms: 0.123459\n  type: 'test'\n  ...\n# Subtest: toolbar: transport errors retain their meaning\nok 4 - toolbar: transport errors retain their meaning\n  ---\n  duration_ms: 0.359042\n  type: 'test'\n  ...\n# Subtest: toolbar: accepted intent does not drift during a pending write\nok 5 - toolbar: accepted intent does not drift during a pending write\n  ---\n  duration_ms: 0.306833\n  type: 'test'\n  ...\n# Subtest: keyboard: empty does not write\nok 6 - keyboard: empty does not write\n  ---\n  duration_ms: 0.127916\n  type: 'test'\n  ...\n# Subtest: keyboard: ineligible selection is all-or-nothing\nok 7 - keyboard: ineligi