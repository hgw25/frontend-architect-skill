+    else if (ref) ref.current = value
+  }
+}
+
+export type DialogTriggerProps = ButtonHTMLAttributes<HTMLButtonElement>
+
+export const DialogTrigger = forwardRef<HTMLButtonElement, DialogTriggerProps>(
+  function DialogTrigger({ onClick, type = 'button', ...props }, forwardedRef) {
+    const { contentId, open, setOpen, triggerRef } =
+      useDialogContext('Dialog.Trigger')
+
+    return (
+      <button
+        {...props}
+        aria-controls={contentId}
+        aria-expanded={open}
+        aria-haspopup="dialog"
+        onClick={(event) => {
+          onClick?.(event)
+          if (!event.defaultPrevented) setOpen(true)
+        }}
+        ref={(node) => setRefs(node, triggerRef, forwardedRef)}
+        type={type}
+      />
+    )
+  },
+)
+
+export type DialogPortalProps = {
+  children: ReactNode
+  container?: HTMLElement | null
+}
+
+export function DialogPortal({ children, container }: DialogPortalProps) {
+  const { open } = useDialogContext('Dialog.Portal')
+  const [portalNode, setPortalNode] = useState<HTMLElement | null>(null)
+
+  useEffect(() => {
+    if (!open) return
+
+    const target = container ?? document.body
+    const node = target.ownerDocument.createElement('div')
+    node.dataset.dialogPortal = ''
+    target.appendChild(node)
+    setPortalNode(node)
+
+    return () => {
+      setPortalNode(null)
+      node.remove()
+    }
+  }, [container, open])
+
+  if (!open || !portalNode) return null
+
+  return createPortal(
+    <PortalContext.Provider value={portalNode}>
+      {children}
+    </PortalContext.Provider>,
+    portalNode,
   )
 }
+
+function useLatest<T>(value: T) {
+  const ref = useRef(value)
+  ref.current = value
+  return ref
+}
+
+export type DialogOverlayProps = HTMLAttributes<HTMLDivElement>
+
+export const DialogOverlay = forwardRef<HTMLDivElement, DialogOverlayProps>(
+  function DialogOverlay(props, ref) {
+    const { open } = useDialogContext('Dialog.Overlay')
+    if (!open) return null
+    return <div {...props} ref={ref} />
+  },
+)
+
+export type DialogContentProps = HTMLAttributes<HTMLDivElement> & {
+  finalFocusRef?: RefObject<HTMLElement | null>
+  initialFocusRef?: RefObject<HTMLElement | null>
+  onCloseAutoFocus?: (event: Event) => void
+  onEscapeKeyDown?: (event: KeyboardEvent) => void
+  onOpenAutoFocus?: (event: Event) => void
+  onPointerDownOutside?: (event: PointerEvent) => void
+}
+
+const useBrowserLayoutEffect =
+  typeof window === 'undefined' ? useEffect : useLayoutEffect
+
+export const DialogContent = forwardRef<HTMLDivElement, DialogContentProps>(
+  function DialogContent(
+    {
+      'aria-describedby': ariaDescribedBy,
+      'aria-label': ariaLabel,
+      'aria-labelledby': ariaLabelledBy,
+      finalFocusRef,
+      initialFocusRef,
+      onCloseAutoFocus,
+      onEscapeKeyDown,
+      onKeyDown,
+      onOpenAutoFocus,
+      onPointerDownOutside,
+      role = 'dialog',
+      tabIndex = -1,
+      ...props
+    },
+    forwardedRef,
+  ) {
+    const {
+      contentId,
+      descriptionId,
+      open,
+      setOpen,
+      titleId,
+      triggerRef,
+    } = useDialogContext('Dialog.Content')
+    const portalNode = useContext(PortalContext)
+    const contentRef = useRef<HTMLDivElement | null>(null)
+    const behaviorRef = useLatest({
+      finalFocusRef,
+      initialFocusRef,
+      onCloseAutoFocus,
+      onEscapeKeyDown,
+      onOpenAutoFocus,
+      onPointerDownOutside,
+      setOpen,
+    })
+
+    useBrowserLayoutEffect(() => {
+      const content = contentRef.current
+      if (!open || !content) return
+
+      const restoreTarget =
+        behaviorRef.current.finalFocusRef?.current ?? triggerRef.current
+      return mountDialogLayer({
+        content,
+        initialFocus: behaviorRef.current.initialFocusRef?.current,
+        onCloseAutoFocus: (event) =>
+          behaviorRef.current.onCloseAutoFocus?.(event),
+        onDismiss: () => behaviorRef.current.setOpen(false),
+        onEscapeKeyDown: (event) =>
+          behaviorRef.current.onEscapeKeyDown?.(event),
+        onOpenAutoFocus: (event) =>
+          behaviorRef.current.onOpenAutoFocus?.(event),
+        onPointerDownOutside: (event) =>
+          behaviorRef.current.onPointerDownOutside?.(event),
+        portal: portalNode ?? content,
+        restoreFocus: restoreTarget,
+      })
+    }, [
+      behaviorRef,
+      open,
+      portalNode,
+      triggerRef,
+    ])
+
+    if (!open) return null
+
+    return (
+      <div
+        {...props}
+        aria-describedby={ariaDescribedBy ?? descriptionId}
+        aria-label={ariaLabel}
+        aria-labelledby={ariaLabel ? ariaLabelledBy : (ariaLabelledBy ?? titleId)}
+        aria-modal="true"
+        id={contentId}
+        onKeyDown={onKeyDown}
+        ref={(node) => {
+          contentRef.current = node
+          setRefs(node, forwardedRef)
+        }}
+        role={role}
+        tabIndex={tabIndex}
+      />
+    )
+  },
+)
+
+export type DialogTitleProps = HTMLAttributes<HTMLHeadingElement>
+
+export const DialogTitle = forwardRef<HTMLHeadingElement, DialogTitleProps>(
+  function DialogTitle({ id, ...props }, ref) {
+    const { titleId } = useDialogContext('Dialog.Title')
+    return <h2 {...props} id={id ?? titleId} ref={ref} />
+  },
+)
+
+export type DialogDescriptionProps = HTMLAttributes<HTMLParagraphElement>
+
+export const DialogDescription = forwardRef<
+  HTMLParagraphElement,
+  DialogDescriptionProps
+>(function DialogDescription({ id, ...props }, ref) {
+  const { descriptionId } = useDialogContext('Dialog.Description')
+  return <p {...props} id={id ?? descriptionId} ref={ref} />
+})
+
+export type DialogCloseProps = ButtonHTMLAttributes<HTMLButtonElement>
+
+export const DialogClose = forwardRef<HTMLButtonElement, DialogCloseProps>(
+  function DialogClose({ onClick, type = 'button', ...props }, ref) {
+    const { setOpen } = useDialogContext('Dialog.Close')
+    return (
+      <button
+        {...props}
+        onClick={(event) => {
+          onClick?.(event)
+          if (!event.defaultPrevented) setOpen(false)
+        }}
+        ref={ref}
+        type={type}
+      />
+    )
+  },
+)
+
+export const Dialog = {
+  Close: DialogClose,
+  Content: DialogContent,
+  Description: DialogDescription,
+  Overlay: DialogOverlay,
+  Portal: DialogPortal,
+  Root: DialogRoot,
+  Title: DialogTitle,
+  Trigger: DialogTrigger,
+} as const
diff --git a/src/dialog-layer.ts b/src/dialog-layer.ts
new file mode 100644
index 0000000..dc90869
--- /dev/null
+++ b/src/dialog-layer.ts
@@ -0,0 +1,222 @@
+type IsolationSnapshot = {
+  ariaHidden: string | null
+  inert: boolean
+}
+
+type DialogLayer = {
+  id: symbol
+  portal: HTMLElement
+}
+
+type DialogLayerOptions = {
+  content: HTMLElement
+  initialFocus?: HTMLElement | null
+  onCloseAutoFocus?: (event: Event) => void
+  onDismiss: () => void
+  onEscapeKeyDown?: (event: KeyboardEvent) => void
+  onOpenAutoFocus?: (event: Event) => void
+  onPointerDownOutside?: (event: PointerEvent) => void
+  portal: HTMLElement
+  restoreFocus?: HTMLElement | null
+}
+
+const dialogLayers: DialogLayer[] = []
+const isolatedElements = new Map<HTMLElement, IsolationSnapshot>()
+let isolationObserver: MutationObserver | null = null
+
+function restoreIsolation() {
+  for (const [element, snapshot] of isolatedElements) {
+    if (snapshot.ariaHidden === null) element.removeAttribute('aria-hidden')
+    else element.setAttribute('aria-hidden', snapshot.ariaHidden)
+    element.inert = snapshot.inert
+  }
+  isolatedElements.clear()
+}
+
+function isolateElement(element: HTMLElement) {
+  if (isolatedElements.has(element)) return
+
+  isolatedElements.set(element, {
+    ariaHidden: element.getAttribute('aria-hidden'),
+    inert: element.inert,
+  })
+  element.setAttribute('aria-hidden', 'true')
+  element.inert = true
+}
+
+function syncIsolation() {
+  restoreIsolation()
+  const topLayer = dialogLayers.at(-1)
+  if (!topLayer?.portal.isConnected) return
+
+  let allowedElement: HTMLElement = topLayer.portal
+  let parent = allowedElement.parentElement
+
+  while (parent) {
+    for (const sibling of parent.children) {
+      if (sibling !== allowedElement && sibling instanceof HTMLElement) {
+        isolateElement(sibling)
+      }
+    }
+
+    if (parent === document.body) break
+    allowedElement = parent
+    parent = parent.parentElement
+  }
+}
+
+function registerDialogLayer(layer: DialogLayer) {
+  dialogLayers.push(layer)
+  syncIsolation()
+
+  if (!isolationObserver) {
+    isolationObserver = new MutationObserver(syncIsolation)
+    isolationObserver.observe(document.body, { childList: true, subtree: true })
+  }
+
+  return () => {
+    const index = dialogLayers.findIndex(({ id }) => id === layer.id)
+    if (index >= 0) dialogLayers.splice(index, 1)
+    syncIsolation()
+
+    if (dialogLayers.length === 0) {
+      isolationObserver?.disconnect()
+      isolationObserver = null
+    }
+  }
+}
+
+function isTopDialog(id: symbol) {
+  return dialogLayers.at(-1)?.id === id
+}
+
+const tabbableSelector = [
+  'a[href]',
+  'area[href]',
+  'button:not([disabled])',
+  'input:not([disabled]):not([type="hidden"])',
+  'select:not([disabled])',
+  'textarea:not([disabled])',
+  'iframe',
+  'object',
+  'embed',
+  '[contenteditable]:not([contenteditable="false"])',
+  '[tabindex]:not([tabindex="-1"])',
+].join(',')
+
+function getTabbableElements(content: HTMLElement) {
+  return Array.from(content.querySelectorAll<HTMLElement>(tabbableSelector)).filter(
+    (element) => {
+      const style = getComputedStyle(element)
+      return (
+        element.getClientRects().length > 0 &&
+        style.display !== 'none' &&
+        style.visibility !== 'hidden' &&
+        !element.closest('[inert], [aria-hidden="true"]')
+      )
+    },
+  )
+}
+
+function focusElement(element: HTMLElement | null | undefined) {
+  element?.focus({ preventScroll: true })
+}
+
+export function mountDialogLayer({
+  content,
+  initialFocus,
+  onCloseAutoFocus,
+  onDismiss,
+  onEscapeKeyDown,
+  onOpenAutoFocus,
+  onPointerDownOutside,
+  portal,
+  restoreFocus,
+}: DialogLayerOptions) {
+  const id = Symbol('dialog-layer')
+  const unregister = registerDialogLayer({ id, portal })
+  const openFocusEvent = new Event('dialog.openAutoFocus', { cancelable: true })
+  onOpenAutoFocus?.(openFocusEvent)
+
+  if (!openFocusEvent.defaultPrevented) {
+    const autofocusTarget = content.querySelector<HTMLElement>('[autofocus]')
+    focusElement(
+      initialFocus ??
+        autofocusTarget ??
+        getTabbableElements(content)[0] ??
+        content,
+    )
+  }
+
+  const handleKeyDown = (event: KeyboardEvent) => {
+    if (!isTopDialog(id)) return
+
+    if (event.key === 'Escape') {
+      onEscapeKeyDown?.(event)
+      if (!event.defaultPrevented) {
+        event.preventDefault()
+        event.stopPropagation()
+        onDismiss()
+      }
+      return
+    }
+
+    if (event.key !== 'Tab') return
+
+    const tabbable = getTabbableElements(content)
+    if (tabbable.length === 0) {
+      event.preventDefault()
+      focusElement(content)
+      return
+    }
+
+    const first = tabbable[0]
+    const last = tabbable[tabbable.length - 1]
+    const activeElement = content.ownerDocument.activeElement
+
+    if (
+      event.shiftKey &&
+      (activeElement === first || !content.contains(activeElement))
+    ) {
+      event.preventDefault()
+      focusElement(last)
+    } else if (
+      !event.shiftKey &&
+      (activeElement === last || !content.contains(activeElement))
+    ) {
+      event.preventDefault()
+      focusElement(first)
+    }
+  }
+
+  const handleFocusIn = (event: FocusEvent) => {
+    if (!isTopDialog(id) || content.contains(event.target as Node)) return
+    focusElement(getTabbableElements(content)[0] ?? content)
+  }
+
+  const handlePointerDown = (event: PointerEvent) => {
+    if (!isTopDialog(id) || content.contains(event.target as Node)) return
+    onPointerDownOutside?.(event)
+    if (!event.defaultPrevented) onDismiss()
+  }
+
+  const ownerDocument = content.ownerDocument
+  ownerDocument.addEventListener('keydown', handleKeyDown)
+  ownerDocument.addEventListener('focusin', handleFocusIn)
+  ownerDocument.addEventListener('pointerdown', handlePointerDown)
+
+  return () => {
+    ownerDocument.removeEventListener('keydown', handleKeyDown)
+    ownerDocument.removeEventListener('focusin', handleFocusIn)
+    ownerDocument.removeEventListener('pointerdown', handlePointerDown)
+    unregister()
+
+    const closeFocusEvent = new Event('dialog.closeAutoFocus', {
+      cancelable: true,
+    })
+    onCloseAutoFocus?.(closeFocusEvent)
+    if (!closeFocusEvent.defaultPrevented && restoreFocus?.isConnected) {
+      focusElement(restoreFocus)
+    }
+  }
+}
