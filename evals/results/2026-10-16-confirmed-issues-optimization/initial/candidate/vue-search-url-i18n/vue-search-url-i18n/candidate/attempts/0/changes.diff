diff --git a/src/search-edge-cases.test.ts b/src/search-edge-cases.test.ts
new file mode 100644
index 0000000..382315e
--- /dev/null
+++ b/src/search-edge-cases.test.ts
@@ -0,0 +1,62 @@
+import { flushPromises, mount } from '@vue/test-utils'
+import { afterEach, expect, test, vi } from 'vitest'
+
+import SearchPage from './SearchPage.vue'
+
+function response(name: string, price = 1234.5) {
+  return new Response(
+    JSON.stringify({ items: [{ id: name, name, price }], total: 1 }),
+    { status: 200, headers: { 'content-type': 'application/json' } },
+  )
+}
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+  vi.restoreAllMocks()
+})
+
+test('formats an English singular result and currency with a matching language attribute', async () => {
+  history.replaceState(null, '', '/search?q=coffee&page=1&locale=en-US')
+  vi.stubGlobal('fetch', vi.fn().mockResolvedValue(response('Coffee')))
+
+  const wrapper = mount(SearchPage)
+  await flushPromises()
+
+  expect(wrapper.get('main').attributes('lang')).toBe('en-US')
+  expect(wrapper.text()).toContain('1 result')
+  expect(wrapper.text()).toContain('$1,234.50')
+
+  wrapper.unmount()
+})
+
+test('an obsolete failure cannot publish an error or clear the current pending state', async () => {
+  history.replaceState(null, '', '/search?q=old&page=1&locale=en-US')
+  let rejectOld!: (reason?: unknown) => void
+  let resolveCurrent!: (value: Response) => void
+  const oldRequest = new Promise<Response>((_resolve, reject) => {
+    rejectOld = reject
+  })
+  const currentRequest = new Promise<Response>((resolve) => {
+    resolveCurrent = resolve
+  })
+  vi.stubGlobal(
+    'fetch',
+    vi.fn().mockReturnValueOnce(oldRequest).mockReturnValueOnce(currentRequest),
+  )
+
+  const wrapper = mount(SearchPage)
+  await wrapper.get('input[name="query"]').setValue('new')
+  await wrapper.get('form').trigger('submit')
+
+  rejectOld(new Error('obsolete failure'))
+  await flushPromises()
+
+  expect(wrapper.find('[role="alert"]').exists()).toBe(false)
+  expect(wrapper.get('[role="status"]').text()).toBe('Searching…')
+
+  resolveCurrent(response('Current result'))
+  await flushPromises()
+  expect(wrapper.text()).toContain('Current result')
+
+  wrapper.unmount()
+})
