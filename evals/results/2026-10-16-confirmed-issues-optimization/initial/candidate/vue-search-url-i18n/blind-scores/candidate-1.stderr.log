+import type { SearchLocale } from './searchState'
+
+type PluralMessage = Partial<Record<Intl.LDMLPluralRule, string>> & {
+  other: string
+}
+
+type SearchMessages = {
+  title: string
+  searchLabel: string
+  searchAction: string
+  searching: string
+  searchFailed: string
+  resultCount: PluralMessage
+  languageLabel: string
+  languageNames: Record<SearchLocale, string>
+  paginationLabel: string
+  previousPage: string
+  nextPage: string
+  currentPage: string
+  currency: string
+}
+
+const messages: Record<SearchLocale, SearchMessages> = {
+  'en-US': {
+    title: 'Product search',
+    searchLabel: 'Search',
+    searchAction: 'Search',
+    searching: 'Searching…',
+    searchFailed: 'Search failed. Please try again.',
+    resultCount: {
+      one: '{count} result',
+      other: '{count} results',
+    },
+    languageLabel: 'Language',
+    languageNames: {
+      'en-US': 'English (United States)',
+      'fr-FR': 'French (France)',
+    },
+    paginationLabel: 'Search result pages',
+    previousPage: 'Previous',
+    nextPage: 'Next',
+    currentPage: 'Page {page}',
+    currency: 'USD',
+  },
+  'fr-FR': {
+    title: 'Recherche de produits',
+    searchLabel: 'Rechercher',
+    searchAction: 'Rechercher',
+    searching: 'Recherche en cours…',
+    searchFailed: 'La recherche a échoué. Veuillez réessayer.',
+    resultCount: {
+      one: '{count} résultat',
+      other: '{count} résultats',
+    },
+    languageLabel: 'Langue',
+    languageNames: {
+      'en-US': 'Anglais (États-Unis)',
+      'fr-FR': 'Français (France)',
+    },
+    paginationLabel: 'Pages de résultats',
+    previousPage: 'Précédent',
+    nextPage: 'Suivant',
+    currentPage: 'Page {page}',
+    currency: 'EUR',
+  },
+}
+
+export function getSearchMessages(locale: SearchLocale): SearchMessages {
+  return messages[locale]
+}
+
+export function formatResultCount(locale: SearchLocale, count: number): string {
+  const pluralCategory = new Intl.PluralRules(locale).select(count)
+  const variants = messages[locale].resultCount
+  const template = variants[pluralCategory] ?? variants.other
+  const formattedCount = new Intl.NumberFormat(locale).format(count)
+  return template.replace('{count}', formattedCount)
+}
+
+export function formatPage(locale: SearchLocale, page: number): string {
+  return messages[locale].currentPage.replace(
+    '{page}',
+    new Intl.NumberFormat(locale).format(page),
+  )
+}
+
+export function formatPrice(locale: SearchLocale, price: number): string {
+  return new Intl.NumberFormat(locale, {
+    style: 'currency',
+    currency: messages[locale].currency,
+  }).format(price)
+}
diff --git a/src/searchState.ts b/src/searchState.ts
new file mode 100644
index 0000000..589ca74
--- /dev/null
+++ b/src/searchState.ts
@@ -0,0 +1,44 @@
+export const supportedLocales = ['en-US', 'fr-FR'] as const
+
+export type SearchLocale = (typeof supportedLocales)[number]
+
+export type SearchState = {
+  query: string
+  page: number
+  locale: SearchLocale
+}
+
+const defaultSearchState: SearchState = {
+  query: '',
+  page: 1,
+  locale: 'en-US',
+}
+
+function isSearchLocale(value: string | null): value is SearchLocale {
+  return supportedLocales.some((locale) => locale === value)
+}
+
+function parsePage(value: string | null): number {
+  if (value === null || !/^\d+$/.test(value)) return defaultSearchState.page
+
+  const page = Number(value)
+  return Number.isSafeInteger(page) && page >= 1 ? page : defaultSearchState.page
+}
+
+export function readSearchState(url: URL): SearchState {
+  const locale = url.searchParams.get('locale')
+
+  return {
+    query: url.searchParams.get('q') ?? defaultSearchState.query,
+    page: parsePage(url.searchParams.get('page')),
+    locale: isSearchLocale(locale) ? locale : defaultSearchState.locale,
+  }
+}
+
+export function writeSearchState(url: URL, state: SearchState): URL {
+  const nextUrl = new URL(url)
+  nextUrl.searchParams.set('q', state.query)
+  nextUrl.searchParams.set('page', String(state.page))
+  nextUrl.searchParams.set('locale', state.locale)
+  return nextUrl
+}


