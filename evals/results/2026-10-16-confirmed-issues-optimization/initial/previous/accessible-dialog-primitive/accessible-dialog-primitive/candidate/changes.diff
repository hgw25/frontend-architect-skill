+          onClick?.(event)
+          const shouldDismiss = pointerStartedOutsideRef.current && !event.defaultPrevented
+          pointerStartedOutsideRef.current = false
+          if (shouldDismiss) context.requestOpenChange(false)
+        }}
+        onPointerDown={(event) => {
+          onPointerDown?.(event)
+          pointerStartedOutsideRef.current = !event.defaultPrevented &&
+            event.button === 0 &&
+            event.target === event.currentTarget &&
+            isTopDialogLayer(event.currentTarget.ownerDocument, context.layerId)
+        }}
+        ref={forwardedRef}
+      />
+    )
+  },
+)
+
+export type DialogContentProps = Omit<HTMLAttributes<HTMLDivElement>, 'id' | 'role'> & {
+  initialFocusRef?: RefObject<HTMLElement | null>
+  onEscapeKeyDown?: (event: KeyboardEvent) => void
+}
+
+export const DialogContent = forwardRef<HTMLDivElement, DialogContentProps>(
+  function DialogContent(
+    { initialFocusRef, onEscapeKeyDown, tabIndex = -1, ...props },
+    forwardedRef,
+  ) {
+    const context = useDialogContext('Dialog.Content')
+    const surfaceRef = useRef<HTMLDivElement | null>(null)
+    const ref = useComposedRefs(forwardedRef, surfaceRef)
+    const escapeHandlerRef = useLatest(onEscapeKeyDown)
+    const explicitLabelledBy = props['aria-labelledby']
+    const explicitDescribedBy = props['aria-describedby']
+    const hasExplicitLabel = Boolean(props['aria-label'])
+    const labelledBy = explicitLabelledBy ?? (hasExplicitLabel ? undefined : context.titleMounted ? context.titleId : undefined)
+    const describedBy = explicitDescribedBy ?? (context.descriptionMounted ? context.descriptionId : undefined)
+
+    useBrowserLayoutEffect(() => {
+      const surface = surfaceRef.current
+      if (!surface || !context.open) return
+      const document = surface.ownerDocument
+      const window = document.defaultView
+      const previousFocus = context.returnFocusRef.current ?? (
+        document.activeElement instanceof HTMLElement ? document.activeElement : null
+      )
+      // StrictMode replays layout effects; keep one target for the whole open session.
+      context.returnFocusRef.current = previousFocus
+
+      if (context.restoreAnimationFrameRef.current !== null && window) {
+        window.cancelAnimationFrame(context.restoreAnimationFrameRef.current)
+        context.restoreAnimationFrameRef.current = null
+      }
+
+      const unregisterLayer = registerDialogLayer(document, {
+        id: context.layerId,
+        surface,
+      })
+
+      focusInitialElement(surface, initialFocusRef?.current)
+
+      const handleKeyDown = (event: KeyboardEvent) => {
+        if (!isTopDialogLayer(document, context.layerId)) return
+
+        if (event.key === 'Escape') {
+          escapeHandlerRef.current?.(event)
+          if (event.defaultPrevented) return
+          event.preventDefault()
+          event.stopImmediatePropagation()
+          context.requestOpenChange(false)
+        } else if (event.key === 'Tab' && !event.defaultPrevented) {
+          containTabFocus(event, surface)
+        }
+      }
+
+      const handleFocusIn = (event: FocusEvent) => {
+        if (
+          isTopDialogLayer(document, context.layerId) &&
+          event.target instanceof Node &&
+          !surface.contains(event.target)
+        ) focusInitialElement(surface, initialFocusRef?.current)
+      }
+
+      document.addEventListener('keydown', handleKeyDown)
+      document.addEventListener('focusin', handleFocusIn, true)
+
+      return () => {
+        document.removeEventListener('keydown', handleKeyDown)
+        document.removeEventListener('focusin', handleFocusIn, true)
+        unregisterLayer()
+
+        if (!window) return
+        context.restoreAnimationFrameRef.current = window.requestAnimationFrame(() => {
+          context.restoreAnimationFrameRef.current = null
+          if (context.returnFocusRef.current === previousFocus) {
+            context.returnFocusRef.current = null
+          }
+          if (previousFocus?.isConnected) previousFocus.focus({ preventScroll: true })
+        })
+      }
+    }, [
+      context.layerId,
+      context.open,
+      context.requestOpenChange,
+      context.restoreAnimationFrameRef,
+      context.returnFocusRef,
+      escapeHandlerRef,
+      initialFocusRef,
+    ])
+
+    return (
+      <div
+        {...props}
+        aria-describedby={describedBy}
+        aria-labelledby={labelledBy}
+        aria-modal="true"
+        data-state={context.open ? 'open' : 'closed'}
+        id={context.contentId}
+        ref={ref}
+        role="dialog"
+        tabIndex={tabIndex}
+      />
+    )
+  },
+)
+
+export const DialogTitle = forwardRef<HTMLHeadingElement, DialogTitleProps>(
+  function DialogTitle(props, forwardedRef) {
+    const context = useDialogContext('Dialog.Title')
+    useBrowserLayoutEffect(() => context.registerTitle(), [context.registerTitle])
+    return <h2 {...props} id={context.titleId} ref={forwardedRef} />
+  },
+)
+
+export const DialogDescription = forwardRef<HTMLParagraphElement, DialogDescriptionProps>(
+  function DialogDescription(props, forwardedRef) {
+    const context = useDialogContext('Dialog.Description')
+    useBrowserLayoutEffect(() => context.registerDescription(), [context.registerDescription])
+    return <p {...props} id={context.descriptionId} ref={forwardedRef} />
+  },
+)
+
+export const DialogClose = forwardRef<HTMLButtonElement, DialogCloseProps>(
+  function DialogClose({ onClick, type = 'button', ...props }, forwardedRef) {
+    const context = useDialogContext('Dialog.Close')
+    return (
+      <button
+        {...props}
+        onClick={(event) => {
+          onClick?.(event)
+          if (!event.defaultPrevented) context.requestOpenChange(false)
+        }}
+        ref={forwardedRef}
+        type={type}
+      />
+    )
+  },
+)
+
+export const Dialog = {
+  Close: DialogClose,
+  Content: DialogContent,
+  Description: DialogDescription,
+  Overlay: DialogOverlay,
+  Portal: DialogPortal,
+  Root: DialogRoot,
+  Title: DialogTitle,
+  Trigger: DialogTrigger,
+} as const
