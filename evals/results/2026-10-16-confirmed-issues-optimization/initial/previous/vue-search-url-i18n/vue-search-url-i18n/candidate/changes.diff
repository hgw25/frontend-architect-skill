-onMounted(search)
+function navigate(next: SearchState): void {
+  writeSearchState(next)
+  committed.value = next
+  void loadResults(next)
+}
+
+function submitSearch(): void {
+  navigate({ ...committed.value, query: draftQuery.value, page: 1 })
+}
+
+function changeLocale(event: Event): void {
+  const locale = (event.target as HTMLSelectElement).value
+  if (!isSupportedLocale(locale) || locale === committed.value.locale) return
+  navigate({ ...committed.value, locale })
+}
+
+function changePage(offset: number): void {
+  const page = Math.max(1, committed.value.page + offset)
+  if (page === committed.value.page) return
+  navigate({ ...committed.value, page })
+}
+
+function restoreFromHistory(): void {
+  const restored = readSearchState()
+  committed.value = restored
+  draftQuery.value = restored.query
+  void loadResults(restored)
+}
+
+onMounted(() => {
+  window.addEventListener('popstate', restoreFromHistory)
+  void loadResults(committed.value)
+})
+
+onBeforeUnmount(() => {
+  window.removeEventListener('popstate', restoreFromHistory)
+  activeRequest += 1
+  activeController?.abort()
+})
