+function keepTabFocusInsideDialog(
+  event: ReactKeyboardEvent<HTMLDialogElement>,
+  dialog: HTMLDialogElement,
+) {
+  if (
+    event.key !== 'Tab' ||
+    event.altKey ||
+    event.ctrlKey ||
+    event.metaKey ||
+    event.defaultPrevented
