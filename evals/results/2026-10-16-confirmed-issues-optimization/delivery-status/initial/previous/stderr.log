+    contentId: `${generatedId}-content`,
+    descriptionId: `${generatedId}-description`,
+    descriptionMounted,
+    layerId,
+    open: currentOpen,
+    registerDescription,
+    registerTitle,
+    requestOpenChange,
+    restoreAnimationFrameRef,
+    returnFocusRef,
+    titleId: `${generatedId}-title`,
+    titleMounted,
+    triggerRef,
+  }), [
+    currentOpen,
+    descriptionMounted,
+    generatedId,
+    layerId,
+    registerDescription,
+    registerTitle,
+    requestOpenChange,
