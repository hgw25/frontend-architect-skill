+      <div
+        {...props}
+        aria-describedby={describedBy}
+        aria-labelledby={labelledBy}
+        aria-modal="true"
+        data-state={context.open ? 'open' : 'closed'}
+        id={context.contentId}
+        ref={ref}
+        role="dialog"
