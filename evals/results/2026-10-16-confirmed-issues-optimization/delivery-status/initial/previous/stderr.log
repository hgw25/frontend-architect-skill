+
+export function DialogPortal({ children, container }: DialogPortalProps) {
+  const context = useDialogContext('Dialog.Portal')
+  const [hydrated, setHydrated] = useState(false)
+
+  useBrowserLayoutEffect(() => setHydrated(true), [])
