+++ b/scripts/check-dialog-file.mjs
@@ -0,0 +1,68 @@
+import assert from 'node:assert/strict'
+import { readFile } from 'node:fs/promises'
+import { resolve } from 'node:path'
+
+import { chromium, expect, firefox, webkit } from '@playwright/test'
+
+const distDirectory = resolve('dist')
+let html = await readFile(resolve(distDirectory, 'index.html'), 'utf8')
+const scriptPath = html.match(/<script[^>]+src="(.+?)"[^>]*><\/script>/)?.[1]
+const stylePath = html.match(/<link[^>]+href="(.+?)"[^>]*>/)?.[1]
+assert.ok(scriptPath && stylePath, 'The production build must contain script and style assets')
+
+const [script, style] = await Promise.all([
+  readFile(resolve(distDirectory, scriptPath), 'utf8'),
+  readFile(resolve(distDirectory, stylePath), 'utf8'),
+])
+html = html
+  .replace(/<script[^>]+src=".+?"[^>]*><\/script>/, `<script type="module">${script}</script>`)
+  .replace(/<link[^>]+href=".+?"[^>]*>/, `<style>${style}</style>`)
+
+const browserType = process.argv[2] === 'firefox'
+  ? firefox
+  : process.argv[2] === 'webkit' ? webkit : chromium
+const browser = await browserType.launch()
+try {
+  const page = await browser.newPage()
+  const runtimeErrors = []
+  page.on('console', (message) => {
+    if (message.type() === 'error') runtimeErrors.push(message.text())
+  })
+  page.on('pageerror', (error) => runtimeErrors.push(error.message))
+  await page.setContent(html, { waitUntil: 'load' })
+
+  const trigger = page.getByRole('button', { name: 'Edit profile' })
+  await trigger.click()
+  const parent = page.getByRole('dialog', { name: 'Edit profile' })
+  await expect(parent).toHaveAccessibleDescription('Update your public information.')
+  await expect(parent).toHaveAttribute('aria-modal', 'true')
+  await expect(parent.getByLabel('Name')).toBeFocused()
+
+  await page.keyboard.press('Shift+Tab')
+  await expect(parent.getByRole('button', { name: 'Close' })).toBeFocused()
+  await page.keyboard.press('Tab')
+  await expect(parent.getByLabel('Name')).toBeFocused()
+
+  const nestedTrigger = parent.getByRole('button', { name: 'Open permissions' })
+  await nestedTrigger.click()
+  const child = page.getByRole('dialog', { name: 'Permissions' })
+  await expect(parent).toHaveAttribute('inert', '')
+  await expect(child.getByRole('button', { name: 'Save permissions' })).toBeFocused()
+  await page.keyboard.press('Escape')
+  await expect(child).toBeHidden()
+  await expect(parent).not.toHaveAttribute('inert', '')
+  await expect(nestedTrigger).toBeFocused()
+
+  await page.keyboard.press('Escape')
+  await expect(parent).toBeHidden()
+  await expect(trigger).toBeFocused()
+
+  await trigger.click()
+  await page.locator('.overlay').click({ position: { x: 4, y: 4 } })
+  await expect(parent).toBeHidden()
+  await expect(trigger).toBeFocused()
+  assert.deepEqual(runtimeErrors, [])
+  console.log('Local production-build browser check passed: ARIA, focus loop, nested Escape, outside dismissal, inert state, and focus restoration.')
+} finally {
+  await browser.close()
+}
