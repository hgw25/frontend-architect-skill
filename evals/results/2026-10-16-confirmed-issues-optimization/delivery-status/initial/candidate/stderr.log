+import assert from 'node:assert/strict'
+import { access } from 'node:fs/promises'
+
+const publicModule = await import('../dist/package/dialog.js')
+
+for (const exportName of [
+  'Dialog',
+  'DialogClose',
+  'DialogContent',
+  'DialogDescription',
+  'DialogOverlay',
+  'DialogPortal',
+  'DialogRoot',
+  'DialogTitle',
+  'DialogTrigger',
+]) {
+  assert.ok(publicModule[exportName], `Missing runtime export: ${exportName}`)
+}
+
+await access(new URL('../dist/package/index.d.ts', import.meta.url))
+console.log('Package entry point and declarations are present.')
