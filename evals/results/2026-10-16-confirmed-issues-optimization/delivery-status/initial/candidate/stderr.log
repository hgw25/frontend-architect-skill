diff --git a/src/dialogLayers.ts b/src/dialogLayers.ts
new file mode 100644
index 0000000..c241036
--- /dev/null
+++ b/src/dialogLayers.ts
@@ -0,0 +1,105 @@
+type DialogLayer = {
+  content: HTMLElement
+  overlay: HTMLElement | null
+}
+
+type BlockedElementState = {
+  ariaHidden: string | null
+  inert: boolean
+}
+
+type DocumentState = {
+  blockedElements: Map<HTMLElement, BlockedElementState>
+  bodyOverflow: string
+  layers: DialogLayer[]
+}
+
+const documentStates = new WeakMap<Document, DocumentState>()
+
+function getState(document: Document) {
+  let state = documentStates.get(document)
+  if (!state) {
+    state = {
+      blockedElements: new Map(),
+      bodyOverflow: document.body.style.overflow,
+      layers: [],
+    }
+    documentStates.set(document, state)
+  }
+  return state
+}
+
+function restoreElement(element: HTMLElement, state: BlockedElementState) {
+  element.inert = state.inert
+  if (state.ariaHidden === null) {
+    element.removeAttribute('aria-hidden')
+  } else {
+    element.setAttribute('aria-hidden', state.ariaHidden)
+  }
+}
+
+function getElementsToBlock({ content, overlay }: DialogLayer) {
+  const elements = new Set<HTMLElement>()
+  let branch: HTMLElement = content
+  let parent = branch.parentElement
+
+  while (parent) {
+    for (const sibling of parent.children) {
+      if (sibling !== branch && sibling !== overlay && sibling instanceof HTMLElement) {
+        elements.add(sibling)
+      }
+    }
+    if (parent === content.ownerDocument.body) break
+    branch = parent
+    parent = branch.parentElement
+  }
+  return elements
+}
+
+function updateDocument(document: Document, state: DocumentState) {
+  const topLayer = state.layers.at(-1)
+  const elementsToBlock = topLayer ? getElementsToBlock(topLayer) : new Set<HTMLElement>()
+
+  for (const [element, originalState] of state.blockedElements) {
+    if (!elementsToBlock.has(element)) {
+      restoreElement(element, originalState)
+      state.blockedElements.delete(element)
+    }
+  }
+
+  if (!topLayer) {
+    document.body.style.overflow = state.bodyOverflow
+    documentStates.delete(document)
+    return
+  }
+
+  document.body.style.overflow = 'hidden'
+  for (const element of elementsToBlock) {
+    if (!state.blockedElements.has(element)) {
+      state.blockedElements.set(element, {
+        ariaHidden: element.getAttribute('aria-hidden'),
+        inert: element.inert,
+      })
+    }
+    element.inert = true
+    element.setAttribute('aria-hidden', 'true')
+  }
+}
+
+export function registerDialogLayer(content: HTMLElement, overlay: HTMLElement | null) {
+  const document = content.ownerDocument
+  const state = getState(document)
+  const layer = { content, overlay }
+  state.layers.push(layer)
+  updateDocument(document, state)
+
+  return () => {
+    const index = state.layers.indexOf(layer)
+    if (index !== -1) state.layers.splice(index, 1)
+    updateDocument(document, state)
+  }
+}
+
+export function isTopDialogLayer(content: HTMLElement) {
+  return documentStates.get(content.ownerDocument)?.layers.at(-1)?.content === content
+}
