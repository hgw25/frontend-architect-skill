diff --git a/src/dialog-layer.ts b/src/dialog-layer.ts
new file mode 100644
index 0000000..7ba5bb8
--- /dev/null
+++ b/src/dialog-layer.ts
@@ -0,0 +1,117 @@
+type DialogLayer = {
+  content: HTMLElement
+  portalRoot: HTMLElement
+  lastFocusedInside: HTMLElement | null
+}
+
+const layers: DialogLayer[] = []
+const isolatedElements = new Map<Element, { ariaHidden: string | null; inert?: boolean }>()
+let isolationObserver: MutationObserver | null = null
+let isolationRefreshQueued = false
+
+const focusableSelector = [
+  'a[href]',
+  'area[href]',
+  'button:not([disabled])',
+  'input:not([disabled]):not([type="hidden"])',
+  'select:not([disabled])',
+  'textarea:not([disabled])',
+  'iframe',
+  'audio[controls]',
+  'video[controls]',
+  '[contenteditable="true"]',
+  '[tabindex]:not([tabindex="-1"])',
+].join(',')
+
+function isFocusable(element: HTMLElement) {
+  if (element.closest('[hidden], [inert], [aria-hidden="true"]')) return false
+
+  const style = getComputedStyle(element)
+  return style.display !== 'none' && style.visibility !== 'hidden' && element.getClientRects().length > 0
+}
+
+export function getFocusableElements(container: HTMLElement) {
+  return Array.from(container.querySelectorAll<HTMLElement>(focusableSelector)).filter(isFocusable)
+}
+
+export function focusElement(element: HTMLElement | null) {
+  if (!element?.isConnected) return false
+  element.focus({ preventScroll: true })
+  return document.activeElement === element
+}
+
+function restoreIsolation() {
+  for (const [element, original] of isolatedElements) {
+    if (original.ariaHidden === null) element.removeAttribute('aria-hidden')
+    else element.setAttribute('aria-hidden', original.ariaHidden)
+
+    if (element instanceof HTMLElement && original.inert !== undefined) {
+      element.inert = original.inert
+    }
+  }
+  isolatedElements.clear()
+}
+
+function isolate(element: Element) {
+  if (!isolatedElements.has(element)) {
+    isolatedElements.set(element, {
+      ariaHidden: element.getAttribute('aria-hidden'),
+      inert: element instanceof HTMLElement ? element.inert : undefined,
+    })
+  }
+  element.setAttribute('aria-hidden', 'true')
+  if (element instanceof HTMLElement) element.inert = true
+}
+
+function refreshIsolation() {
+  restoreIsolation()
+
+  const topLayer = layers.at(-1)
+  if (!topLayer?.portalRoot.isConnected) return
+
+  let branch: Element = topLayer.portalRoot
+  let parent = branch.parentElement
+  while (parent) {
+    for (const sibling of parent.children) {
+      if (sibling !== branch) isolate(sibling)
+    }
+    branch = parent
+    parent = branch.parentElement
+  }
+}
+
+function queueIsolationRefresh() {
+  if (isolationRefreshQueued) return
+  isolationRefreshQueued = true
+  queueMicrotask(() => {
+    isolationRefreshQueued = false
+    refreshIsolation()
+  })
+}
+
+function updateIsolationObserver() {
+  if (layers.length > 0 && !isolationObserver) {
+    isolationObserver = new MutationObserver(queueIsolationRefresh)
+    isolationObserver.observe(document.body, { childList: true, subtree: true })
+  } else if (layers.length === 0 && isolationObserver) {
+    isolationObserver.disconnect()
+    isolationObserver = null
+  }
+}
+
+export function registerDialogLayer(layer: DialogLayer) {
+  layers.push(layer)
+  refreshIsolation()
+  updateIsolationObserver()
+
+  return () => {
+    const index = layers.indexOf(layer)
+    if (index !== -1) layers.splice(index, 1)
+    refreshIsolation()
+    updateIsolationObserver()
+  }
+}
+
+export function isTopDialog(content: HTMLElement | null) {
+  return content !== null && layers.at(-1)?.content === content
+}
