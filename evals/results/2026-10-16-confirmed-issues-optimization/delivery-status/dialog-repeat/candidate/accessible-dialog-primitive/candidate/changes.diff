 import { renderToString } from 'react-dom/server'
 import { expect, test } from 'vitest'
 
-import { Dialog } from './Dialog'
+import { Dialog } from './index'
 
 test('renders the closed primitive without accessing browser globals', () => {
   const html = renderToString(
-    <Dialog title="Example" description="Description" triggerLabel="Open">
-      <button type="button">Action</button>
-    </Dialog>,
+    <Dialog.Root>
+      <Dialog.Trigger>Open</Dialog.Trigger>
+      <Dialog.Portal>
+        <Dialog.Content>
+          <Dialog.Title>Example</Dialog.Title>
+          <Dialog.Description>Description</Dialog.Description>
+          <button type="button">Action</button>
+        </Dialog.Content>
+      </Dialog.Portal>
+    </Dialog.Root>,
   )
 
   expect(html).toContain('Open')
 })
+
+test('renders an initially open inline dialog with stable aria relationships', () => {
+  const html = renderToString(
+    <Dialog.Root defaultOpen>
+      <Dialog.Content>
+        <Dialog.Title>Example</Dialog.Title>
+        <Dialog.Description>Description</Dialog.Description>
+      </Dialog.Content>
+    </Dialog.Root>,
+  )
+
+  const labelledBy = html.match(/aria-labelledby="([^"]+)"/)?.[1]
+  const describedBy = html.match(/aria-describedby="([^"]+)"/)?.[1]
+  expect(html).toContain('role="dialog"')
+  expect(labelledBy).toBeTruthy()
+  expect(describedBy).toBeTruthy()
+  expect(html).toContain(`id="${labelledBy}"`)
+  expect(html).toContain(`id="${describedBy}"`)
+  expect(html).toContain('aria-modal="true"')
+})
