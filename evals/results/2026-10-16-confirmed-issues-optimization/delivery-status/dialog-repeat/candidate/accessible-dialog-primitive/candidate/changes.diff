+  readonly defaultPrevented: boolean
+  preventDefault: () => void
+}
+
+function createAutoFocusEvent(): DialogAutoFocusEvent {
+  let defaultPrevented = false
+  return {
+    get defaultPrevented() {
+      return defaultPrevented
+    },
+    preventDefault() {
+      defaultPrevented = true
+    },
+  }
+}
+
+export type DialogContentProps = Omit<
+  HTMLAttributes<HTMLDivElement>,
+  'aria-describedby' | 'aria-labelledby' | 'id'
+> & {
+  'aria-describedby'?: string | null
+  'aria-labelledby'?: string | null
+  finalFocusRef?: RefObject<HTMLElement | null>
+  initialFocusRef?: RefObject<HTMLElement | null>
+  onCloseAutoFocus?: (event: DialogAutoFocusEvent) => void
+  onOpenAutoFocus?: (event: DialogAutoFocusEvent) => void
+}
+
+function assignRef<T>(ref: Ref<T> | undefined, value: T | null) {
+  if (typeof ref === 'function') ref(value)
+  else if (ref) ref.current = value
+}
+
+export const DialogContent = forwardRef<HTMLDivElement, DialogContentProps>(function DialogContent(
+  {
+    'aria-describedby': ariaDescribedBy,
+    'aria-labelledby': ariaLabelledBy,
+    finalFocusRef,
+    initialFocusRef,
+    onCloseAutoFocus,
+    onKeyDown,
+    onOpenAutoFocus,
+    tabIndex = -1,
+    ...props
+  },
+  forwardedRef,
+) {
+  const { contentId, contentRef, descriptionId, open, setOpen, titleId } =
+    useDialogContext('Dialog.Content')
+  const effectVersion = useRef(0)
+  const focusOptionsRef = useRef({
+    finalFocusRef,
+    initialFocusRef,
+    onCloseAutoFocus,
+    onOpenAutoFocus,
+  })
+  focusOptionsRef.current = {
+    finalFocusRef,
+    initialFocusRef,
+    onCloseAutoFocus,
+    onOpenAutoFocus,
+  }
+
+  useBrowserLayoutEffect(() => {
+    const content = contentRef.current
+    if (!open || !content) return
+
+    const version = ++effectVersion.current
+    const previouslyFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null
+    const portalRoot = content.closest<HTMLElement>('[data-dialog-portal]') ?? content
+    const layer = { content, lastFocusedInside: null as HTMLElement | null, portalRoot }
+    const unregister = registerDialogLayer(layer)
+
+    const handleFocusIn = (event: FocusEvent) => {
+      if (!isTopDialog(content)) return
+      const target = event.target
+      if (target instanceof HTMLElement && content.contains(target)) {
+        layer.lastFocusedInside = target
+        return
+      }
+
+      const fallback =
+        (layer.lastFocusedInside?.isConnected ? layer.lastFocusedInside : null) ??
+        getFocusableElements(content)[0] ??
+        content
+      focusElement(fallback)
+    }
+
+    document.addEventListener('focusin', handleFocusIn)
+
+    const openEvent = createAutoFocusEvent()
+    focusOptionsRef.current.onOpenAutoFocus?.(openEvent)
+    if (!openEvent.defaultPrevented) {
+      const requestedInitialFocus = focusOptionsRef.current.initialFocusRef?.current
+      const initialFocus =
+        (requestedInitialFocus && content.contains(requestedInitialFocus)
+          ? requestedInitialFocus
+          : null) ??
+        content.querySelector<HTMLElement>('[autofocus]') ??
+        getFocusableElements(content)[0] ??
+        content
+      focusElement(initialFocus)
+      layer.lastFocusedInside = initialFocus
+    }
+
+    return () => {
+      document.removeEventListener('focusin', handleFocusIn)
+      unregister()
+
+      queueMicrotask(() => {
+        // React Strict Mode immediately mounts the effect again in development.
+        if (effectVersion.current !== version) return
+        const closeEvent = createAutoFocusEvent()
+        focusOptionsRef.current.onCloseAutoFocus?.(closeEvent)
+        if (!closeEvent.defaultPrevented) {
+          focusElement(focusOptionsRef.current.finalFocusRef?.current ?? previouslyFocused)
+        }
+      })
+    }
+  }, [open])
+
+  if (!open) return null
+
+  return (
+    <div
+      {...props}
+      aria-describedby={ariaDescribedBy === null ? undefined : (ariaDescribedBy ?? descriptionId)}
+      aria-labelledby={ariaLabelledBy === null ? undefined : (ariaLabelledBy ?? titleId)}
+      aria-modal="true"
+      data-state="open"
+      id={contentId}
+      onKeyDown={(event) => {
+        onKeyDown?.(event)
+        if (event.defaultPrevented || !isTopDialog(contentRef.current)) return
+
+        if (event.key === 'Escape') {
+          event.preventDefault()
+          event.stopPropagation()
+          setOpen(false, 'escape')
+          return
+        }
+
+        if (event.key !== 'Tab' || !contentRef.current) return
+        const focusable = getFocusableElements(contentRef.current)
+        if (focusable.length === 0) {
+          event.preventDefault()
+          focusElement(contentRef.current)
+          return
+        }
+
+        const first = focusable[0]
+        const last = focusable.at(-1)!
+        const active = document.activeElement
+        if (event.shiftKey && (active === first || !contentRef.current.contains(active))) {
+          event.preventDefault()
+          focusElement(last)
+        } else if (!event.shiftKey && (active === last || !contentRef.current.contains(active))) {
+          event.preventDefault()
+          focusElement(first)
+        }
+      }}
+      ref={(node) => {
+        contentRef.current = node
+        assignRef(forwardedRef, node)
+      }}
+      role="dialog"
+      tabIndex={tabIndex}
+    />
+  )
+})
+
+export type DialogTitleProps = Omit<React.HTMLAttributes<HTMLHeadingElement>, 'id'>
+
+export const DialogTitle = forwardRef<HTMLHeadingElement, DialogTitleProps>(function DialogTitle(
+  props,
+  forwardedRef,
+) {
+  const { titleId } = useDialogContext('Dialog.Title')
+  return <h2 {...props} id={titleId} ref={forwardedRef} />
+})
+
+export type DialogDescriptionProps = Omit<React.HTMLAttributes<HTMLParagraphElement>, 'id'>
+
+export const DialogDescription = forwardRef<HTMLParagraphElement, DialogDescriptionProps>(
+  function DialogDescription(props, forwardedRef) {
+    const { descriptionId } = useDialogContext('Dialog.Description')
+    return <p {...props} id={descriptionId} ref={forwardedRef} />
+  },
+)
+
+export type DialogCloseProps = React.ButtonHTMLAttributes<HTMLButtonElement>
+
+export const DialogClose = forwardRef<HTMLButtonElement, DialogCloseProps>(function DialogClose(
+  { onClick, type = 'button', ...props },
+  forwardedRef,
+) {
+  const { setOpen } = useDialogContext('Dialog.Close')
+  return (
+    <button
+      {...props}
+      onClick={(event) => {
+        onClick?.(event)
+        if (!event.defaultPrevented) setOpen(false, 'close')
+      }}
+      ref={forwardedRef}
+      type={type}
+    />
+  )
+})
+
+export const Dialog = {
+  Close: DialogClose,
+  Content: DialogContent,
+  Description: DialogDescription,
+  Overlay: DialogOverlay,
+  Portal: DialogPortal,
+  Root: DialogRoot,
+  Title: DialogTitle,
+  Trigger: DialogTrigger,
 }
