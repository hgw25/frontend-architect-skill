+import { Dialog, type DialogOpenChangeReason } from 'frontend-architect-dialog-browser-eval'
+
+const closeReason: DialogOpenChangeReason = 'close'
+
+export const packageConsumerExample = (
+  <Dialog.Root onOpenChange={(_open, details) => details.reason === closeReason}>
+    <Dialog.Trigger>Open</Dialog.Trigger>
+    <Dialog.Portal>
+      <Dialog.Overlay>
+        <Dialog.Content>
+          <Dialog.Title>Package consumer</Dialog.Title>
+          <Dialog.Description>Public declarations resolve from the package root.</Dialog.Description>
+          <Dialog.Close>Close</Dialog.Close>
+        </Dialog.Content>
+      </Dialog.Overlay>
+    </Dialog.Portal>
+  </Dialog.Root>
+)
