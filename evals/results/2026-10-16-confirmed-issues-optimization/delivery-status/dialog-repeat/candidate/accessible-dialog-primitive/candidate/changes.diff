diff --git a/scripts/check-package-exports.mjs b/scripts/check-package-exports.mjs
new file mode 100644
index 0000000..879a4de
--- /dev/null
+++ b/scripts/check-package-exports.mjs
@@ -0,0 +1,33 @@
+import assert from 'node:assert/strict'
+
+const publicApi = await import('../dist-package/index.js')
+
+for (const name of [
+  'Dialog',
+  'DialogClose',
+  'DialogContent',
+  'DialogDescription',
+  'DialogOverlay',
+  'DialogPortal',
+  'DialogRoot',
+  'DialogTitle',
+  'DialogTrigger',
+]) {
+  assert.ok(
+    ['function', 'object'].includes(typeof publicApi[name]),
+    `${name} is exported as a React component`,
+  )
+}
+
+assert.deepEqual(Object.keys(publicApi.Dialog).sort(), [
+  'Close',
+  'Content',
+  'Description',
+  'Overlay',
+  'Portal',
+  'Root',
+  'Title',
+  'Trigger',
+])
+
+console.log('Package public exports are loadable from the built ESM artifact.')
