+
+function HydrationFixture() {
+  return (
+    <Dialog defaultOpen>
+      <DialogTrigger>Open hydrated dialog</DialogTrigger>
+      <DialogPortal>
+        <DialogOverlay className="overlay">
+          <DialogContent className="dialog">
+            <DialogTitle>Hydrated example</DialogTitle>
