new file mode 100644
index 0000000..e3dd172
--- /dev/null
+++ b/src/dialog/focus-management.ts
@@ -0,0 +1,171 @@
+export type FocusScopeEntry = {
+  autoFocus?: boolean
+  content: HTMLElement
+  dialogId: symbol
+  initialFocus?: HTMLElement | null
+  isolationRoot: HTMLElement
+  onCloseAutoFocus?: (event: Event) => void
+  onEscapeKeyDown?: (event: KeyboardEvent) => void
+  restoreFocus?: HTMLElement | null
+}
+
+type IsolationSnapshot = { ariaHidden: string | null; inert: boolean }
+type DocumentState = {
+  entries: FocusScopeEntry[]
+  isolation: Map<HTMLElement, IsolationSnapshot>
+  originalOverflow: string
+}
+
+const states = new WeakMap<Document, DocumentState>()
+const tabbableSelector = [
+  'a[href]',
+  'area[href]',
+  'button:not([disabled])',
+  'input:not([disabled]):not([type="hidden"])',
+  'select:not([disabled])',
+  'textarea:not([disabled])',
+  'iframe',
+  'object',
+  'embed',
+  '[contenteditable]:not([contenteditable="false"])',
+  '[tabindex]:not([tabindex="-1"])',
+].join(',')
+
+function isVisible(element: HTMLElement) {
+  const style = element.ownerDocument.defaultView?.getComputedStyle(element)
+  return element.getClientRects().length > 0 && style?.visibility !== 'hidden'
+}
+
+function getTabbableElements(container: HTMLElement) {
+  return Array.from(container.querySelectorAll<HTMLElement>(tabbableSelector))
+    .filter(
+      (element) =>
+        element.tabIndex >= 0 &&
+        !element.matches(':disabled') &&
+        !element.closest('[inert]') &&
+        isVisible(element),
+    )
+    .sort((left, right) => {
+      if (left.tabIndex === right.tabIndex) return 0
+      if (left.tabIndex === 0) return 1
+      if (right.tabIndex === 0) return -1
+      return left.tabIndex - right.tabIndex
+    })
+}
+
+function focusInitial(entry: FocusScopeEntry) {
+  const target =
+    entry.initialFocus && entry.content.contains(entry.initialFocus) && isVisible(entry.initialFocus)
+      ? entry.initialFocus
+      : entry.content.querySelector<HTMLElement>('[autofocus]') ??
+        getTabbableElements(entry.content)[0] ??
+        entry.content
+  target.focus({ preventScroll: true })
+}
+
+function trapTab(entry: FocusScopeEntry, event: KeyboardEvent) {
+  const tabbable = getTabbableElements(entry.content)
+  if (tabbable.length === 0) {
+    event.preventDefault()
+    entry.content.focus({ preventScroll: true })
+    return
+  }
+
+  const first = tabbable[0]
+  const last = tabbable[tabbable.length - 1]
+  const active = entry.content.ownerDocument.activeElement
+  if (event.shiftKey && (active === first || !entry.content.contains(active))) {
+    event.preventDefault()
+    last.focus({ preventScroll: true })
+  } else if (!event.shiftKey && (active === last || !entry.content.contains(active))) {
+    event.preventDefault()
+    first.focus({ preventScroll: true })
+  }
+}
+
+function restoreIsolation(state: DocumentState) {
+  for (const [element, snapshot] of state.isolation) {
+    element.inert = snapshot.inert
+    if (snapshot.ariaHidden === null) element.removeAttribute('aria-hidden')
+    else element.setAttribute('aria-hidden', snapshot.ariaHidden)
+  }
+  state.isolation.clear()
+}
+
+function isolateSiblings(state: DocumentState, root: HTMLElement) {
+  restoreIsolation(state)
+  let current: HTMLElement | null = root
+  while (current?.parentElement) {
+    for (const sibling of current.parentElement.children) {
+      if (!(sibling instanceof HTMLElement) || sibling === current) continue
+      state.isolation.set(sibling, {
+        ariaHidden: sibling.getAttribute('aria-hidden'),
+        inert: sibling.inert,
+      })
+      sibling.inert = true
+      sibling.setAttribute('aria-hidden', 'true')
+    }
+    current = current.parentElement
+  }
+}
+
+function syncDocument(state: DocumentState, document: Document) {
+  const top = state.entries.at(-1)
+  if (top) {
+    document.body.style.overflow = 'hidden'
+    isolateSiblings(state, top.isolationRoot)
+  } else {
+    restoreIsolation(state)
+    document.body.style.overflow = state.originalOverflow
+  }
+}
+
+function createDocumentState(document: Document): DocumentState {
+  const state: DocumentState = {
+    entries: [],
+    isolation: new Map(),
+    originalOverflow: document.body.style.overflow,
+  }
+  document.addEventListener('keydown', (event) => {
+    const top = state.entries.at(-1)
+    if (!top) return
+    if (event.key === 'Escape') top.onEscapeKeyDown?.(event)
+    else if (event.key === 'Tab' && !event.defaultPrevented) trapTab(top, event)
+  }, true)
+  document.addEventListener('focusin', (event) => {
+    const top = state.entries.at(-1)
+    if (top && !top.content.contains(event.target as Node)) focusInitial(top)
+  }, true)
+  states.set(document, state)
+  return state
+}
+
+export function registerFocusScope(entry: FocusScopeEntry) {
+  const document = entry.content.ownerDocument
+  const state = states.get(document) ?? createDocumentState(document)
+  if (state.entries.length === 0) state.originalOverflow = document.body.style.overflow
+  state.entries.push(entry)
+  syncDocument(state, document)
+  if (entry.autoFocus !== false) focusInitial(entry)
+
+  return () => {
+    const index = state.entries.indexOf(entry)
+    if (index < 0) return
+    state.entries.splice(index, 1)
+    syncDocument(state, document)
+    document.defaultView?.requestAnimationFrame(() => {
+      if (state.entries.some((candidate) => candidate.dialogId === entry.dialogId)) return
+      const event = new Event('dialog.closeAutoFocus', { cancelable: true })
+      entry.onCloseAutoFocus?.(event)
+      const top = state.entries.at(-1)
+      if (event.defaultPrevented) return
+      if (top && entry.restoreFocus?.isConnected && top.content.contains(entry.restoreFocus)) {
+        entry.restoreFocus.focus({ preventScroll: true })
+      } else if (top) {
+        focusInitial(top)
+      } else if (entry.restoreFocus?.isConnected) {
+        entry.restoreFocus.focus({ preventScroll: true })
+      }
+    })
+  }
+}
