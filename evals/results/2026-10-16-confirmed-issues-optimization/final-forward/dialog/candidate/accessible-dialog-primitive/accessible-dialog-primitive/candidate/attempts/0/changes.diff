+import { expect, test } from '@playwright/test'
+
+import { loadBuiltApp } from './load-built-app'
+
+test('connects accessible metadata and isolates then restores the background', async ({ page }) => {
+  await loadBuiltApp(page)
+  const trigger = page.getByRole('button', { name: 'Edit profile' })
+  await trigger.click()
+
+  const dialog = page.getByRole('dialog', { name: 'Edit profile' })
+  const labelledBy = await dialog.getAttribute('aria-labelledby')
+  const describedBy = await dialog.getAttribute('aria-describedby')
+  expect(labelledBy).toBeTruthy()
+  expect(describedBy).toBeTruthy()
+  await expect(page.locator(`[id="${labelledBy}"]`)).toHaveText('Edit profile')
+  await expect(page.locator(`[id="${describedBy}"]`)).toHaveText('Update your public information.')
+  await expect(dialog).toHaveAttribute('aria-modal', 'true')
+  await expect.poll(() => page.locator('a').evaluate((link) => Boolean(link.closest('[inert]')))).toBe(true)
+  await expect.poll(() => page.evaluate(() => document.body.style.overflow)).toBe('hidden')
+
+  await page.locator('.overlay').click({ position: { x: 4, y: 4 } })
+  await expect(dialog).toBeHidden()
+  await expect(trigger).toBeFocused()
+  await expect.poll(() => page.locator('a').evaluate((link) => Boolean(link.closest('[inert]')))).toBe(false)
+  await expect.poll(() => page.evaluate(() => document.body.style.overflow)).toBe('')
+})
+
+test('lets the consumer own controlled state and reports close reasons', async ({ page }) => {
+  await loadBuiltApp(page, 'controlled')
+  const trigger = page.getByRole('button', { name: 'Open controlled dialog' })
+  await trigger.click()
+  await expect(page.getByRole('dialog', { name: 'Controlled example' })).toBeVisible()
+  await expect(page.getByLabel('Last change reason')).toHaveText('trigger')
+
+  await page.keyboard.press('Escape')
+  await expect(page.getByRole('dialog', { name: 'Controlled example' })).toBeHidden()
+  await expect(page.getByLabel('Last change reason')).toHaveText('escape-key')
+  await expect(trigger).toBeFocused()
+})
+
+test('hydrates stable trigger markup before mounting an initially open portal', async ({ page }) => {
+  await loadBuiltApp(page, 'hydration')
+
+  await expect(page.getByRole('dialog', { name: 'Hydrated example' })).toBeVisible()
+  await expect(page.getByLabel('Hydrated field')).toBeFocused()
+  await expect.poll(() => page.evaluate(() => window.__dialogHydrationErrors)).toEqual([])
+})
