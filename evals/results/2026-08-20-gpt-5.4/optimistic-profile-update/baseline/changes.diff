   )
   expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Ada')
 })
+
+test('ignores stale responses from earlier submissions', async () => {
+  const pendingRequests: Array<{
+    resolve: (response: Response) => void
+  }> = []
+
+  vi.stubGlobal(
+    'fetch',
+    vi.fn(
+      () =>
+        new Promise<Response>((resolve) => {
+          pendingRequests.push({ resolve })
+        }),
+    ),
+  )
+
+  const user = userEvent.setup()
+  render(
+    <ProfileForm profile={{ id: 'p1', displayName: 'Ada', version: 1 }} />,
+  )
+
+  await user.clear(screen.getByLabelText('Display name'))
+  await user.type(screen.getByLabelText('Display name'), 'Grace')
+  await user.click(screen.getByRole('button', { name: 'Save' }))
+
+  await user.clear(screen.getByLabelText('Display name'))
+  await user.type(screen.getByLabelText('Display name'), 'Lin')
+  await user.click(screen.getByRole('button', { name: 'Save' }))
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin')
+  expect(pendingRequests).toHaveLength(2)
+
+  pendingRequests[1].resolve(
+    new Response(JSON.stringify({ id: 'p1', displayName: 'Lin', version: 2 }), {
+      status: 200,
+      headers: { 'content-type': 'application/json' },
+    }),
+  )
+
+  expect(await screen.findByLabelText('Current profile name')).toHaveTextContent(
+    'Lin',
+  )
+
+  pendingRequests[0].resolve(
+    new Response(
+      JSON.stringify({ id: 'p1', displayName: 'Grace', version: 3 }),
+      {
+        status: 200,
+        headers: { 'content-type': 'application/json' },
+      },
+    ),
+  )
+
+  expect(screen.getByLabelText('Current profile name')).toHaveTextContent('Lin')
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+  expect((fetch as Mock).mock.calls).toHaveLength(2)
+})
