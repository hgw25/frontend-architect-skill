-import type { Plugin } from 'vite'
+import { readFile } from 'node:fs/promises'
+import { fileURLToPath } from 'node:url'
+import path from 'node:path'
+
+import type { HmrContext, Plugin, ResolvedConfig, ViteDevServer } from 'vite'
+
+const PLUGIN_NAME = 'feature-flags'
+const VIRTUAL_MODULE_ID = 'virtual:feature-flags'
+const RESOLVED_VIRTUAL_MODULE_ID = `\0${VIRTUAL_MODULE_ID}`
+
+export type FeatureFlagPrimitive = boolean | number | string
+export type FeatureFlagsRecord = Record<string, FeatureFlagPrimitive>
+
+export interface FeatureFlagsRegistry extends FeatureFlagsRecord {}
+
+export type FeatureFlagsShape = Readonly<FeatureFlagsRegistry>
+
+export interface FeatureFlagsOptions<TExpose extends readonly string[] = readonly string[]> {
+  source: string | URL
+  expose: TExpose
+  moduleId?: string
+}
+
+interface FlagsCacheEntry {
+  raw: string
+  publicFlags: FeatureFlagsRecord
+}
+
+function error(message: string): Error {
+  return new Error(`[${PLUGIN_NAME}] ${message}`)
+}
+
+function normalizeSourcePath(source: string | URL, config: ResolvedConfig): string {
+  if (source instanceof URL) {
+    return fileURLToPath(source)
+  }
+
+  if (path.isAbsolute(source)) {
+    return path.normalize(source)
+  }
+
+  return path.resolve(config.root, source)
+}
+
+function validateExpose(expose: readonly string[], sourcePath: string): void {
+  const seen = new Set<string>()
+
+  for (const flagName of expose) {
+    if (!flagName) {
+      throw error(`"expose" in ${sourcePath} cannot contain an empty flag name.`)
+    }
+
+    if (seen.has(flagName)) {
+      throw error(`"expose" contains "${flagName}" more than once for ${sourcePath}. Remove the duplicate entry.`)
+    }
+
+    seen.add(flagName)
+  }
+}
+
+function isFeatureFlagPrimitive(value: unknown): value is FeatureFlagPrimitive {
+  return typeof value === 'boolean' || typeof value === 'number' || typeof value === 'string'
+}
+
+function toModuleCode(publicFlags: FeatureFlagsRecord): string {
+  const serialized = JSON.stringify(publicFlags, null, 2)
+
+  return [
+    `const flags = Object.freeze(${serialized})`,
+    '',
+    'export { flags }',
+    'export default flags',
+    '',
+  ].join('\n')
+}
+
+function toSourceMap(sourcePath: string, raw: string, moduleId: string) {
+  return {
+    version: 3,
+    file: moduleId,
+    names: [],
+    sources: [sourcePath],
+    sourcesContent: [raw],
+    mappings: '',
+  }
+}
+
+function collectAffectedModules(server: ViteDevServer, moduleId: string) {
+  const entry = server.moduleGraph.getModuleById(moduleId)
+
+  if (!entry) {
+    return []
+  }
+
+  const affected = new Set([entry])
+  const queue = [entry]
+
+  while (queue.length > 0) {
+    const current = queue.shift()
+    if (!current) {
+      continue
+    }
+
+    for (const importer of current.importers) {
+      if (affected.has(importer)) {
+        continue
+      }
+
+      affected.add(importer)
+      queue.push(importer)
+    }
+  }
+
+  for (const mod of affected) {
+    server.moduleGraph.invalidateModule(mod)
+  }
+
+  return [...affected]
+}
+
+export function featureFlags(options: FeatureFlagsOptions): Plugin {
+  let config: ResolvedConfig | undefined
+  let sourcePath = ''
+  let cache: FlagsCacheEntry | undefined
+  const moduleId = options.moduleId ?? VIRTUAL_MODULE_ID
+  const resolvedModuleId = `\0${moduleId}`
+
+  async function loadFlags(): Promise<FlagsCacheEntry> {
+    if (!config) {
+      throw error('Vite config has not been resolved yet.')
+    }
+
+    const raw = await readFile(sourcePath, 'utf8')
+    if (cache?.raw === raw) {
+      return cache
+    }
+
+    let parsed: unknown
+    try {
+      parsed = JSON.parse(raw)
+    } catch (cause) {
+      throw error(`Failed to parse ${sourcePath} as JSON. Fix the file syntax before restarting the build.\nCause: ${String(cause)}`)
+    }
+
+    if (!parsed || Array.isArray(parsed) || typeof parsed !== 'object') {
+      throw error(`Expected ${sourcePath} to contain a JSON object of flags, but received ${Array.isArray(parsed) ? 'an array' : typeof parsed}.`)
+    }
+
+    const record = parsed as Record<string, unknown>
+    const publicFlags: FeatureFlagsRecord = {}
+
+    for (const flagName of options.expose) {
+      if (!(flagName in record)) {
+        throw error(`Flag "${flagName}" is listed in "expose" but is missing from ${sourcePath}. Add the flag or remove it from "expose".`)
+      }
+
+      const value = record[flagName]
+      if (!isFeatureFlagPrimitive(value)) {
+        throw error(
+          `Flag "${flagName}" in ${sourcePath} must be a boolean, number, or string to be exposed to the client. Received ${value === null ? 'null' : typeof value}.`,
+        )
+      }
+
+      publicFlags[flagName] = value
+    }
+
+    cache = {
+      raw,
+      publicFlags,
+    }
+
+    return cache
+  }
+
+  function clearCache(file?: string): void {
+    if (!file || path.normalize(file) === sourcePath) {
+      cache = undefined
+    }
+  }
+
+  function handleSourceChange(server: ViteDevServer): ReturnType<NonNullable<Plugin['handleHotUpdate']>> {
+    const affected = collectAffectedModules(server, resolvedModuleId)
+    if (affected.length > 0) {
+      return affected
+    }
+
+    server.ws.send({ type: 'full-reload' })
+    return []
+  }
 
-export function featureFlags(flags: Record<string, unknown>): Plugin {
   return {
-    name: 'feature-flags',
-    transform(code: string) {
-      return code.replaceAll('__FLAGS__', JSON.stringify(flags))
+    name: PLUGIN_NAME,
+    enforce: 'pre',
+    configResolved(resolvedConfig) {
+      config = resolvedConfig
+      sourcePath = normalizeSourcePath(options.source, resolvedConfig)
+      validateExpose(options.expose, sourcePath)
+    },
+    buildStart() {
+      if (!sourcePath) {
+        throw error('Failed to resolve "source". Pass an absolute path, a file URL, or a path relative to the Vite root.')
+      }
+
+      this.addWatchFile(sourcePath)
+    },
+    configureServer(server) {
+      server.watcher.add(sourcePath)
+    },
+    resolveId(id) {
+      if (id === moduleId) {
+        return resolvedModuleId
+      }
+
+      return null
+    },
+    async load(id) {
+      if (id !== resolvedModuleId) {
+        return null
+      }
+
+      const { publicFlags, raw } = await loadFlags()
+      return {
+        code: toModuleCode(publicFlags),
+        map: toSourceMap(sourcePath, raw, moduleId),
+      }
+    },
+    watchChange(id) {
+      clearCache(id)
+    },
+    handleHotUpdate(context: HmrContext) {
+      if (path.normalize(context.file) !== sourcePath) {
+        return
+      }
+
+      clearCache(context.file)
+      return handleSourceChange(context.server)
     },
   }
 }
+
+export const featureFlagsModuleId = VIRTUAL_MODULE_ID
+export const resolvedFeatureFlagsModuleId = RESOLVED_VIRTUAL_MODULE_ID
