+  return path.normalize(path.resolve(root, source))
+}
+
+function createVirtualModule(publicFlags: FeatureFlagsRecord): string {
+  const runtimeFlags = JSON.stringify(publicFlags, null, 2)
+  const runtimeKeys = JSON.stringify(Object.keys(publicFlags))
+
+  return [
+    `const store = globalThis.${RUNTIME_STORE_KEY} ??= Object.create(null);`,
+    `const state = store[${JSON.stringify(PUBLIC_MODULE_ID)}] ??= { current: Object.freeze(${runtimeFlags}), proxy: undefined };`,
+    'if (!state.proxy) {',
+    '  state.proxy = new Proxy(Object.create(null), {',
+    '    get(_target, property) {',
+    '      return state.current[property];',
+    '    },',
+    '    has(_target, property) {',
+    '      return property in state.current;',
+    '    },',
+    '    ownKeys() {',
+    '      return Reflect.ownKeys(state.current);',
+    '    },',
+    '    getOwnPropertyDescriptor(_target, property) {',
+    '      if (!(property in state.current)) return undefined;',
+    '      return {',
+    '        configurable: true,',
+    '        enumerable: true,',
+    '        value: state.current[property],',
+    '      };',
+    '    },',
+    '    set() {',
+    '      return false;',
+    '    },',
+    '  });',
+    '}',
+    `state.current = Object.freeze(${runtimeFlags});`,
+    `export const flagKeys = Object.freeze(${runtimeKeys});`,
+    'export const flags = state.proxy;',
+    'export default flags;',
+  ].join('\n')
+}
+
+function findDuplicates(values: readonly string[]): string[] {
+  const seen = new Set<string>()
+  const duplicates = new Set<string>()
+
+  for (const value of values) {
+    if (seen.has(value)) {
+      duplicates.add(value)
+      continue
+    }
+
+    seen.add(value)
+  }
+
+  return [...duplicates]
+}
+
+function isPlainObject(value: unknown): value is FeatureFlagsRecord {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function normalizeSourcePath(sourcePath: string): string {
+  return sourcePath.split(path.sep).join(path.posix.sep)
+}
+
+function syncRuntimeState(publicFlags: FeatureFlagsRecord): void {
+  const globalStore = globalThis as typeof globalThis & {
+    [RUNTIME_STORE_KEY]?: Record<string, RuntimeState>
+  }
+
+  const store =
+    globalStore[RUNTIME_STORE_KEY] ??= Object.create(null) as Record<
+      string,
+      RuntimeState
+    >
+
+  const state = store[PUBLIC_MODULE_ID] ??= { current: publicFlags }
+  state.current = publicFlags
+}
+
+function createDiagnostic(
+  message: string,
+  remediation: readonly string[],
+  cause?: unknown,
+): Error {
+  const details = remediation.map((step) => `- ${step}`).join('\n')
+  const error = cause instanceof Error ? cause.message : ''
+
+  return new Error(
+    [`[${PLUGIN_NAME}] ${message}`, details, error].filter(Boolean).join('\n'),
+  )
+}
