-export function featureFlags(flags: Record<string, unknown>): Plugin {
   return {
     name: 'feature-flags',
-    transform(code: string) {
-      return code.replaceAll('__FLAGS__', JSON.stringify(flags))
+
+    async configResolved(resolvedConfig) {
+      config = resolvedConfig
+      await syncDeclarationFile()
+    },
+
+    async buildStart() {
+      this.addWatchFile(sourcePath)
+      await syncDeclarationFile()
+    },
+
+    configureServer(configuredServer) {
+      server = configuredServer
+      configuredServer.watcher.add(sourcePath)
+      ensureFileWatcher()
+    },
+
+    resolveId(id) {
+      if (id === PUBLIC_MODULE_ID) {
+        return RESOLVED_PUBLIC_MODULE_ID
+      }
+      return null
+    },
+
+    async load(id) {
+      if (id !== RESOLVED_PUBLIC_MODULE_ID) {
+        return null
+      }
+
+      const snapshot = await getSnapshot()
+      return {
+        code: renderVirtualModule(snapshot.exposed),
+        map: {
+          version: 3,
+          file: PUBLIC_MODULE_ID,
+          sources: [relative(config?.root ?? process.cwd(), sourcePath)],
+          names: [],
+          mappings: '',
+        },
+      }
     },
+
+    watchChange(id) {
+      if (resolve(id) === sourcePath) {
+        invalidate()
+      }
+    },
+
+    async handleHotUpdate(context: HmrContext) {
+      if (resolve(context.file) !== sourcePath) {
+        return
+      }
+
+      invalidate()
+      await syncDeclarationFile()
+
+      const module = context.server.moduleGraph.getModuleById(RESOLVED_PUBLIC_MODULE_ID)
+      invalidateVirtualModule(module)
+      return module ? [module] : []
+    },
+
+    closeBundle() {
+      closeFileWatcher()
+    },
+  }
+}
+
+function toFilePath(source: string | URL): string {
+  return resolve(source instanceof URL ? fileURLToPath(source) : source)
+}
+
+function parseFlags(sourceText: string, sourcePath: string): Record<string, unknown> {
+  let parsed: unknown
+
+  try {
+    parsed = JSON.parse(sourceText)
+  } catch (error) {
+    throw diagnostic(
+      `Invalid JSON in ${sourcePath}.`,
+      'Fix the JSON syntax so the plugin can generate the virtual module.',
+      error,
+    )
   }
+
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    throw diagnostic(
+      `Expected ${sourcePath} to contain a JSON object.`,
+      'Use a flat object such as { "checkoutV2": true }.',
+    )
+  }
+
+  return parsed as Record<string, unknown>
 }
+
+function pickExposedFlags(
+  parsed: Record<string, unknown>,
+  expose: readonly string[],
+  sourcePath: string,
+): FeatureFlagsShape {
+  if (expose.length === 0) {
+    throw diagnostic(
+      'The "expose" option is empty.',
+      'List the client-safe keys to publish, for example expose: ["checkoutV2"].',
+    )
+  }
+
+  const missing = expose.filter((key) => !(key in parsed))
+  if (missing.length > 0) {
+    throw diagnostic(
+      `Missing exposed flags in ${sourcePath}: ${missing.join(', ')}.`,
+      'Add the missing keys to the JSON file or remove them from "expose".',
+    )
+  }
+
+  const suspicious = expose.filter((key) => SECRET_NAME_PATTERN.test(key))
+  if (suspicious.length > 0) {
+    throw diagnostic(
+      `Refusing to expose secret-like keys from ${sourcePath}: ${suspicious.join(', ')}.`,
+      'Move secrets to server-only configuration or rename the public flags to avoid leaking credentials.',
+    )
+  }
+
+  const exposed: Record<string, FeatureFlagPrimitive> = {}
+  for (const key of expose) {
+    const value = parsed[key]
+    if (!isFeatureFlagPrimitive(value)) {
+      throw diagnostic(
+        `Unsupported value for "${key}" in ${sourcePath}.`,
+        'Feature flags must be string, number, boolean, or null so dev, build, and HMR stay deterministic.',
+      )
+    }
+    exposed[key] = value
+  }
+
+  return exposed
+}
+
+function isFeatureFlagPrimitive(value: unknown): value is FeatureFlagPrimitive {
+  return (
+    value === null ||
+    typeof value === 'boolean' ||
+    typeof value === 'number' ||
+    typeof value === 'string'
+  )
+}
+
+function renderVirtualModule(exposed: FeatureFlagsShape): string {
+  return [
+    `export const flags = ${JSON.stringify(exposed, null, 2)};`,
+    'export default flags;',
+  ].join('\n')
+}
+
+function renderDeclaration(exposed: FeatureFlagsShape): string {
+  const lines = Object.entries(exposed).map(([key, value]) => {
+    return `    readonly ${JSON.stringify(key)}: ${typeForValue(value)}`
+  })
+
+  return [
+    "declare module 'virtual:feature-flags' {",
+    '  export interface FeatureFlagsShape {',
+    ...(lines.length > 0 ? lines : ['    readonly [key: string]: never']),
+    '  }',
+    '}',
+    '',
+  ].join('\n')
+}
+
+function typeForValue(value: FeatureFlagPrimitive): string {
+  if (value === null) {
+    return 'null'
+  }
+  if (typeof value === 'boolean') {
+    return 'boolean'
+  }
+  if (typeof value === 'number') {
+    return 'number'
+  }
+  return 'string'
+}
+
+function diagnostic(message: string, action: string, cause?: unknown): Error {
+  const details =
+    cause instanceof Error && cause.message
+      ? `\nCause: ${cause.message}`
+      : ''
+
+  return new Error(`${message}\nAction: ${action}${details}`)
+}
+
+export { PUBLIC_MODULE_ID }
