+
+export type FeatureFlagPrimitive = boolean | number | string | null
+
+export interface FeatureFlagsShape {
+  readonly [key: string]: FeatureFlagPrimitive
+}
+
+export interface FeatureFlagsOptions {
+  source: string | URL
+  expose: readonly string[]
+  declarationFile?: string
+}
+
+interface CachedSnapshot {
+  declaration: string
+  exposed: FeatureFlagsShape
+}
+
+const PUBLIC_MODULE_ID = 'virtual:feature-flags'
+const RESOLVED_PUBLIC_MODULE_ID = '\0virtual:feature-flags'
+const DEFAULT_DECLARATION_FILE = 'src/feature-flags.d.ts'
+const SECRET_NAME_PATTERN = /(secret|token|password|private[-_]?key|access[-_]?key)/i
+
+export function featureFlags(options: FeatureFlagsOptions): Plugin {
+  const expose = [...new Set(options.expose)]
+  const sourcePath = toFilePath(options.source)
+  const declarationFile = options.declarationFile ?? DEFAULT_DECLARATION_FILE
+
+  let config: ResolvedConfig | undefined
+  let server: ViteDevServer | undefined
+  let cachedSnapshot: CachedSnapshot | undefined
+  let lastDeclaration = ''
+  let fileWatcher: FSWatcher | undefined
+
+  const invalidate = () => {
+    cachedSnapshot = undefined
+  }
+
+  const getDeclarationPath = () => {
+    const root = config?.root ?? process.cwd()
+    return resolve(root, declarationFile)
+  }
+
+  const getSnapshot = async (): Promise<CachedSnapshot> => {
+    if (cachedSnapshot) {
+      return cachedSnapshot
+    }
+
+    const sourceText = await readFile(sourcePath, 'utf8')
+    const parsed = parseFlags(sourceText, sourcePath)
+    const exposed = pickExposedFlags(parsed, expose, sourcePath)
+
+    cachedSnapshot = {
+      declaration: renderDeclaration(exposed),
+      exposed,
+    }
+    return cachedSnapshot
+  }
+
+  const syncDeclarationFile = async () => {
+    const snapshot = await getSnapshot()
+    if (snapshot.declaration === lastDeclaration) {
+      return
+    }
+
+    await writeFile(getDeclarationPath(), snapshot.declaration, 'utf8')
+    lastDeclaration = snapshot.declaration
+  }
+
+  const invalidateVirtualModule = (module: ModuleNode | undefined) => {
+    if (!server || !module) {
+      return
+    }
+    server.moduleGraph.invalidateModule(module)
+  }
+
+  const onSourceChange = async () => {
+    invalidate()
+
+    try {
+      await syncDeclarationFile()
+    } catch (error) {
+      const normalizedError = error instanceof Error ? error : new Error(String(error))
+      server?.config.logger.error(normalizedError.message, { error: normalizedError })
+      return
+    }
+
+    if (!server) {
+      return
+    }
+
+    const module = server.moduleGraph.getModuleById(RESOLVED_PUBLIC_MODULE_ID)
+    invalidateVirtualModule(module)
+    server.watcher.emit('change', sourcePath)
+    server.ws.send({ type: 'full-reload', path: '*' })
+  }
+
+  const ensureFileWatcher = () => {
+    if (fileWatcher) {
+      return
+    }
+
+    fileWatcher = watch(sourcePath, () => {
+      void onSourceChange()
+    })
+  }
+
+  const closeFileWatcher = () => {
+    fileWatcher?.close()
+    fileWatcher = undefined
