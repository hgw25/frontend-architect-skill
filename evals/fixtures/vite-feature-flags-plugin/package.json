{
  "name": "frontend-architect-vite-plugin-eval",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:plugin": "npm run build --workspace @frontend-architect-eval/feature-flags",
    "typecheck": "tsc -p packages/plugin/tsconfig.json --noEmit && tsc -p examples/consumer/tsconfig.json --noEmit",
    "test:build": "vite build --config examples/consumer/vite.config.ts && node scripts/check-build.mjs",
    "test:dev": "node scripts/check-dev.mjs",
    "test:diagnostics": "node scripts/check-diagnostics.mjs",
    "test:package": "node scripts/check-package.mjs",
    "check": "npm run build:plugin && npm run typecheck && npm run test:build && npm run test:dev && npm run test:diagnostics && npm run test:package"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.2",
    "vite": "8.2.2"
  }
}
